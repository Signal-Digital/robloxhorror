	hud.DailyBtn = button({ Parent = menu, LayoutOrder = 10, Size = UDim2.fromOffset(150, 54), BackgroundColor3 = THEME.Gold, TextColor3 = C(40, 20, 0), Text = "🎁 DAILY!", Visible = false }, function()
