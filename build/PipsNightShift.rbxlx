	hud.Subtitle = label({ Parent = root, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.44), Size = UDim2.fromOffset(800, 40), Font = TITLE_FONT, TextStrokeTransparency = 0.2, TextTransparency = 1 })

