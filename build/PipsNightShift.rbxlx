      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config — every tunable value of the game lives here.

	MONETISATION / BADGES : remplace les 0 par tes vrais IDs créés sur
	https://create.roblox.com (Monetization > Passes / Developer Products, Badges).
	Un ID à 0 = l'offre apparaît "Bientôt" dans la boutique et n'est pas achetable.
]]

local Config = {}

Config.GameName = "Night Shift at Pip's"
Config.PizzeriaName = "PIP'S PARTY PALACE"

-- Rounds ---------------------------------------------------------------
Config.IntermissionTime = 25 -- seconds in the parking lot between nights
Config.ResultsTime = 8
Config.NightLength = 300 -- real seconds from 12 AM to 6 AM (5 minutes)
Config.MinPlayers = 1
Config.LateJoinWindow = 0.4 -- fraction of the night during which lobby players may still clock in

-- Movement -------------------------------------------------------------
Config.WalkSpeed = 14
Config.SprintSpeed = 22
Config.SodaBonus = 7
Config.GhostSpeed = 24
Config.StaminaMax = 100
Config.StaminaDrain = 22 -- per second while sprinting
Config.StaminaRegen = 14
Config.SprintNoiseSpeed = 18 -- server treats anyone moving faster than this as "running" (noise)

-- Flashlight -----------------------------------------------------------
Config.Flashlight = {
	Drain = 1.1, -- % per second
	ProDrain = 0.65, -- with the Pro Flashlight game pass
	Range = 55,
	Brightness = 3,
	Angle = 50,
	FreezeCone = 0.9, -- cos of the half-angle that "lights" Pip
}

-- Misc gameplay ---------------------------------------------------------
Config.HideMaxTime = 18
Config.GhostPingCooldown = 12
Config.GhostPingDuration = 5
Config.DecoyDuration = 8
Config.SodaDuration = 8
Config.CatchDistance = 4.5

-- Rewards (tickets = soft currency) --------------------------------------
Config.Rewards = {
	Token = 3,
	TicketPickupMin = 3,
	TicketPickupMax = 8,
	Objective = 15,
	SurviveBase = 30,
	SurvivePerNight = 10,
	Escape = 25,
	FriendBonus = 0.2, -- +20% when playing with a friend
	VIPMultiplier = 2,
}

Config.CapsuleCosts = { Basic = 100, Deluxe = 350 }
Config.DuplicateRefund = { Common = 20, Rare = 60, Epic = 150, Legendary = 400 }

Config.Daily = { Base = 50, PerStreak = 25, MaxStreak = 7, Cooldown = 20 * 3600, StreakBreak = 48 * 3600 }

-- Social ----------------------------------------------------------------
Config.GroupId = 0 -- ton groupe Roblox : bonus unique pour les membres
Config.GroupReward = 150

-- Monetisation ------------------------------------------------------------
Config.GamePasses = {
	VIP = 0, -- x2 tickets, golden name tag
	ProFlashlight = 0, -- battery lasts ~70% longer, brighter beam
	LuckyCharm = 0, -- better Prize Counter odds
}

Config.Products = {
	Revive = 0, -- instant revive while a ghost
	PowerSurge = 0, -- full battery + 1 soda for the WHOLE team (social purchase)
	Tickets500 = 0,
	Tickets2000 = 0,
}

Config.ProductRewards = {
	Tickets500 = 500,
	Tickets2000 = 2000,
}

-- Shop display (Robux prices are set on the website, these are just labels)
Config.ShopCatalog = {
	{ Kind = "Pass", Key = "VIP", Name = "VIP Guard", Price = 199, Desc = "x2 tickets forever + golden name tag" },
	{ Kind = "Pass", Key = "ProFlashlight", Name = "Pro Flashlight", Price = 149, Desc = "Battery lasts much longer, brighter beam" },
	{ Kind = "Pass", Key = "LuckyCharm", Name = "Lucky Charm", Price = 249, Desc = "Better odds at the Prize Counter" },
	{ Kind = "Product", Key = "Revive", Name = "Instant Revive", Price = 25, Desc = "Come back to life right now (as a ghost)" },
	{ Kind = "Product", Key = "PowerSurge", Name = "Power Surge", Price = 49, Desc = "Full battery + a soda for your WHOLE team" },
	{ Kind = "Product", Key = "Tickets500", Name = "500 Tickets", Price = 49, Desc = "A bag of prize tickets" },
	{ Kind = "Product", Key = "Tickets2000", Name = "2000 Tickets", Price = 149, Desc = "A bucket of prize tickets" },
}

-- Badges (0 = disabled)
Config.Badges = {
	Welcome = 0,
	Night1 = 0,
	Night3 = 0,
	Night5 = 0,
	Escape = 0,
	Legendary = 0,
}

-- Sounds: colle des IDs audio publics (Creator Store > Audio). Vide = muet.
Config.Sounds = {
	Jumpscare = "",
	Ambience = "",
	Chase = "",
	MusicBox = "",
	Pickup = "",
	Fuse = "",
	Capsule = "",
	Heartbeat = "",
	SixAM = "",
}

-- Data -------------------------------------------------------------------
Config.DataStoreName = "PipsNightShift_v1"
Config.LeaderboardStoreName = "PipsNightShift_Nights_v1"

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[-- Permanent cosmetics won at the Prize Counter (persisted in the DataStore).
local Cosmetics = {}

Cosmetics.Rarities = {
	Common = { Order = 1, Color = Color3.fromRGB(190, 190, 190) },
	Rare = { Order = 2, Color = Color3.fromRGB(70, 150, 255) },
	Epic = { Order = 3, Color = Color3.fromRGB(180, 80, 255) },
	Legendary = { Order = 4, Color = Color3.fromRGB(255, 190, 40) },
}
Cosmetics.RarityOrder = { "Common", "Rare", "Epic", "Legendary" }

local function seq(...)
	local colors = { ... }
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local kps = {}
	for i, c in colors do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
	end
	return ColorSequence.new(kps)
end

Cosmetics.Items = {
	-- Flashlight beams
	{ Id = "Light_Default", Name = "Standard Beam", Type = "Light", Rarity = "Common", Color = Color3.fromRGB(255, 240, 205) },
	{ Id = "Light_Ice", Name = "Icy Beam", Type = "Light", Rarity = "Common", Color = Color3.fromRGB(170, 220, 255) },
	{ Id = "Light_Mint", Name = "Mint Beam", Type = "Light", Rarity = "Common", Color = Color3.fromRGB(170, 255, 205) },
	{ Id = "Light_Rose", Name = "Bubblegum Beam", Type = "Light", Rarity = "Rare", Color = Color3.fromRGB(255, 150, 200) },
	{ Id = "Light_Toxic", Name = "Toxic Beam", Type = "Light", Rarity = "Rare", Color = Color3.fromRGB(150, 255, 60) },
	{ Id = "Light_Violet", Name = "Phantom Beam", Type = "Light", Rarity = "Epic", Color = Color3.fromRGB(170, 100, 255) },
	{ Id = "Light_Blood", Name = "Blood Moon Beam", Type = "Light", Rarity = "Epic", Color = Color3.fromRGB(255, 50, 50) },
	{ Id = "Light_Gold", Name = "Golden Pip Beam", Type = "Light", Rarity = "Legendary", Color = Color3.fromRGB(255, 205, 70) },

	-- Trails
	{ Id = "Trail_Confetti", Name = "Confetti Trail", Type = "Trail", Rarity = "Common",
		Colors = seq(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 220, 80), Color3.fromRGB(90, 200, 255)) },
	{ Id = "Trail_Pizza", Name = "Pizza Trail", Type = "Trail", Rarity = "Common",
		Colors = seq(Color3.fromRGB(255, 170, 40), Color3.fromRGB(230, 60, 30)) },
	{ Id = "Trail_Ghost", Name = "Ghostly Trail", Type = "Trail", Rarity = "Rare", Colors = seq(Color3.fromRGB(230, 240, 255)) },
	{ Id = "Trail_Neon", Name = "Arcade Neon Trail", Type = "Trail", Rarity = "Rare",
		Colors = seq(Color3.fromRGB(0, 255, 240), Color3.fromRGB(255, 0, 200)) },
	{ Id = "Trail_Shadow", Name = "Shadow Trail", Type = "Trail", Rarity = "Epic",
		Colors = seq(Color3.fromRGB(20, 0, 40), Color3.fromRGB(150, 0, 255)) },
	{ Id = "Trail_Rainbow", Name = "Party Rainbow", Type = "Trail", Rarity = "Legendary",
		Colors = seq(Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 200, 0), Color3.fromRGB(0, 255, 0),
			Color3.fromRGB(0, 160, 255), Color3.fromRGB(200, 0, 255)) },

	-- Titles (shown above your head)
	{ Id = "Title_Rookie", Name = "Rookie Guard", Type = "Title", Rarity = "Common", Color = Color3.fromRGB(220, 220, 220) },
	{ Id = "Title_Pizza", Name = "Pizza Lover", Type = "Title", Rarity = "Common", Color = Color3.fromRGB(255, 170, 60) },
	{ Id = "Title_Brave", Name = "Brave Soul", Type = "Title", Rarity = "Rare", Color = Color3.fromRGB(90, 170, 255) },
	{ Id = "Title_Survivor", Name = "Night Survivor", Type = "Title", Rarity = "Rare", Color = Color3.fromRGB(120, 255, 150) },
	{ Id = "Title_Nightmare", Name = "Nightmare Walker", Type = "Title", Rarity = "Epic", Color = Color3.fromRGB(200, 90, 255) },
	{ Id = "Title_Legend", Name = "Legend of Pip's", Type = "Title", Rarity = "Legendary", Color = Color3.fromRGB(255, 205, 60) },
}

Cosmetics.ById = {}
for _, item in Cosmetics.Items do
	Cosmetics.ById[item.Id] = item
end

-- Weights (%) per capsule tier
Cosmetics.CapsuleOdds = {
	Basic = { Common = 70, Rare = 24, Epic = 5.5, Legendary = 0.5 },
	Deluxe = { Common = 35, Rare = 42, Epic = 18, Legendary = 5 },
}
-- Lucky Charm game pass multiplies Epic/Legendary weights
Cosmetics.LuckyMultiplier = 2

function Cosmetics.RollRarity(tier: string, lucky: boolean, rng: Random): string
	local odds = Cosmetics.CapsuleOdds[tier] or Cosmetics.CapsuleOdds.Basic
	local weights = {}
	local total = 0
	for _, rarity in Cosmetics.RarityOrder do
		local w = odds[rarity]
		if lucky and (rarity == "Epic" or rarity == "Legendary") then
			w *= Cosmetics.LuckyMultiplier
		end
		weights[rarity] = w
		total += w
	end
	local roll = rng:NextNumber() * total
	for _, rarity in Cosmetics.RarityOrder do
		roll -= weights[rarity]
		if roll <= 0 then
			return rarity
		end
	end
	return "Common"
end

function Cosmetics.RandomOfRarity(rarity: string, rng: Random)
	local pool = {}
	for _, item in Cosmetics.Items do
		if item.Rarity == rarity and item.Id ~= "Light_Default" then
			table.insert(pool, item)
		end
	end
	return pool[rng:NextInteger(1, #pool)]
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[-- Consumable items found in the pizzeria during a night (lost when the night ends).
local Items = {}

Items.Defs = {
	Battery = { Name = "Battery", Icon = "🔋", Max = 3, Key = "One", Desc = "Recharge your flashlight" },
	Soda = { Name = "Fizzy Soda", Icon = "🥤", Max = 3, Key = "Two", Desc = "Run faster for a few seconds" },
	Decoy = { Name = "Decoy Plush", Icon = "🧸", Max = 2, Key = "Three", Desc = "Squeaky plush that distracts animatronics" },
}
Items.Order = { "Battery", "Soda", "Decoy" }

-- Loot table of the Prize Capsules hidden in the pizzeria
Items.CapsuleLoot = {
	{ Kind = "Item", Item = "Battery", Weight = 28, Rarity = "Common" },
	{ Kind = "Item", Item = "Soda", Weight = 24, Rarity = "Common" },
	{ Kind = "Item", Item = "Decoy", Weight = 16, Rarity = "Rare" },
	{ Kind = "Tickets", Amount = 25, Weight = 20, Rarity = "Common" },
	{ Kind = "Tickets", Amount = 75, Weight = 8, Rarity = "Rare" },
	{ Kind = "Tickets", Amount = 200, Weight = 3, Rarity = "Epic" },
	{ Kind = "Cosmetic", Weight = 1, Rarity = "Legendary" },
}

function Items.RollCapsule(rng: Random)
	local total = 0
	for _, entry in Items.CapsuleLoot do
		total += entry.Weight
	end
	local roll = rng:NextNumber() * total
	for _, entry in Items.CapsuleLoot do
		roll -= entry.Weight
		if roll <= 0 then
			return entry
		end
	end
	return Items.CapsuleLoot[1]
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Mascots</string>
          <string name="Source"><![CDATA[-- Animatronic stats + the one simple rule players must learn for each of them.
local Mascots = {
	Bruno = {
		DisplayName = "Bruno the Bear",
		Behavior = "Hunter",
		RoamSpeed = 9,
		ChaseSpeed = 17,
		Sight = 75,
		FOV = 0.25, -- cos of half view angle (~150° cone)
		ActivateDelay = 15,
		Spawn = "Stage",
		Rule = "Hunts by SIGHT. Break line of sight or hide in a locker.",
		Color = Color3.fromRGB(140, 85, 45),
	},
	Maple = {
		DisplayName = "Maple the Moose",
		Behavior = "Listener",
		RoamSpeed = 8,
		ChaseSpeed = 19,
		Hearing = 60,
		ActivateDelay = 30,
		Spawn = "Backstage",
		Rule = "BLIND. Hears running, repairs and capsules. Walk slowly near her.",
		Color = Color3.fromRGB(196, 150, 95),
	},
	Pip = {
		DisplayName = "Pip the Penguin",
		Behavior = "Watcher",
		RoamSpeed = 12,
		ChaseSpeed = 21,
		Sight = 120,
		ActivateDelay = 45,
		Spawn = "Stage",
		Rule = "Only moves in the DARK. Keep your flashlight on him to freeze him.",
		Color = Color3.fromRGB(35, 40, 60),
	},
	Jinx = {
		DisplayName = "Jinx the Jester",
		Behavior = "Stalker",
		RoamSpeed = 20,
		ChaseSpeed = 23,
		ActivateDelay = 2,
		Spawn = "GiftBox",
		Rule = "Wakes up when the MUSIC BOX stops. Wind it to send him back.",
		Color = Color3.fromRGB(120, 60, 170),
	},
}

Mascots.Order = { "Bruno", "Maple", "Pip", "Jinx" }

return Mascots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Nights</string>
          <string name="Source"><![CDATA[-- Night definitions: each night adds one new rule so players learn gradually.
local Nights = {}

Nights.List = {
	{
		Fuses = 3,
		Tokens = 6,
		Deliveries = {},
		MusicBox = false,
		Animatronics = { "Bruno" },
		SpeedMult = 1,
		Intro = "Fix the fuses, grab the party tokens, then escape!",
		Tip = "Bruno hunts by sight. Break line of sight or hide in a locker.",
	},
	{
		Fuses = 3,
		Tokens = 8,
		Deliveries = { { Kind = "Tape", Count = 1 } },
		MusicBox = false,
		Animatronics = { "Bruno", "Maple" },
		SpeedMult = 1.03,
		Intro = "Someone left a strange tape... bring it to the Security Office.",
		Tip = "Maple is blind but hears running. WALK when she's close.",
	},
	{
		Fuses = 4,
		Tokens = 8,
		Deliveries = { { Kind = "Gas", Count = 2 } },
		MusicBox = false,
		Animatronics = { "Bruno", "Maple", "Pip" },
		SpeedMult = 1.06,
		Intro = "The backup generator is empty. Refuel it with gas cans.",
		Tip = "Pip only moves in the dark. Keep your flashlight ON him.",
	},
	{
		Fuses = 4,
		Tokens = 10,
		Deliveries = { { Kind = "Tape", Count = 1 } },
		MusicBox = true,
		Animatronics = { "Bruno", "Maple", "Pip" },
		SpeedMult = 1.1,
		Intro = "Keep the music box wound... or Jinx comes out to play.",
		Tip = "Wind the music box in the Security Office before it stops!",
	},
	{
		Fuses = 5,
		Tokens = 12,
		Deliveries = { { Kind = "Tape", Count = 1 }, { Kind = "Gas", Count = 2 } },
		MusicBox = true,
		Animatronics = { "Bruno", "Maple", "Pip" },
		SpeedMult = 1.15,
		Intro = "The final night. Everything is awake.",
		Tip = "Work as a team: split up the tasks!",
	},
}

-- Night 6+ = "Nightmare" nights: night 5 rules, faster each time.
function Nights.Get(n: number)
	local def = Nights.List[math.min(n, #Nights.List)]
	local copy = table.clone(def)
	if n > #Nights.List then
		copy.SpeedMult = def.SpeedMult + 0.05 * (n - #Nights.List)
		copy.Intro = "NIGHTMARE MODE. They're faster than ever."
	end
	return copy
end

function Nights.Name(n: number): string
	if n > #Nights.List then
		return "NIGHTMARE " .. (n - #Nights.List)
	end
	return "NIGHT " .. n
end

return Nights
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Creates (server) or waits for (client) every remote used by the game.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	-- server -> client
	"GameState",
	"Notify",
	"Jumpscare",
	"Reward",
	"Results",
	"ProfileUpdate",
	"OpenUI",
	-- client -> server
	"ToggleFlashlight",
	"UseItem",
	"GhostPing",
	"Equip",
	"ClaimDaily",
	"JoinShift",
	"TutorialDone",
}
local UNRELIABLE = { "Aim" }
local FUNCTIONS = { "RollCapsule", "GetProfile" }

local Remotes = {}
local folder

if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
		for _, name in UNRELIABLE do
			local r = Instance.new("UnreliableRemoteEvent")
			r.Name = name
			r.Parent = folder
		end
		for _, name in FUNCTIONS do
			local r = Instance.new("RemoteFunction")
			r.Name = name
			r.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, list in { EVENTS, UNRELIABLE, FUNCTIONS } do
	for _, name in list do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">AnimatronicBuilder</string>
          <string name="Source"><![CDATA[--[[
	AnimatronicBuilder — builds the 4 original mascots out of parts.
	Each model = invisible HumanoidRootPart + Humanoid (HipHeight rig, no joints)
	+ welded body parts. Legs/arms use Welds so the server can swing them.
	Front of the model is -Z (LookVector).
]]

local AnimatronicBuilder = {}

local M = Enum.Material
local C = Color3.fromRGB

local HIP = 3 -- distance between ground and the bottom of the root part
local ROOT_SIZE = Vector3.new(3, 4, 2)

local function newPart(model, name, size, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or M.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- weld `p` to `base` at local offset
local function attach(base: BasePart, p: BasePart, offset: CFrame)
	p.CFrame = base.CFrame * offset
	local w = Instance.new("Weld")
	w.Name = "Weld"
	w.Part0 = base
	w.Part1 = p
	w.C0 = offset
	w.Parent = p
	return w
end

local function add(model, base, name, size, offset, color, material, shape)
	local p = newPart(model, name, size, color, material, shape)
	local w = attach(base, p, offset)
	return p, w
end

local VERT = CFrame.Angles(0, 0, math.rad(90)) -- cylinders standing up

-- A limb hangs from a pivot: C0 = pivot * swing * down(len/2)
local function limb(model, root, name, size, pivot: CFrame, color, material)
	local p, w = add(model, root, name, size, pivot * CFrame.new(0, -size.Y / 2, 0), color, material)
	w:SetAttribute("Pivot", pivot :: any)
	w:SetAttribute("Length", size.Y)
	return p, w
end

local function eye(model, head, x, y, z, iris: Color3, size: number?)
	local s = size or 0.8
	add(model, head, "EyeWhite", Vector3.new(s, s, s), CFrame.new(x, y, z), C(245, 245, 235), M.SmoothPlastic, Enum.PartType.Ball)
	local pupil = add(model, head, "Pupil", Vector3.new(s * 0.45, s * 0.45, s * 0.45), CFrame.new(x, y, z - s * 0.38), iris, M.Neon, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = iris
	light.Range = 6
	light.Brightness = 1.5
	light.Parent = pupil
	return pupil
end

local function base(name: string)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = ROOT_SIZE
	root.Transparency = 1
	root.CanCollide = true
	root.Anchored = false
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = model
	model.PrimaryPart = root

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = HIP
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.Parent = model
	return model, root, hum
end

-- root center sits 5 studs above the ground: ground = -5 in root space
local function legsAndFeet(model, root, legColor, footColor, legSize)
	local ls = legSize or Vector3.new(1.5, 3.2, 1.5)
	local legs = {}
	for _, sx in { -0.9, 0.9 } do
		local leg, w = limb(model, root, "Leg", ls, CFrame.new(sx, -1.8, 0), legColor, M.Fabric)
		table.insert(legs, w)
		-- the foot is welded to the leg so it swings with it
		add(model, leg, "Foot", Vector3.new(ls.X + 0.3, 0.6, ls.Z + 0.9), CFrame.new(0, -ls.Y / 2 + 0.2, -0.4), footColor, M.Fabric)
	end
	return legs
end

local function arms(model, root, color, size, shoulderY, shoulderX)
	local out = {}
	for _, sx in { -shoulderX, shoulderX } do
		local _, w = limb(model, root, "Arm", size, CFrame.new(sx, shoulderY, 0), color, M.Fabric)
		table.insert(out, w)
		add(model, w.Part1 :: BasePart, "Hand", Vector3.new(size.X + 0.2, 0.9, size.Z + 0.2), CFrame.new(0, -size.Y / 2, 0), color, M.Fabric)
	end
	return out
end

local function bowTie(model, torso, y, z, color)
	add(model, torso, "Bow", Vector3.new(0.8, 0.8, 0.3), CFrame.new(-0.5, y, z) * CFrame.Angles(0, 0, math.rad(45)), color)
	add(model, torso, "Bow", Vector3.new(0.8, 0.8, 0.3), CFrame.new(0.5, y, z) * CFrame.Angles(0, 0, math.rad(45)), color)
	add(model, torso, "Bow", Vector3.new(0.4, 0.4, 0.35), CFrame.new(0, y, z), color)
end

------------------------------------------------------------------------------
local Builders = {}

function Builders.Bruno()
	local model, root, hum = base("Bruno")
	local fur, belly = C(140, 85, 45), C(205, 160, 110)
	local torso = add(model, root, "Torso", Vector3.new(3.8, 4.6, 2.6), CFrame.new(0, 0.3, 0), fur, M.Fabric)
	add(model, torso, "Belly", Vector3.new(2.6, 3, 0.2), CFrame.new(0, -0.3, -1.3), belly, M.Fabric)
	bowTie(model, torso, 2, -1.35, C(30, 30, 30))
	local legs = legsAndFeet(model, root, fur, C(110, 65, 35))
	local armWelds = arms(model, root, fur, Vector3.new(1.3, 3.8, 1.3), 2.1, 2.6)
	local head, headWeld = add(model, root, "Head", Vector3.new(3.2, 2.8, 2.8), CFrame.new(0, 4, 0), fur, M.Fabric)
	add(model, head, "Snout", Vector3.new(1.8, 1.1, 1), CFrame.new(0, -0.4, -1.6), belly, M.Fabric)
	add(model, head, "Nose", Vector3.new(0.7, 0.45, 0.3), CFrame.new(0, -0.1, -2.15), C(20, 20, 20))
	add(model, head, "Jaw", Vector3.new(1.7, 0.5, 1.1), CFrame.new(0, -1.25, -1.4), C(90, 50, 30), M.Fabric)
	for _, sx in { -1.25, 1.25 } do
		add(model, head, "Ear", Vector3.new(1.1, 1.1, 0.6), CFrame.new(sx, 1.5, 0), fur, M.Fabric, Enum.PartType.Ball)
		add(model, head, "EarIn", Vector3.new(0.6, 0.6, 0.3), CFrame.new(sx, 1.5, -0.25), belly, M.Fabric, Enum.PartType.Ball)
	end
	eye(model, head, -0.7, 0.45, -1.35, C(255, 60, 40))
	eye(model, head, 0.7, 0.45, -1.35, C(255, 60, 40))
	-- top hat
	add(model, head, "HatBrim", Vector3.new(0.2, 2.4, 2.4), CFrame.new(0, 1.5, 0) * VERT, C(20, 20, 20), M.SmoothPlastic, Enum.PartType.Cylinder)
	add(model, head, "Hat", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 2.4, 0) * VERT, C(20, 20, 20), M.SmoothPlastic, Enum.PartType.Cylinder)
	add(model, head, "HatBand", Vector3.new(0.3, 1.65, 1.65), CFrame.new(0, 1.8, 0) * VERT, C(150, 20, 35), M.SmoothPlastic, Enum.PartType.Cylinder)
	-- microphone in hand
	add(model, armWelds[2].Part1 :: BasePart, "Mic", Vector3.new(0.35, 1.4, 0.35), CFrame.new(0, -1.9, -0.5) * CFrame.Angles(math.rad(70), 0, 0), C(40, 40, 40), M.Metal)
	return model, { Legs = legs, Arms = armWelds, Head = headWeld }, hum
end

function Builders.Maple()
	local model, root, hum = base("Maple")
	local fur, light = C(170, 120, 70), C(225, 195, 150)
	local torso = add(model, root, "Torso", Vector3.new(4, 4.8, 2.8), CFrame.new(0, 0.4, 0), fur, M.Fabric)
	add(model, torso, "Belly", Vector3.new(2.6, 3.2, 0.2), CFrame.new(0, -0.3, -1.4), light, M.Fabric)
	-- plaid scarf
	add(model, torso, "Scarf", Vector3.new(4.2, 0.8, 3), CFrame.new(0, 2.2, 0), C(180, 30, 40), M.Fabric)
	add(model, torso, "ScarfTail", Vector3.new(0.8, 2, 0.3), CFrame.new(1, 1.2, -1.55), C(180, 30, 40), M.Fabric)
	-- bell (she jingles!)
	add(model, torso, "Bell", Vector3.new(0.9, 0.9, 0.9), CFrame.new(0, 1.4, -1.6), C(255, 200, 50), M.Metal, Enum.PartType.Ball)
	local legs = legsAndFeet(model, root, fur, C(60, 40, 25), Vector3.new(1.4, 3.2, 1.4))
	local armWelds = arms(model, root, fur, Vector3.new(1.2, 4, 1.2), 2.2, 2.7)
	local head, headWeld = add(model, root, "Head", Vector3.new(2.8, 2.6, 2.6), CFrame.new(0, 4.2, 0), fur, M.Fabric)
	add(model, head, "Muzzle", Vector3.new(2.2, 1.6, 2), CFrame.new(0, -0.5, -1.8), light, M.Fabric)
	add(model, head, "Nose", Vector3.new(0.9, 0.5, 0.3), CFrame.new(0, -0.1, -2.85), C(60, 30, 25))
	add(model, head, "Jaw", Vector3.new(2, 0.5, 1.6), CFrame.new(0, -1.4, -1.8), C(120, 80, 50), M.Fabric)
	-- blindfold instead of eyes
	add(model, head, "Blindfold", Vector3.new(3, 0.7, 2.8), CFrame.new(0, 0.5, 0), C(235, 235, 225), M.Fabric)
	for _, sx in { -0.65, 0.65 } do
		add(model, head, "Stitch", Vector3.new(0.6, 0.12, 0.1), CFrame.new(sx, 0.5, -1.42) * CFrame.Angles(0, 0, math.rad(45)), C(150, 20, 30))
		add(model, head, "Stitch", Vector3.new(0.6, 0.12, 0.1), CFrame.new(sx, 0.5, -1.42) * CFrame.Angles(0, 0, math.rad(-45)), C(150, 20, 30))
	end
	-- antlers
	for _, side in { -1, 1 } do
		local antler = C(235, 215, 170)
		add(model, head, "Antler", Vector3.new(0.4, 2.2, 0.4), CFrame.new(side * 1.1, 2, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)), antler)
		add(model, head, "Antler", Vector3.new(2.6, 0.5, 1.4), CFrame.new(side * 2.1, 3, 0), antler)
		for k = 0, 2 do
			add(model, head, "Antler", Vector3.new(0.35, 1.2, 0.35), CFrame.new(side * (1.3 + k * 0.6), 3.7, 0), antler)
		end
		add(model, head, "Ear", Vector3.new(0.5, 1.2, 0.5), CFrame.new(side * 1.5, 0.9, 0.3) * CFrame.Angles(0, 0, math.rad(side * 60)), fur, M.Fabric)
	end
	return model, { Legs = legs, Arms = armWelds, Head = headWeld }, hum
end

function Builders.Pip()
	local model, root, hum = base("Pip")
	local black, white, orange = C(30, 35, 55), C(240, 240, 245), C(255, 150, 30)
	local torso = add(model, root, "Torso", Vector3.new(4.2, 5, 3.2), CFrame.new(0, 0.2, 0), black, M.Fabric)
	add(model, torso, "Belly", Vector3.new(3.2, 4.2, 0.2), CFrame.new(0, -0.2, -1.6), white, M.Fabric)
	bowTie(model, torso, 2.1, -1.7, C(0, 150, 255))
	local legs = legsAndFeet(model, root, black, orange, Vector3.new(1.3, 3.2, 1.3))
	local armWelds = arms(model, root, black, Vector3.new(0.8, 3.6, 1.8), 2.2, 2.5)
	local head, headWeld = add(model, root, "Head", Vector3.new(3.4, 3, 3), CFrame.new(0, 4.2, 0), black, M.Fabric)
	add(model, head, "Face", Vector3.new(2.8, 2.2, 0.2), CFrame.new(0, -0.1, -1.5), white, M.Fabric)
	add(model, head, "Beak", Vector3.new(1.4, 0.6, 1.6), CFrame.new(0, -0.4, -2.2), orange)
	add(model, head, "Jaw", Vector3.new(1.2, 0.35, 1.3), CFrame.new(0, -0.85, -2.05), C(220, 110, 20))
	-- huge staring eyes
	eye(model, head, -0.75, 0.4, -1.6, C(0, 200, 255), 1.1)
	eye(model, head, 0.75, 0.4, -1.6, C(0, 200, 255), 1.1)
	-- party hat (stacked cylinders)
	local hatColors = { C(255, 80, 160), C(255, 220, 60), C(255, 80, 160) }
	for i = 0, 2 do
		add(model, head, "PartyHat", Vector3.new(0.7, 1.5 - i * 0.45, 1.5 - i * 0.45), CFrame.new(0.3, 1.85 + i * 0.65, 0) * VERT * CFrame.Angles(0, 0, 0),
			hatColors[i + 1], M.SmoothPlastic, Enum.PartType.Cylinder)
	end
	add(model, head, "Pompom", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0.3, 3.65, 0), C(255, 255, 255), M.Fabric, Enum.PartType.Ball)
	return model, { Legs = legs, Arms = armWelds, Head = headWeld }, hum
end

function Builders.Jinx()
	local model, root, hum = base("Jinx")
	local purple, yellow, mask = C(110, 50, 160), C(250, 200, 40), C(245, 240, 235)
	local torso = add(model, root, "Torso", Vector3.new(2.8, 5.2, 2), CFrame.new(0, 0.6, 0), purple, M.Fabric)
	add(model, torso, "Half", Vector3.new(1.4, 5.21, 2.01), CFrame.new(0.7, 0, 0), yellow, M.Fabric)
	for i = 0, 2 do
		add(model, torso, "Button", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 1.2 - i * 1.2, -1), C(20, 20, 20), M.SmoothPlastic, Enum.PartType.Ball)
	end
	-- ruffled collar
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		add(model, torso, "Ruffle", Vector3.new(1.2, 0.5, 1.2), CFrame.new(math.cos(a) * 1.4, 2.7, math.sin(a) * 1.1) * CFrame.Angles(0, -a, math.rad(20)),
			(i % 2 == 0) and purple or yellow, M.Fabric)
	end
	local legs = legsAndFeet(model, root, purple, yellow, Vector3.new(1, 3.2, 1))
	-- extra-long arms
	local armWelds = arms(model, root, yellow, Vector3.new(0.8, 5.5, 0.8), 2.6, 1.9)
	local head, headWeld = add(model, root, "Head", Vector3.new(2.6, 3, 2.4), CFrame.new(0, 5.2, 0), mask, M.SmoothPlastic)
	add(model, head, "Socket", Vector3.new(0.8, 1, 0.2), CFrame.new(-0.6, 0.4, -1.15), C(5, 5, 5))
	add(model, head, "Socket", Vector3.new(0.8, 1, 0.2), CFrame.new(0.6, 0.4, -1.15), C(5, 5, 5))
	for _, sx in { -0.6, 0.6 } do
		local pupil = add(model, head, "Pupil", Vector3.new(0.25, 0.25, 0.25), CFrame.new(sx, 0.4, -1.28), C(255, 255, 255), M.Neon, Enum.PartType.Ball)
		pupil.Name = "Pupil"
		local l = Instance.new("PointLight")
		l.Color = C(255, 255, 255)
		l.Range = 5
		l.Parent = pupil
	end
	add(model, head, "Smile", Vector3.new(1.9, 0.25, 0.2), CFrame.new(0, -0.7, -1.15), C(200, 20, 30))
	for _, sx in { -1, 1 } do
		add(model, head, "SmileEnd", Vector3.new(0.6, 0.25, 0.2), CFrame.new(sx * 1.05, -0.45, -1.15) * CFrame.Angles(0, 0, math.rad(sx * 40)), C(200, 20, 30))
		add(model, head, "Cheek", Vector3.new(0.5, 0.5, 0.15), CFrame.new(sx * 0.9, -0.1, -1.16), C(255, 120, 150), M.SmoothPlastic, Enum.PartType.Ball)
	end
	add(model, head, "Jaw", Vector3.new(1.6, 0.4, 0.4), CFrame.new(0, -1.1, -1), mask)
	-- jester hat
	add(model, head, "HatBase", Vector3.new(2.8, 0.8, 2.6), CFrame.new(0, 1.7, 0), purple, M.Fabric)
	for _, side in { -1, 1 } do
		add(model, head, "HatProng", Vector3.new(0.9, 2.6, 0.9), CFrame.new(side * 1.3, 2.8, 0) * CFrame.Angles(0, 0, math.rad(-side * 40)),
			side < 0 and purple or yellow, M.Fabric)
		add(model, head, "HatBell", Vector3.new(0.6, 0.6, 0.6), CFrame.new(side * 2.3, 3.5, 0), yellow, M.Metal, Enum.PartType.Ball)
	end
	return model, { Legs = legs, Arms = armWelds, Head = headWeld }, hum
end

function AnimatronicBuilder.Build(name: string)
	local builder = Builders[name]
	assert(builder, "Unknown animatronic " .. tostring(name))
	local model, rig, hum = builder()
	hum.WalkSpeed = 10
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Animatronics"
		end
	end
	return model, rig
end

-- Static (anchored) copy for jumpscares / UI viewports
function AnimatronicBuilder.Template(name: string)
	local model = AnimatronicBuilder.Build(name)
	model:PivotTo(CFrame.new(0, 5, 0))
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Humanoid") then
			d:Destroy()
		end
	end
	return model
end

return AnimatronicBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">AnimatronicService</string>
          <string name="Source"><![CDATA[--[[
	AnimatronicService — spawns the mascots and runs their AI.

	Behaviours (one simple rule each, so players learn fast):
	  Hunter   (Bruno) : sees you in a cone -> chases. Lose him by breaking line of sight / lockers.
	  Listener (Maple) : blind, goes to noises (running, repairs, capsules, decoys).
	  Watcher  (Pip)   : frozen while a flashlight is on him, very fast in the dark.
	  Stalker  (Jinx)  : always knows where the closest guard is. Only out when the music box stops.
]]

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Mascots = require(Shared.Mascots)
local Builder = require(script.Parent.AnimatronicBuilder)

local AnimatronicService = {}

local brains = {}
local noises = {}
local decoys = {}
local ctx
local folder: Folder
local map
local rng = Random.new()

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function lineOfSight(from: Vector3, char: Model, to: Vector3): boolean
	local result = workspace:Raycast(from, to - from, rayParams)
	if not result then
		return true
	end
	return result.Instance:IsDescendantOf(char)
end

------------------------------------------------------------------------------
-- Movement helpers
------------------------------------------------------------------------------
local function setSpeed(brain, speed: number)
	brain.Humanoid.WalkSpeed = speed * brain.SpeedMult
end

local function directMove(brain, pos: Vector3)
	brain.Waypoints = nil
	brain.Humanoid:MoveTo(pos)
	brain.Moving = true
end

-- Follows a computed path towards `goal`. Returns true once arrived.
local function pathTo(brain, goal: Vector3): boolean
	local now = os.clock()
	local rootPos = brain.Root.Position
	if (flat(goal - rootPos)).Magnitude < 4 then
		brain.Waypoints = nil
		return true
	end
	local needNew = not brain.Waypoints
		or not brain.PathGoal
		or (brain.PathGoal - goal).Magnitude > 6
		or now - brain.PathTime > 3
	if needNew then
		local ok = pcall(function()
			brain.Path:ComputeAsync(rootPos, goal)
		end)
		if not brain.Alive then
			return false
		end
		if ok and brain.Path.Status == Enum.PathStatus.Success then
			brain.Waypoints = brain.Path:GetWaypoints()
			brain.WpIndex = math.min(2, #brain.Waypoints)
			brain.PathGoal = goal
			brain.PathTime = now
		else
			brain.Waypoints = nil
			brain.Humanoid:MoveTo(goal)
			brain.Moving = true
			return false
		end
	end
	local wps = brain.Waypoints
	local wp = wps[brain.WpIndex]
	while wp and (flat(wp.Position - rootPos)).Magnitude < 3.5 do
		brain.WpIndex += 1
		wp = wps[brain.WpIndex]
	end
	if not wp then
		brain.Waypoints = nil
		return true
	end
	brain.Humanoid:MoveTo(wp.Position)
	brain.Moving = true
	return false
end

local function stop(brain)
	brain.Waypoints = nil
	brain.Moving = false
	brain.Humanoid:MoveTo(brain.Root.Position)
end

local function nearestNav(pos: Vector3, pickAmong: number?): Vector3
	local sorted = table.clone(map.NavPoints)
	table.sort(sorted, function(a, b)
		return (a - pos).Magnitude < (b - pos).Magnitude
	end)
	local n = math.min(pickAmong or 1, #sorted)
	return sorted[rng:NextInteger(1, n)]
end

local function pickRoamGoal(): Vector3
	local targets = ctx.GetTargets()
	if #targets > 0 and rng:NextNumber() < 0.45 then
		-- drift towards a random guard (not exactly on them: gives them a chance)
		local t = targets[rng:NextInteger(1, #targets)]
		return nearestNav(t.Root.Position, 3)
	end
	return map.NavPoints[rng:NextInteger(1, #map.NavPoints)]
end

local function roam(brain, now: number)
	brain.State = "Roam"
	setSpeed(brain, brain.Def.RoamSpeed)
	if not brain.RoamGoal or now > brain.RoamUntil then
		brain.RoamGoal = pickRoamGoal()
		brain.RoamUntil = now + 15
	end
	if pathTo(brain, brain.RoamGoal) then
		brain.RoamGoal = nil
	end
end

local function activeDecoy(pos: Vector3, range: number)
	local now = os.clock()
	local best, bestD
	for _, d in decoys do
		if d.Expires > now then
			local dist = (d.Pos - pos).Magnitude
			if dist < range and (not best or dist < bestD) then
				best, bestD = d, dist
			end
		end
	end
	return best
end

local function nearestVisible(brain, range: number, fovCos: number?)
	local head = brain.Head.Position
	local look = brain.Root.CFrame.LookVector
	local best, bestDist
	for _, t in ctx.GetTargets() do
		local delta = t.Root.Position - brain.Root.Position
		local d = delta.Magnitude
		if d < range then
			local f = flat(delta)
			local inFov = not fovCos or d < 12 or (f.Magnitude > 0.01 and look:Dot(f.Unit) >= fovCos)
			if inFov and lineOfSight(head, t.Char, t.Root.Position) then
				if not best or d < bestDist then
					best, bestDist = t, d
				end
			end
		end
	end
	return best, bestDist
end

local function nearestAny(brain, range: number)
	local best, bestDist
	for _, t in ctx.GetTargets() do
		local d = (t.Root.Position - brain.Root.Position).Magnitude
		if d < range and (not best or d < bestDist) then
			best, bestDist = t, d
		end
	end
	return best, bestDist
end

local function setChasing(brain, target)
	local id = target and target.Player.UserId or 0
	if brain.Model:GetAttribute("Target") ~= id then
		brain.Model:SetAttribute("Target", id)
		for _, pupil in brain.Pupils do
			local light = pupil:FindFirstChildOfClass("PointLight")
			if light then
				light.Brightness = target and 4 or 1.5
				light.Range = target and 10 or 6
			end
		end
	end
end

local function chase(brain, target, dist: number, speed: number)
	brain.State = "Chase"
	brain.LastSeen = target.Root.Position
	brain.LastSeenTime = os.clock()
	setSpeed(brain, speed)
	setChasing(brain, target)
	if dist < 35 and lineOfSight(brain.Head.Position, target.Char, target.Root.Position) then
		directMove(brain, target.Root.Position)
	else
		pathTo(brain, target.Root.Position)
	end
end

------------------------------------------------------------------------------
-- Behaviours
------------------------------------------------------------------------------
local Behaviors = {}

function Behaviors.Hunter(brain, now)
	local def = brain.Def
	local target, dist = nearestVisible(brain, def.Sight, def.FOV)
	local decoy = activeDecoy(brain.Root.Position, 70)
	if decoy and not (target and dist < 10) then
		brain.State = "Distracted"
		setChasing(brain, nil)
		setSpeed(brain, def.ChaseSpeed)
		pathTo(brain, decoy.Pos)
		return
	end
	if target then
		chase(brain, target, dist, def.ChaseSpeed)
		return
	end
	setChasing(brain, nil)
	if brain.State == "Chase" and now - brain.LastSeenTime < 6 then
		setSpeed(brain, def.ChaseSpeed * 0.9)
		if pathTo(brain, brain.LastSeen) then
			brain.State = "Search"
			brain.SearchUntil = now + 3
			stop(brain)
		end
		return
	end
	if brain.State == "Search" and now < brain.SearchUntil then
		return
	end
	roam(brain, now)
end

function Behaviors.Listener(brain, now)
	local def = brain.Def
	local pos = brain.Root.Position
	-- touch range: she can feel you
	local close, closeDist = nearestAny(brain, 9)
	if close then
		chase(brain, close, closeDist, def.ChaseSpeed)
		return
	end
	setChasing(brain, nil)
	local decoy = activeDecoy(pos, 90)
	if decoy then
		brain.State = "Investigate"
		brain.Goal = decoy.Pos
		brain.GoalTime = now
	else
		-- running guards & quiet footsteps nearby
		local heard, heardDist
		for _, t in ctx.GetTargets() do
			local d = (t.Root.Position - pos).Magnitude
			local radius = t.Sprinting and def.Hearing or 14
			if d < radius and (not heard or d < heardDist) then
				heard, heardDist = t, d
			end
		end
		if heard then
			brain.State = "Investigate"
			brain.Goal = heard.Root.Position
			brain.GoalTime = now
		else
			for i = #noises, 1, -1 do
				local n = noises[i]
				if now - n.Time > 3 then
					table.remove(noises, i)
				elseif (n.Pos - pos).Magnitude < n.Radius then
					brain.State = "Investigate"
					brain.Goal = n.Pos
					brain.GoalTime = now
					break
				end
			end
		end
	end
	if brain.State == "Investigate" then
		setSpeed(brain, def.ChaseSpeed)
		if pathTo(brain, brain.Goal) or now - brain.GoalTime > 10 then
			brain.State = "Search"
			brain.SearchUntil = now + 2.5
			stop(brain)
		end
		return
	end
	if brain.State == "Search" and now < brain.SearchUntil then
		return
	end
	roam(brain, now)
end

function Behaviors.Watcher(brain, now)
	local def = brain.Def
	if ctx.IsLit(brain.Head.Position, brain.Torso.Position) then
		if not brain.Model:GetAttribute("Frozen") then
			brain.Model:SetAttribute("Frozen", true)
		end
		brain.Humanoid.WalkSpeed = 0
		stop(brain)
		brain.UnfreezeAt = now + 0.7 -- small grace period once the light leaves him
		return
	end
	if brain.UnfreezeAt and now < brain.UnfreezeAt then
		return
	end
	brain.Model:SetAttribute("Frozen", false)
	local target, dist = nearestAny(brain, def.Sight)
	if target then
		chase(brain, target, dist, def.ChaseSpeed)
		return
	end
	setChasing(brain, nil)
	roam(brain, now)
end

function Behaviors.Stalker(brain, now)
	local def = brain.Def
	local decoy = activeDecoy(brain.Root.Position, 50)
	if decoy then
		setChasing(brain, nil)
		setSpeed(brain, def.ChaseSpeed)
		pathTo(brain, decoy.Pos)
		return
	end
	local target, dist = nearestAny(brain, 1000)
	if target then
		chase(brain, target, dist, def.ChaseSpeed)
	else
		roam(brain, now)
	end
end

------------------------------------------------------------------------------
-- Brain loop
------------------------------------------------------------------------------
local function tryCatch(brain, now: number): boolean
	local pos = brain.Root.Position
	for _, t in ctx.GetTargets() do
		local delta = t.Root.Position - pos
		if flat(delta).Magnitude < Config.CatchDistance + 1 and math.abs(delta.Y) < 7 then
			if lineOfSight(brain.Head.Position, t.Char, t.Root.Position) or flat(delta).Magnitude < 3 then
				if ctx.OnCatch(t.Player, brain.Name) then
					brain.PauseUntil = now + 3
					brain.State = "Roam"
					brain.RoamGoal = nil
					setChasing(brain, nil)
					stop(brain)
					return true
				end
			end
		end
	end
	return false
end

local function step(brain)
	local now = os.clock()
	if now < brain.WakeAt then
		return
	end
	if not brain.Model:GetAttribute("Awake") then
		brain.Model:SetAttribute("Awake", true)
	end
	if now < brain.PauseUntil then
		return
	end
	if brain.Def.Behavior ~= "Watcher" or not brain.Model:GetAttribute("Frozen") then
		if tryCatch(brain, now) then
			return
		end
	end
	Behaviors[brain.Def.Behavior](brain, now)

	-- stuck detection
	local pos = brain.Root.Position
	if brain.Moving and brain.Humanoid.WalkSpeed > 0 then
		if (pos - brain.LastPos).Magnitude < 0.4 then
			if now - brain.StuckSince > 2.5 then
				brain.StuckSince = now
				brain.StuckCount += 1
				brain.Waypoints = nil
				brain.RoamGoal = nil
				if brain.StuckCount >= 3 then
					brain.StuckCount = 0
					brain.Model:PivotTo(CFrame.new(nearestNav(pos) + Vector3.new(0, 2.5, 0)))
				end
			end
		else
			brain.StuckSince = now
			brain.StuckCount = 0
		end
	else
		brain.StuckSince = now
	end
	brain.LastPos = pos
end

-- Procedural walk animation (legs/arms swing with speed), 20 Hz to save bandwidth
local animAccum = 0
local function animate(dt: number)
	animAccum += dt
	if animAccum < 0.05 then
		return
	end
	local step_dt = animAccum
	animAccum = 0
	for _, brain in brains do
		if brain.Alive then
			local v = flat(brain.Root.AssemblyLinearVelocity).Magnitude
			brain.Phase += step_dt * v * 0.55
			local amp = math.clamp(v / 12, 0, 1) * 0.65
			local s = math.sin(brain.Phase) * amp
			for i, w in brain.Rig.Legs do
				local pivot, len = w:GetAttribute("Pivot"), w:GetAttribute("Length")
				w.C0 = pivot * CFrame.Angles(i == 1 and s or -s, 0, 0) * CFrame.new(0, -len / 2, 0)
			end
			local chasing = (brain.Model:GetAttribute("Target") or 0) ~= 0
			for i, w in brain.Rig.Arms do
				local pivot, len = w:GetAttribute("Pivot"), w:GetAttribute("Length")
				local angle = chasing and (-1.35 + (i == 1 and s or -s) * 0.25) or (i == 1 and -s or s)
				w.C0 = pivot * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -len / 2, 0)
			end
			-- creepy head twitch
			if rng:NextNumber() < 0.04 then
				brain.HeadTilt = rng:NextNumber(-0.35, 0.35)
			end
			local hw = brain.Rig.Head
			hw.C0 = brain.HeadBase * CFrame.Angles(0, 0, brain.HeadTilt)
		end
	end
end

------------------------------------------------------------------------------
-- Public API
------------------------------------------------------------------------------
function AnimatronicService.Init(context, mapData)
	ctx = context
	map = mapData
	folder = Instance.new("Folder")
	folder.Name = "Animatronics"
	folder.Parent = workspace
	rayParams.FilterDescendantsInstances = { folder }
	rayParams.CollisionGroup = "Animatronics" -- ghosts don't collide with this group, so rays ignore them

	local templates = Instance.new("Folder")
	templates.Name = "AnimatronicTemplates"
	for _, name in Mascots.Order do
		Builder.Template(name).Parent = templates
	end
	templates.Parent = ReplicatedStorage

	RunService.Heartbeat:Connect(animate)
end

function AnimatronicService.Spawn(name: string, speedMult: number, wakeDelay: number?)
	if brains[name] then
		return brains[name]
	end
	local def = Mascots[name]
	local model, rig = Builder.Build(name)
	local spawns = map.Spawns[def.Spawn]
	local pos = spawns[rng:NextInteger(1, #spawns)]
	-- face the dining hall
	model:PivotTo(CFrame.lookAt(pos, Vector3.new(0, pos.Y, -10)))
	model.Parent = folder
	local root = model.PrimaryPart :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local pupils = {}
	for _, d in model:GetDescendants() do
		if d.Name == "Pupil" then
			table.insert(pupils, d)
		end
	end

	local brain = {
		Name = name,
		Def = def,
		Model = model,
		Root = root,
		Head = model:FindFirstChild("Head") :: BasePart,
		Torso = model:FindFirstChild("Torso") :: BasePart,
		Humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid,
		Rig = rig,
		HeadBase = rig.Head.C0,
		HeadTilt = 0,
		Pupils = pupils,
		Path = PathfindingService:CreatePath({
			AgentRadius = 2.5,
			AgentHeight = 11,
			AgentCanJump = false,
			WaypointSpacing = 5,
		}),
		SpeedMult = speedMult,
		WakeAt = os.clock() + (wakeDelay or def.ActivateDelay),
		PauseUntil = 0,
		State = "Roam",
		LastSeenTime = 0,
		LastPos = root.Position,
		StuckSince = os.clock(),
		StuckCount = 0,
		Phase = 0,
		Alive = true,
	}
	brain.Humanoid.WalkSpeed = 0
	model:SetAttribute("Awake", false)
	model:SetAttribute("Target", 0)
	model:SetAttribute("DisplayName", def.DisplayName)
	brains[name] = brain

	task.spawn(function()
		while brain.Alive do
			local ok, err = pcall(step, brain)
			if not ok then
				warn("[Animatronic " .. name .. "] " .. tostring(err))
			end
			task.wait(0.15)
		end
	end)
	return brain
end

function AnimatronicService.Despawn(name: string)
	local brain = brains[name]
	if not brain then
		return
	end
	brain.Alive = false
	brains[name] = nil
	brain.Model:Destroy()
end

function AnimatronicService.DespawnAll()
	for name in brains do
		AnimatronicService.Despawn(name)
	end
	table.clear(noises)
	for _, d in decoys do
		if d.Part then
			d.Part:Destroy()
		end
	end
	table.clear(decoys)
end

function AnimatronicService.IsActive(name: string): boolean
	return brains[name] ~= nil
end

function AnimatronicService.AddNoise(pos: Vector3, radius: number)
	table.insert(noises, { Pos = pos, Radius = radius, Time = os.clock() })
	if #noises > 30 then
		table.remove(noises, 1)
	end
end

function AnimatronicService.AddDecoy(pos: Vector3, duration: number)
	local plush = Instance.new("Part")
	plush.Name = "DecoyPlush"
	plush.Shape = Enum.PartType.Ball
	plush.Size = Vector3.new(1.6, 1.6, 1.6)
	plush.Color = Color3.fromRGB(255, 150, 200)
	plush.Material = Enum.Material.Fabric
	plush.CFrame = CFrame.new(pos + Vector3.new(0, 1, 0))
	plush.CanCollide = true
	plush.Parent = workspace
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 200)
	light.Range = 10
	light.Parent = plush
	plush.AssemblyLinearVelocity = Vector3.new(0, 18, 0)
	Debris:AddItem(plush, duration)
	table.insert(decoys, { Pos = pos, Expires = os.clock() + duration, Part = plush })
	AnimatronicService.AddNoise(pos, 90)
end

function AnimatronicService.Reveal(duration: number)
	for _, brain in brains do
		local hl = Instance.new("Highlight")
		hl.Name = "GhostReveal"
		hl.FillColor = Color3.fromRGB(255, 40, 40)
		hl.FillTransparency = 0.6
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = brain.Model
		Debris:AddItem(hl, duration)
	end
end

return AnimatronicService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService — persistent player profiles (DataStore) + leaderstats.
	Works in Studio without API access (falls back to an in-memory profile).
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = {}

local store, ordered
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
	ordered = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
end)

local profiles: { [Player]: any } = {}
local loaded: { [Player]: boolean } = {}

-- hooks set by other services
DataService.MultiplierHook = nil :: ((Player) -> number)?
DataService.ExtraProfileInfo = nil :: ((Player) -> { [string]: any })?

local DEFAULT = {
	Tickets = 50,
	Owned = { Light_Default = true },
	Equipped = { Light = "Light_Default" },
	BestNight = 0,
	NightsSurvived = 0,
	Escapes = 0,
	TokensCollected = 0,
	LastDaily = 0,
	DailyStreak = 0,
	GroupRewardClaimed = false,
	Tutorial = false,
	Receipts = {},
}

local function deepCopy(t)
	local c = {}
	for k, v in t do
		c[k] = type(v) == "table" and deepCopy(v) or v
	end
	return c
end

local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = type(v) == "table" and deepCopy(v) or v
		end
	end
	return data
end

local function key(player: Player)
	return "u_" .. player.UserId
end

local function setupLeaderstats(player: Player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local t = Instance.new("IntValue")
	t.Name = "🎟 Tickets"
	t.Value = data.Tickets
	t.Parent = ls
	local n = Instance.new("IntValue")
	n.Name = "🌙 Nights"
	n.Value = data.NightsSurvived
	n.Parent = ls
	ls.Parent = player
end

local function updateLeaderstats(player: Player)
	local data = profiles[player]
	local ls = player:FindFirstChild("leaderstats")
	if not data or not ls then
		return
	end
	local t = ls:FindFirstChild("🎟 Tickets") :: IntValue
	local n = ls:FindFirstChild("🌙 Nights") :: IntValue
	if t then
		t.Value = data.Tickets
	end
	if n then
		n.Value = data.NightsSurvived
	end
end

function DataService.DailyAvailable(player: Player): boolean
	local data = profiles[player]
	return data ~= nil and os.time() - data.LastDaily >= Config.Daily.Cooldown
end

function DataService.Push(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	updateLeaderstats(player)
	local payload = {
		Tickets = data.Tickets,
		Owned = data.Owned,
		Equipped = data.Equipped,
		BestNight = data.BestNight,
		NightsSurvived = data.NightsSurvived,
		DailyAvailable = DataService.DailyAvailable(player),
		DailyStreak = data.DailyStreak,
		Tutorial = data.Tutorial,
		GroupRewardClaimed = data.GroupRewardClaimed,
	}
	if DataService.ExtraProfileInfo then
		for k, v in DataService.ExtraProfileInfo(player) do
			payload[k] = v
		end
	end
	Remotes.ProfileUpdate:FireClient(player, payload)
end

function DataService.Load(player: Player)
	local data
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				data = result
				break
			end
			warn(("[DataService] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
			task.wait(1.5 * attempt)
		end
	end
	if not player.Parent then
		return nil
	end
	data = reconcile(data or {}, DEFAULT)
	profiles[player] = data
	loaded[player] = true
	setupLeaderstats(player, data)
	DataService.Push(player)
	return data
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.IsLoaded(player: Player): boolean
	return loaded[player] == true
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), data)
	end)
	if not ok then
		warn("[DataService] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	if ordered then
		pcall(function()
			ordered:SetAsync(key(player), data.NightsSurvived)
		end)
	end
end

-- Reward tickets. `raw = true` skips multipliers (purchases, refunds).
function DataService.AddTickets(player: Player, amount: number, raw: boolean?): number
	local data = profiles[player]
	if not data then
		return 0
	end
	if not raw and DataService.MultiplierHook then
		amount = math.floor(amount * DataService.MultiplierHook(player) + 0.5)
	end
	data.Tickets += amount
	DataService.Push(player)
	return amount
end

function DataService.SpendTickets(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.Tickets < amount then
		return false
	end
	data.Tickets -= amount
	DataService.Push(player)
	return true
end

function DataService.Init()
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
		loaded[player] = nil
	end)

	game:BindToClose(function()
		for player in profiles do
			task.spawn(DataService.Save, player)
		end
		task.wait(3)
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(120)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)
end

-- Global top-10 for the lobby board
local nameCache: { [number]: string } = {}
function DataService.GetTop(n: number)
	if not ordered then
		return {}
	end
	local ok, pages = pcall(function()
		return ordered:GetSortedAsync(false, n)
	end)
	if not ok then
		return {}
	end
	local out = {}
	for _, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.sub(entry.key, 3))
		local name = userId and nameCache[userId] or "???"
		if userId and not nameCache[userId] then
			local okName, result = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if okName then
				name = result
				nameCache[userId] = result
			end
		end
		table.insert(out, { Name = name, Value = entry.value })
	end
	return out
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LootService</string>
          <string name="Source"><![CDATA[--[[
	LootService — in-game loot spawned every night:
	  * Prize tickets (persistent currency) scattered on the floor
	  * Batteries
	  * Prize Capsules: hold E to crack them open -> random reward with rarity
	    (items, ticket bundles, or a rare permanent cosmetic!)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Items = require(Shared.Items)
local Cosmetics = require(Shared.Cosmetics)
local DataService = require(script.Parent.DataService)
local PlayerService = require(script.Parent.PlayerService)
local AnimatronicService = require(script.Parent.AnimatronicService)
local MonetizationService = require(script.Parent.MonetizationService)

local LootService = {}

local map
local lootFolder: Folder?
local rng = Random.new()

-- RoundService hook to track tickets earned during the night (for the results screen)
LootService.OnTickets = function(_player: Player, _amount: number) end

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function pickup(part: BasePart, onTake: (Player) -> boolean)
	local taken = false
	part.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and PlayerService.IsActive(player) and onTake(player) then
			taken = true
			part:Destroy()
		end
	end)
end

local function spawnTickets(pos: Vector3)
	local p = Instance.new("Part")
	p.Name = "Tickets"
	p.Size = Vector3.new(1.4, 0.2, 0.8)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(20))
	p.Color = C(255, 90, 140)
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	CollectionService:AddTag(p, "Spin")
	local sparkle = Instance.new("Sparkles")
	sparkle.SparkleColor = C(255, 150, 200)
	sparkle.Parent = p
	p.Parent = lootFolder
	pickup(p, function(player)
		local amount = DataService.AddTickets(player, rng:NextInteger(Config.Rewards.TicketPickupMin, Config.Rewards.TicketPickupMax))
		LootService.OnTickets(player, amount)
		Remotes.Notify:FireClient(player, ("+%d 🎟"):format(amount), "Ticket")
		return true
	end)
end

local function spawnBattery(pos: Vector3)
	local p = Instance.new("Part")
	p.Name = "BatteryPickup"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(1.4, 0.7, 0.7)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	p.Color = C(60, 220, 90)
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	CollectionService:AddTag(p, "Spin")
	local l = Instance.new("PointLight")
	l.Color = C(60, 255, 90)
	l.Range = 7
	l.Parent = p
	p.Parent = lootFolder
	pickup(p, function(player)
		if PlayerService.GiveItem(player, "Battery") then
			Remotes.Notify:FireClient(player, "🔋 Battery found! (press 1)", "Good")
			return true
		end
		return false
	end)
end

local function grantCapsule(player: Player)
	local entry = Items.RollCapsule(rng)
	local reward = { Rarity = entry.Rarity, Title = "", Text = "" }
	if entry.Kind == "Item" then
		local def = Items.Defs[entry.Item]
		if not PlayerService.GiveItem(player, entry.Item) then
			local amount = DataService.AddTickets(player, 15)
			LootService.OnTickets(player, amount)
			reward.Title = ("+%d 🎟"):format(amount)
			reward.Text = "Your " .. def.Name .. " pocket was full"
		else
			reward.Title = def.Icon .. " " .. def.Name
			reward.Text = def.Desc
		end
	elseif entry.Kind == "Tickets" then
		local amount = DataService.AddTickets(player, entry.Amount)
		LootService.OnTickets(player, amount)
		reward.Title = ("+%d 🎟"):format(amount)
		reward.Text = "Prize tickets!"
	else
		local data = DataService.Get(player)
		local rarity = rng:NextNumber() < 0.25 and "Legendary" or "Epic"
		local item = Cosmetics.RandomOfRarity(rarity, rng)
		reward.Rarity = rarity
		if data and not data.Owned[item.Id] then
			data.Owned[item.Id] = true
			reward.Title = "✨ " .. item.Name
			reward.Text = "New " .. item.Type:lower() .. " cosmetic! Equip it in the Wardrobe."
			if rarity == "Legendary" then
				MonetizationService.AwardBadge(player, "Legendary")
			end
			DataService.Push(player)
		else
			local amount = DataService.AddTickets(player, Config.DuplicateRefund[rarity], true)
			reward.Title = ("+%d 🎟"):format(amount)
			reward.Text = "Duplicate " .. item.Name
		end
		for _, p in Players:GetPlayers() do
			Remotes.Notify:FireClient(p, ("🌟 %s found a %s cosmetic in a capsule!"):format(player.DisplayName, rarity:upper()), "Good")
		end
	end
	Remotes.Reward:FireClient(player, reward)
end

local function spawnCapsule(pos: Vector3)
	local model = Instance.new("Model")
	model.Name = "PrizeCapsule"
	local colors = { C(255, 80, 160), C(80, 200, 255), C(255, 210, 60), C(150, 90, 255) }
	local color = colors[rng:NextInteger(1, #colors)]
	local bottom = Instance.new("Part")
	bottom.Name = "Bottom"
	bottom.Shape = Enum.PartType.Ball
	bottom.Size = Vector3.new(2.4, 2.4, 2.4)
	bottom.CFrame = CFrame.new(pos + Vector3.new(0, -0.6, 0))
	bottom.Color = C(245, 245, 245)
	bottom.Material = Enum.Material.SmoothPlastic
	bottom.Anchored = true
	bottom.Parent = model
	local top = Instance.new("Part")
	top.Name = "Top"
	top.Shape = Enum.PartType.Ball
	top.Size = Vector3.new(2.45, 2.45, 2.45)
	top.CFrame = CFrame.new(pos + Vector3.new(0, -0.35, 0))
	top.Color = color
	top.Material = Enum.Material.Glass
	top.Transparency = 0.3
	top.Anchored = true
	top.CanCollide = false
	top.Parent = model
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = top
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Open"
	pp.ObjectText = "Prize Capsule"
	pp.HoldDuration = 1.5
	pp.RequiresLineOfSight = false
	pp.MaxActivationDistance = 8
	pp.Parent = bottom
	model.PrimaryPart = bottom
	model.Parent = lootFolder
	local opened = false
	pp.PromptButtonHoldBegan:Connect(function()
		AnimatronicService.AddNoise(pos, 40)
	end)
	pp.Triggered:Connect(function(player)
		if opened or not PlayerService.IsActive(player) then
			return
		end
		opened = true
		model:Destroy()
		grantCapsule(player)
	end)
end

function LootService.Spawn(playerCount: number)
	LootService.Cleanup()
	lootFolder = Instance.new("Folder")
	lootFolder.Name = "Loot"
	lootFolder.Parent = workspace
	for _ = 1, 14 + playerCount * 2 do
		spawnTickets(map.RandomSpot() + Vector3.new(0, -1.6, 0))
	end
	for _ = 1, 3 + math.ceil(playerCount / 2) do
		spawnBattery(map.RandomSpot() + Vector3.new(0, -1.2, 0))
	end
	for _ = 1, 3 + math.floor(playerCount / 3) do
		spawnCapsule(map.RandomSpot() + Vector3.new(0, -0.5, 0))
	end
end

function LootService.Cleanup()
	if lootFolder then
		lootFolder:Destroy()
		lootFolder = nil
	end
end

------------------------------------------------------------------------------
-- Prize Counter (lobby gacha, spend tickets on cosmetic capsules)
------------------------------------------------------------------------------
local function rollPrize(player: Player, tier: string)
	if typeof(tier) ~= "string" or not Config.CapsuleCosts[tier] then
		return { Ok = false, Error = "Invalid capsule" }
	end
	local data = DataService.Get(player)
	if not data then
		return { Ok = false, Error = "Profile still loading" }
	end
	if not DataService.SpendTickets(player, Config.CapsuleCosts[tier]) then
		return { Ok = false, Error = "Not enough tickets! Survive nights to earn more." }
	end
	local lucky = MonetizationService.HasPass(player, "LuckyCharm")
	local rarity = Cosmetics.RollRarity(tier, lucky, rng)
	local item = Cosmetics.RandomOfRarity(rarity, rng)
	local duplicate = data.Owned[item.Id] == true
	local refund = 0
	if duplicate then
		refund = DataService.AddTickets(player, Config.DuplicateRefund[rarity], true)
	else
		data.Owned[item.Id] = true
		DataService.Push(player)
	end
	if rarity == "Legendary" then
		MonetizationService.AwardBadge(player, "Legendary")
		for _, p in Players:GetPlayers() do
			Remotes.Notify:FireClient(p, ("🌟 %s won the LEGENDARY %s!"):format(player.DisplayName, item.Name), "Good")
		end
	end
	return { Ok = true, Id = item.Id, Name = item.Name, Type = item.Type, Rarity = rarity, Duplicate = duplicate, Refund = refund }
end

function LootService.Init(mapData)
	map = mapData
	Remotes.RollCapsule.OnServerInvoke = rollPrize
end

return LootService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Night Shift at Pip's — server entry point.
	Builds the world, sets up lighting/physics, then starts every service.
]]

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Cosmetics = require(Shared.Cosmetics)

local Server = script.Parent
local MapBuilder = require(Server.MapBuilder)
local DataService = require(Server.DataService)
local MonetizationService = require(Server.MonetizationService)
local PlayerService = require(Server.PlayerService)
local QuestService = require(Server.QuestService)
local LootService = require(Server.LootService)
local RoundService = require(Server.RoundService)

-- Collision groups ----------------------------------------------------------
for _, g in { "Players", "Ghosts", "Animatronics", "NPCBlock" } do
	pcall(function()
		PhysicsService:RegisterCollisionGroup(g)
	end)
end
PhysicsService:CollisionGroupSetCollidable("Ghosts", "Players", false)
PhysicsService:CollisionGroupSetCollidable("Ghosts", "Ghosts", false)
PhysicsService:CollisionGroupSetCollidable("Ghosts", "Animatronics", false)
PhysicsService:CollisionGroupSetCollidable("Ghosts", "NPCBlock", false)
PhysicsService:CollisionGroupSetCollidable("Players", "NPCBlock", false)
PhysicsService:CollisionGroupSetCollidable("Animatronics", "Animatronics", false)
PhysicsService:CollisionGroupSetCollidable("Default", "NPCBlock", false)

-- Lighting: spooky night ----------------------------------------------------
Lighting.ClockTime = 0.5
Lighting.Brightness = 1
Lighting.Ambient = Color3.fromRGB(28, 26, 38)
Lighting.OutdoorAmbient = Color3.fromRGB(45, 45, 70)
Lighting.EnvironmentDiffuseScale = 0.3
Lighting.EnvironmentSpecularScale = 0.5
Lighting.GlobalShadows = true
Lighting.ExposureCompensation = 0.1
for _, child in Lighting:GetChildren() do
	if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
		child:Destroy()
	end
end
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.38
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(70, 60, 100)
atmosphere.Decay = Color3.fromRGB(40, 30, 60)
atmosphere.Glare = 0
atmosphere.Haze = 2
atmosphere.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.8
bloom.Size = 30
bloom.Threshold = 1.4
bloom.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "BaseGrade"
cc.Contrast = 0.12
cc.Saturation = -0.08
cc.TintColor = Color3.fromRGB(235, 230, 255)
cc.Parent = Lighting
local sky = Instance.new("Sky")
sky.StarCount = 3000
sky.MoonAngularSize = 14
sky.Parent = Lighting

-- World ---------------------------------------------------------------------
local map = MapBuilder.Build()

-- Services ------------------------------------------------------------------
DataService.Init()
MonetizationService.Init()
PlayerService.Init(map)
QuestService.Init(map)
LootService.Init(map)
RoundService.Init(map)

-- Lobby booths open UI panels
for _, pp in map.LobbyPrompts do
	pp.Triggered:Connect(function(player)
		Remotes.OpenUI:FireClient(player, pp:GetAttribute("UI"))
	end)
end

-- Players -------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local data = DataService.Load(player)
	if not data then
		return
	end
	MonetizationService.AwardBadge(player, "Welcome")
	MonetizationService.CheckGroup(player)
	PlayerService.ApplyCosmetics(player)
	DataService.Push(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end

-- Profile remotes -----------------------------------------------------------
Remotes.GetProfile.OnServerInvoke = function(player)
	DataService.Push(player)
	return RoundService.Snapshot()
end

Remotes.Equip.OnServerEvent:Connect(function(player, slot, id)
	local data = DataService.Get(player)
	if not data or typeof(slot) ~= "string" or (slot ~= "Light" and slot ~= "Trail" and slot ~= "Title") then
		return
	end
	if id == nil or id == false then
		if slot ~= "Light" then
			data.Equipped[slot] = nil
		end
	elseif typeof(id) == "string" and data.Owned[id] and Cosmetics.ById[id] and Cosmetics.ById[id].Type == slot then
		data.Equipped[slot] = id
	else
		return
	end
	PlayerService.ApplyCosmetics(player)
	DataService.Push(player)
end)

Remotes.ClaimDaily.OnServerEvent:Connect(function(player)
	local data = DataService.Get(player)
	if not data or not DataService.DailyAvailable(player) then
		return
	end
	local now = os.time()
	if now - data.LastDaily > Config.Daily.StreakBreak then
		data.DailyStreak = 0
	end
	data.DailyStreak = math.min(data.DailyStreak + 1, Config.Daily.MaxStreak)
	data.LastDaily = now
	local amount = Config.Daily.Base + Config.Daily.PerStreak * (data.DailyStreak - 1)
	DataService.AddTickets(player, amount, true)
	Remotes.Reward:FireClient(player, {
		Rarity = data.DailyStreak >= Config.Daily.MaxStreak and "Legendary" or (data.DailyStreak >= 4 and "Epic" or "Rare"),
		Title = ("+%d 🎟"):format(amount),
		Text = ("Daily reward — day %d streak! Come back tomorrow for more."):format(data.DailyStreak),
	})
	DataService.Push(player)
end)

Remotes.TutorialDone.OnServerEvent:Connect(function(player)
	local data = DataService.Get(player)
	if data and not data.Tutorial then
		data.Tutorial = true
		DataService.AddTickets(player, 50, true)
		Remotes.Notify:FireClient(player, "Welcome bonus: +50 🎟. Go win prizes!", "Good")
	end
end)

print(("[%s] server ready"):format(Config.GameName))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder — generates the whole 3D world from code (no external assets):
	  * "Pip's Party Palace" pizzeria: 11 rooms (dining hall + stage, arcade, kitchen,
	    parts & service, backstage, security office, restrooms, halls, closet, entrance)
	  * the parking-lot lobby in front of it (neon sign, cars, lamps, prize counter...)
	Returns a "map" table used by the other services.
]]

local CollectionService = game:GetService("CollectionService")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local MapBuilder = {}

local H = 18 -- wall height
local DOOR_H = 11
local WALL_T = 1

local M = Enum.Material
local C = Color3.fromRGB

local PALETTE = {
	WallUpper = C(38, 52, 68),
	WallLower = C(125, 32, 40),
	Trim = C(225, 175, 60),
	DoorFrame = C(45, 30, 25),
	Ceiling = C(70, 70, 78),
	CheckA = C(235, 235, 235),
	CheckB = C(25, 25, 30),
	LightOn = C(255, 220, 170),
	LightOff = C(60, 60, 60),
}

-- Rooms (x1, x2, z1, z2) -------------------------------------------------
local ROOMS = {
	Entrance = { -14, 14, -50, -30, Floor = "Checker", Display = "Entrance" },
	Dining = { -40, 40, -30, 30, Floor = "Checker", Display = "Dining Hall" },
	WestHall = { -54, -40, -30, 30, Floor = "Checker", Display = "West Hall" },
	EastHall = { 40, 54, -30, 30, Floor = "Checker", Display = "East Hall" },
	Arcade = { -100, -54, 0, 30, Floor = "Carpet", Display = "Arcade" },
	Restrooms = { -80, -54, -30, 0, Floor = "Tile", Display = "Restrooms" },
	Kitchen = { 54, 96, 0, 30, Floor = "RedTile", Display = "Kitchen" },
	Parts = { 54, 90, -30, 0, Floor = "Concrete", Display = "Parts & Service" },
	Backstage = { -40, 8, 30, 50, Floor = "Wood", Display = "Backstage" },
	Security = { 8, 32, 30, 50, Floor = "Office", Display = "Security Office" },
	Closet = { 32, 54, 30, 50, Floor = "Concrete", Display = "Supply Closet" },
}

-- Walls: axis, fixed coordinate, from, to, doors {center, width}
local WALLS = {
	{ "X", -50, -14, 14, { { 0, 10 } } },
	{ "X", -30, -80, 90, { { 0, 12 } } },
	{ "Z", -14, -50, -30, {} },
	{ "Z", 14, -50, -30, {} },
	{ "X", 0, -100, -54, {} },
	{ "X", 0, 54, 96, {} },
	{ "Z", -80, -30, 0, {} },
	{ "Z", -100, 0, 30, {} },
	{ "Z", -54, -30, 30, { { -15, 8 }, { 15, 10 } } },
	{ "Z", -40, -30, 30, { { 0, 10 } } },
	{ "Z", 40, -30, 30, { { 0, 10 } } },
	{ "Z", 54, -30, 30, { { -15, 8 }, { 15, 10 } } },
	{ "Z", 90, -30, 0, {} },
	{ "Z", 96, 0, 30, {} },
	{ "X", 30, -100, 96, { { -30, 8 }, { 24, 8 }, { 47, 8 } } },
	{ "X", 50, -40, 54, {} },
	{ "Z", -40, 30, 50, {} },
	{ "Z", 8, 30, 50, { { 40, 8 } } },
	{ "Z", 32, 30, 50, { { 40, 8 } } },
	{ "Z", 54, 30, 50, {} },
}

-- Fuse box candidates: position, facing, rooms it powers
local FUSE_SPOTS = {
	{ Vector3.new(-39.3, 5, -20), Vector3.new(1, 0, 0), { "Dining", "Entrance" } },
	{ Vector3.new(-99.3, 5, 22), Vector3.new(1, 0, 0), { "Arcade", "WestHall" } },
	{ Vector3.new(-62, 5, -29.3), Vector3.new(0, 0, 1), { "Restrooms" } },
	{ Vector3.new(80, 5, 0.7), Vector3.new(0, 0, 1), { "Kitchen", "EastHall" } },
	{ Vector3.new(89.3, 5, -4), Vector3.new(-1, 0, 0), { "Parts" } },
	{ Vector3.new(-39.3, 5, 36), Vector3.new(1, 0, 0), { "Backstage" } },
	{ Vector3.new(45, 5, 49.3), Vector3.new(0, 0, -1), { "Closet", "Security" } },
}

local LOCKER_SPOTS = {
	{ Vector3.new(-41.8, 0, -24), Vector3.new(1, 0, 0) },
	{ Vector3.new(-41.8, 0, 24), Vector3.new(1, 0, 0) },
	{ Vector3.new(52.2, 0, -25), Vector3.new(-1, 0, 0) },
	{ Vector3.new(52.2, 0, 0), Vector3.new(-1, 0, 0) },
	{ Vector3.new(52.2, 0, 25), Vector3.new(-1, 0, 0) },
	{ Vector3.new(94.2, 0, 25), Vector3.new(-1, 0, 0) },
	{ Vector3.new(-98.2, 0, 5), Vector3.new(1, 0, 0) },
	{ Vector3.new(-78.2, 0, -25), Vector3.new(1, 0, 0) },
	{ Vector3.new(-38.2, 0, 46), Vector3.new(1, 0, 0) },
	{ Vector3.new(52.2, 0, 45), Vector3.new(-1, 0, 0) },
	{ Vector3.new(88.2, 0, -25), Vector3.new(-1, 0, 0) },
	{ Vector3.new(-38.2, 0, -27), Vector3.new(1, 0, 0) },
	{ Vector3.new(38.2, 0, -27), Vector3.new(-1, 0, 0) },
}

------------------------------------------------------------------------------
-- Generic helpers
------------------------------------------------------------------------------
local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, name: string?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Name = name or "Part"
	p.Parent = parent
	return p
end

local function ball(parent, diameter, pos, color, material)
	local p = part(parent, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material, "Ball")
	p.Shape = Enum.PartType.Ball
	return p
end

-- Vertical cylinder (Roblox cylinders run along X, so rotate 90°)
local function cyl(parent, height, diameter, pos, color, material)
	local p = part(parent, Vector3.new(height, diameter, diameter), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, material, "Cylinder")
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function deco(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function facing(pos: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(pos, pos + dir)
end

-- Text on the Front face (-Z) of a part
local function sign(p: BasePart, text: string, textColor: Color3, opts: { [string]: any }?)
	opts = opts or {}
	local sg = Instance.new("SurfaceGui")
	sg.Face = opts.Face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = opts.PPS or 40
	sg.LightInfluence = opts.Glow and 0 or 1
	sg.Brightness = opts.Glow and 2 or 1
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = opts.Bg and 0 or 1
	label.BackgroundColor3 = opts.Bg or Color3.new()
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Font = opts.Font or Enum.Font.FredokaOne
	label.TextStrokeTransparency = opts.Stroke and 0 or 1
	label.TextStrokeColor3 = opts.StrokeColor or Color3.new()
	label.Parent = sg
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.06, 0)
	pad.PaddingBottom = UDim.new(0.06, 0)
	pad.Parent = label
	sg.Parent = p
	return sg, label
end

local function prompt(parent: Instance, action: string, object: string, hold: number, distance: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = hold
	pp.MaxActivationDistance = distance or 9
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

------------------------------------------------------------------------------
-- Structure
------------------------------------------------------------------------------
local function buildWallSpan(parent, axis, fixed, a, b, y0, y1)
	local len = b - a
	if len <= 0.05 or y1 - y0 <= 0.05 then
		return
	end
	local function piece(ya, yb, color, mat)
		if yb - ya <= 0.01 then
			return
		end
		local cy = (ya + yb) / 2
		local size, pos
		if axis == "X" then
			size = Vector3.new(len, yb - ya, WALL_T)
			pos = Vector3.new((a + b) / 2, cy, fixed)
		else
			size = Vector3.new(WALL_T, yb - ya, len)
			pos = Vector3.new(fixed, cy, (a + b) / 2)
		end
		part(parent, size, CFrame.new(pos), color, mat, "Wall")
	end
	-- wainscot / trim / upper wall layering
	piece(y0, math.min(y1, 4), PALETTE.WallLower, M.SmoothPlastic)
	piece(math.max(y0, 4), math.min(y1, 4.6), PALETTE.Trim, M.SmoothPlastic)
	piece(math.max(y0, 4.6), y1, PALETTE.WallUpper, M.Plaster)
end

local function doorFrame(parent, axis, fixed, center, width)
	local t = WALL_T + 0.6
	for _, side in { -1, 1 } do
		local c = center + side * (width / 2 + 0.3)
		local pos = axis == "X" and Vector3.new(c, DOOR_H / 2, fixed) or Vector3.new(fixed, DOOR_H / 2, c)
		local size = axis == "X" and Vector3.new(0.6, DOOR_H, t) or Vector3.new(t, DOOR_H, 0.6)
		deco(part(parent, size, CFrame.new(pos), PALETTE.DoorFrame, M.Wood, "DoorFrame"))
	end
	local pos = axis == "X" and Vector3.new(center, DOOR_H + 0.3, fixed) or Vector3.new(fixed, DOOR_H + 0.3, center)
	local size = axis == "X" and Vector3.new(width + 1.2, 0.6, t) or Vector3.new(t, 0.6, width + 1.2)
	deco(part(parent, size, CFrame.new(pos), PALETTE.DoorFrame, M.Wood, "DoorFrame"))
end

local function buildWall(parent, def)
	local axis, fixed, from, to, doors = def[1], def[2], def[3] - 0.5, def[4] + 0.5, def[5]
	table.sort(doors, function(x, y)
		return x[1] < y[1]
	end)
	local cursor = from
	for _, d in doors do
		local d0, d1 = d[1] - d[2] / 2, d[1] + d[2] / 2
		buildWallSpan(parent, axis, fixed, cursor, d0, 0, H)
		buildWallSpan(parent, axis, fixed, d0, d1, DOOR_H, H) -- lintel
		doorFrame(parent, axis, fixed, d[1], d[2])
		cursor = d1
	end
	buildWallSpan(parent, axis, fixed, cursor, to, 0, H)
end

local FLOOR_STYLES = {
	Checker = { Tile = 5, A = PALETTE.CheckA, B = PALETTE.CheckB, Mat = M.SmoothPlastic },
	Tile = { Tile = 3, A = C(220, 225, 230), B = C(180, 190, 200), Mat = M.SmoothPlastic },
	RedTile = { Tile = 4, A = C(170, 40, 40), B = C(230, 230, 230), Mat = M.SmoothPlastic },
	Carpet = { Color = C(45, 20, 70), Mat = M.Fabric },
	Concrete = { Color = C(95, 95, 100), Mat = M.Concrete },
	Wood = { Color = C(90, 60, 40), Mat = M.WoodPlanks },
	Office = { Color = C(50, 60, 80), Mat = M.Fabric },
}

local function buildFloor(parent, room)
	local x1, x2, z1, z2 = room[1], room[2], room[3], room[4]
	local style = FLOOR_STYLES[room.Floor]
	if style.Tile then
		local nx = math.max(1, math.round((x2 - x1) / style.Tile))
		local nz = math.max(1, math.round((z2 - z1) / style.Tile))
		local tx, tz = (x2 - x1) / nx, (z2 - z1) / nz
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				local color = ((i + j) % 2 == 0) and style.A or style.B
				part(parent, Vector3.new(tx, 1, tz), CFrame.new(x1 + tx * (i + 0.5), -0.5, z1 + tz * (j + 0.5)), color, style.Mat, "Floor")
			end
		end
	else
		part(parent, Vector3.new(x2 - x1, 1, z2 - z1), CFrame.new((x1 + x2) / 2, -0.5, (z1 + z2) / 2), style.Color, style.Mat, "Floor")
	end
end

------------------------------------------------------------------------------
-- Props
------------------------------------------------------------------------------
local function partyTable(parent, center: Vector3, length: number)
	local top = part(parent, Vector3.new(4.4, 0.4, length), CFrame.new(center + Vector3.new(0, 3, 0)), C(245, 245, 245), M.Fabric, "Table")
	-- red runner
	deco(part(parent, Vector3.new(1.4, 0.05, length), CFrame.new(center + Vector3.new(0, 3.22, 0)), C(200, 40, 50), M.Fabric))
	for _, sx in { -1.8, 1.8 } do
		for _, sz in { -length / 2 + 0.6, length / 2 - 0.6 } do
			part(parent, Vector3.new(0.4, 2.8, 0.4), CFrame.new(center + Vector3.new(sx, 1.4, sz)), C(60, 60, 60), M.Metal)
		end
	end
	local colors = { C(255, 80, 80), C(80, 180, 255), C(255, 210, 60), C(120, 230, 120), C(220, 110, 255) }
	local n = math.floor(length / 3.2)
	for k = 0, n - 1 do
		local z = -length / 2 + 1.6 + k * 3.2
		for _, sx in { -3.2, 3.2 } do
			-- chair
			part(parent, Vector3.new(1.6, 0.3, 1.6), CFrame.new(center + Vector3.new(sx, 1.8, z)), colors[(k % #colors) + 1], M.SmoothPlastic, "Chair")
			deco(part(parent, Vector3.new(0.3, 1.8, 0.3), CFrame.new(center + Vector3.new(sx, 0.9, z)), C(60, 60, 60), M.Metal))
			-- plate + party hat
			deco(cyl(parent, 0.1, 1.2, center + Vector3.new(sx * 0.42, 3.25, z), C(255, 255, 255)))
			if k % 2 == 0 then
				local hc = colors[((k + 2) % #colors) + 1]
				deco(cyl(parent, 0.5, 0.8, center + Vector3.new(sx * 0.42, 3.55, z + 0.6), hc))
				deco(cyl(parent, 0.5, 0.45, center + Vector3.new(sx * 0.42, 4.05, z + 0.6), hc))
				deco(ball(parent, 0.3, center + Vector3.new(sx * 0.42, 4.4, z + 0.6), C(255, 255, 255)))
			end
		end
		if k % 3 == 1 then
			-- pizza!
			deco(cyl(parent, 0.15, 2.2, center + Vector3.new(0, 3.3, z), C(230, 160, 60)))
			deco(cyl(parent, 0.05, 1.9, center + Vector3.new(0, 3.4, z), C(200, 50, 30)))
		end
	end
	-- balloons
	for b = 1, 3 do
		local off = Vector3.new((b - 2) * 1.1, 0, length / 2 - 0.5)
		local base = center + off + Vector3.new(0, 3.2, 0)
		local top3 = base + Vector3.new(0, 5 + b * 0.6, 0)
		deco(part(parent, Vector3.new(0.08, (top3 - base).Magnitude, 0.08), CFrame.new((base + top3) / 2), C(240, 240, 240)))
		local bl = deco(ball(parent, 1.8, top3 + Vector3.new(0, 0.9, 0), colors[b + 1], M.SmoothPlastic))
		bl.Reflectance = 0.15
	end
	return top
end

local function arcadeMachine(parent, pos: Vector3, dir: Vector3, title: string, color: Color3)
	local cf = facing(pos, dir)
	local body = part(parent, Vector3.new(3, 7, 2.6), cf * CFrame.new(0, 3.5, 0), C(25, 25, 30), M.SmoothPlastic, "Arcade")
	deco(part(parent, Vector3.new(3.1, 0.25, 2.7), cf * CFrame.new(0, 6.9, 0), color, M.Neon))
	deco(part(parent, Vector3.new(0.15, 7, 2.7), cf * CFrame.new(-1.55, 3.5, 0), color, M.Neon))
	deco(part(parent, Vector3.new(0.15, 7, 2.7), cf * CFrame.new(1.55, 3.5, 0), color, M.Neon))
	local screen = deco(part(parent, Vector3.new(2.4, 1.8, 0.1), cf * CFrame.new(0, 4.6, -1.31), C(10, 10, 20), M.Neon, "Screen"))
	sign(screen, title, color, { Glow = true, Bg = C(10, 10, 25), Stroke = true })
	local marquee = deco(part(parent, Vector3.new(2.8, 0.8, 0.1), cf * CFrame.new(0, 6.3, -1.31), color, M.SmoothPlastic))
	sign(marquee, "★ " .. title .. " ★", C(255, 255, 255), { Glow = true })
	deco(part(parent, Vector3.new(2.8, 0.3, 1), cf * CFrame.new(0, 3.3, -1.6), C(40, 40, 50), M.SmoothPlastic))
	deco(ball(parent, 0.45, (cf * CFrame.new(-0.6, 3.6, -1.7)).Position, C(255, 40, 40)))
	deco(ball(parent, 0.35, (cf * CFrame.new(0.5, 3.55, -1.8)).Position, C(40, 140, 255)))
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Front
	light.Color = color
	light.Range = 10
	light.Brightness = 1.2
	light.Parent = screen
	return body
end

local function locker(parent, pos: Vector3, dir: Vector3)
	local cf = facing(pos, dir)
	local model = Instance.new("Model")
	model.Name = "Locker"
	local back = part(model, Vector3.new(4, 8, 0.3), cf * CFrame.new(0, 4, 1.35), C(70, 90, 110), M.Metal)
	part(model, Vector3.new(0.3, 8, 3), cf * CFrame.new(-1.85, 4, 0), C(70, 90, 110), M.Metal)
	part(model, Vector3.new(0.3, 8, 3), cf * CFrame.new(1.85, 4, 0), C(70, 90, 110), M.Metal)
	part(model, Vector3.new(4, 0.3, 3), cf * CFrame.new(0, 8, 0), C(70, 90, 110), M.Metal)
	local door = part(model, Vector3.new(3.4, 7.6, 0.2), cf * CFrame.new(0, 4, -1.4), C(85, 110, 135), M.Metal, "Door")
	door.CanCollide = true
	for i = 0, 3 do
		deco(part(model, Vector3.new(2, 0.15, 0.1), cf * CFrame.new(0, 6.6 - i * 0.4, -1.52), C(20, 20, 25), M.Metal))
	end
	deco(part(model, Vector3.new(0.2, 0.8, 0.2), cf * CFrame.new(1.2, 4, -1.6), C(200, 200, 200), M.Metal))
	model.PrimaryPart = back
	local pp = prompt(door, "Hide", "Locker", 0, 7)
	model:SetAttribute("Inside", cf * CFrame.new(0, 3, 0) :: any)
	model:SetAttribute("Outside", cf * CFrame.new(0, 3, -4) :: any)
	CollectionService:AddTag(model, "Locker")
	model.Parent = parent
	return model, pp
end

local function fuseBox(parent, pos: Vector3, dir: Vector3, zone)
	local cf = facing(pos, dir)
	local model = Instance.new("Model")
	model.Name = "FuseBox"
	local box = part(model, Vector3.new(2.6, 3.4, 0.7), cf, C(110, 115, 120), M.DiamondPlate, "Box")
	deco(part(model, Vector3.new(2.2, 0.4, 0.1), cf * CFrame.new(0, 1.2, -0.4), C(240, 200, 30), M.SmoothPlastic))
	local lamp = deco(part(model, Vector3.new(0.5, 0.5, 0.2), cf * CFrame.new(0.8, -1.2, -0.42), C(255, 40, 40), M.Neon, "Lamp"))
	local lever = deco(part(model, Vector3.new(0.3, 1.2, 0.3), cf * CFrame.new(-0.6, -0.4, -0.55) * CFrame.Angles(math.rad(-30), 0, 0), C(30, 30, 30), M.Metal, "Lever"))
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Color = ColorSequence.new(C(255, 220, 120))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.15, 0)
	sparks.Speed = NumberRange.new(6, 12)
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.Lifetime = NumberRange.new(0.2, 0.5)
	sparks.Rate = 0
	sparks.Acceleration = Vector3.new(0, -40, 0)
	sparks.Parent = lamp
	local tag = deco(part(model, Vector3.new(2.4, 0.6, 0.1), cf * CFrame.new(0, 2.1, -0.36), C(30, 30, 30)))
	sign(tag, "FUSE " .. table.concat(zone, "/"):upper(), C(255, 220, 80), { Glow = true })
	model.PrimaryPart = box
	local pp = prompt(box, "Repair", "Fuse Box", 2.5, 8)
	pp.Enabled = false
	model.Parent = parent
	return { Model = model, Box = box, Lamp = lamp, Lever = lever, Prompt = pp, Zone = zone, Sparks = sparks }
end

local function shelf(parent, pos: Vector3, dir: Vector3, length: number, items: (BasePart, CFrame) -> ()?)
	local cf = facing(pos, dir)
	for _, sx in { -length / 2 + 0.2, length / 2 - 0.2 } do
		part(parent, Vector3.new(0.3, 8, 2), cf * CFrame.new(sx, 4, 0), C(80, 80, 85), M.Metal)
	end
	for lvl = 0, 3 do
		local board = part(parent, Vector3.new(length, 0.25, 2), cf * CFrame.new(0, 0.8 + lvl * 2.2, 0), C(110, 90, 70), M.Wood)
		if items then
			items(board, cf * CFrame.new(0, 0.8 + lvl * 2.2, 0))
		end
	end
end

local function spareHead(parent, pos: Vector3, rot: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, rot, 0)
	deco(part(parent, Vector3.new(1.6, 1.4, 1.4), cf, color, M.Fabric))
	deco(ball(parent, 0.45, (cf * CFrame.new(-0.35, 0.2, -0.65)).Position, C(255, 255, 255)))
	deco(ball(parent, 0.45, (cf * CFrame.new(0.35, 0.2, -0.65)).Position, C(255, 255, 255)))
	deco(ball(parent, 0.18, (cf * CFrame.new(-0.35, 0.2, -0.86)).Position, C(10, 10, 10)))
	deco(ball(parent, 0.18, (cf * CFrame.new(0.35, 0.2, -0.86)).Position, C(10, 10, 10)))
end

local function poster(parent, pos: Vector3, dir: Vector3, text: string, bg: Color3, fg: Color3, size: Vector2?)
	local s = size or Vector2.new(5, 6)
	local p = deco(part(parent, Vector3.new(s.X, s.Y, 0.1), facing(pos, dir), bg, M.SmoothPlastic, "Poster"))
	sign(p, text, fg, { Bg = bg, PPS = 30 })
	return p
end

local function lamp(parent, pos: Vector3, color: Color3, range: number, brightness: number)
	local p = deco(part(parent, Vector3.new(4.5, 0.4, 2), CFrame.new(pos), PALETTE.LightOn, M.Neon, "Fixture"))
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = true
	light.Parent = p
	return p, light
end

------------------------------------------------------------------------------
-- Room decoration
------------------------------------------------------------------------------
local function decorateDining(d)
	-- Stage
	local stageColor = C(60, 25, 70)
	part(d, Vector3.new(32, 3, 10), CFrame.new(0, 1.5, 25), stageColor, M.Wood, "Stage")
	for i = 0, 2 do
		part(d, Vector3.new(32, 1 + i, 2), CFrame.new(0, (1 + i) / 2, 14 + 1 + i * 2), stageColor, M.Wood, "Step")
	end
	deco(part(d, Vector3.new(32.2, 0.2, 0.3), CFrame.new(0, 3.05, 20.1), PALETTE.Trim, M.Neon))
	-- Curtains
	for i = 0, 15 do
		local x = -15 + i * 2
		deco(part(d, Vector3.new(2, 14, 0.6), CFrame.new(x, 10, 29.2 - (i % 2) * 0.35), C(150, 20, 35), M.Fabric, "Curtain"))
	end
	for _, side in { -1, 1 } do
		for i = 0, 2 do
			deco(part(d, Vector3.new(1.4, 15, 1), CFrame.new(side * (16.5 - i * 1.2), 10.5, 24 + i * 2), C(130, 15, 30), M.Fabric))
		end
	end
	deco(part(d, Vector3.new(34, 2, 1), CFrame.new(0, 17, 21), C(120, 15, 30), M.Fabric, "Valance"))
	deco(part(d, Vector3.new(34, 0.3, 1.1), CFrame.new(0, 16, 21), PALETTE.Trim, M.Neon))
	local banner = deco(part(d, Vector3.new(22, 3, 0.2), facing(Vector3.new(0, 14.5, 28.7), Vector3.new(0, 0, -1)), C(255, 210, 60), M.SmoothPlastic))
	sign(banner, "PIP & FRIENDS!", C(150, 20, 35), { Bg = C(255, 210, 60) })
	-- stars on curtains
	for i = 1, 14 do
		deco(part(d, Vector3.new(0.6, 0.6, 0.1), CFrame.new(-13 + i * 1.8, 5 + (i * 7 % 6), 28.7) * CFrame.Angles(0, 0, math.rad(45)), C(255, 230, 120), M.Neon))
	end
	-- Party tables
	for _, x in { -28, -14, 14, 28 } do
		for _, z in { -16, 4 } do
			partyTable(d, Vector3.new(x, 0, z), 12)
		end
	end
	-- Prize shelf / birthday corner
	local cake = Vector3.new(34, 0, -24)
	part(d, Vector3.new(6, 3, 4), CFrame.new(cake + Vector3.new(0, 1.5, 0)), C(245, 245, 245), M.Fabric)
	deco(cyl(d, 1.5, 3, cake + Vector3.new(0, 3.75, 0), C(255, 170, 200)))
	deco(cyl(d, 1, 2, cake + Vector3.new(0, 5, 0), C(255, 255, 255)))
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		deco(part(d, Vector3.new(0.15, 0.8, 0.15), CFrame.new(cake + Vector3.new(math.cos(a) * 0.6, 5.9, math.sin(a) * 0.6)), C(120, 200, 255), M.SmoothPlastic))
	end
	-- Posters
	poster(d, Vector3.new(-39.4, 9, -12), Vector3.new(1, 0, 0), "BRUNO SAYS:\nALWAYS SMILE!", C(140, 85, 45), C(255, 240, 200))
	poster(d, Vector3.new(-39.4, 9, 16), Vector3.new(1, 0, 0), "LET'S PARTY\nWITH PIP!", C(35, 40, 60), C(120, 220, 255))
	poster(d, Vector3.new(39.4, 9, -12), Vector3.new(-1, 0, 0), "STAFF: WIND\nTHE MUSIC BOX\nEVERY HOUR", C(240, 230, 210), C(120, 20, 20))
	poster(d, Vector3.new(39.4, 9, 16), Vector3.new(-1, 0, 0), "HAVE YOU\nSEEN JINX?", C(120, 60, 170), C(255, 230, 80))
	local welcome = deco(part(d, Vector3.new(24, 3, 0.2), facing(Vector3.new(0, 14, -29.3), Vector3.new(0, 0, 1)), C(30, 30, 40), M.SmoothPlastic))
	sign(welcome, "WHERE FUN NEVER SLEEPS", C(255, 120, 200), { Glow = true, Bg = C(30, 30, 40) })
	-- Stage spotlights (part of dining power)
	local spots = {}
	for i, x in { -10, 0, 10 } do
		local can = deco(part(d, Vector3.new(1.2, 1.6, 1.2), CFrame.new(x, 16.6, 16) * CFrame.Angles(math.rad(-35), 0, 0), C(20, 20, 20), M.Metal, "SpotCan"))
		local sl = Instance.new("SpotLight")
		sl.Face = Enum.NormalId.Bottom
		sl.Angle = 45
		sl.Range = 25
		sl.Brightness = 2
		sl.Color = ({ C(255, 80, 120), C(255, 230, 150), C(80, 160, 255) })[i]
		sl.Parent = can
		table.insert(spots, { can, sl })
	end
	return spots
end

local function decorateArcade(d)
	local games = {
		{ "PIXEL PANIC", C(0, 255, 230) },
		{ "PIP KART", C(255, 60, 200) },
		{ "BEAR BASH", C(255, 160, 30) },
		{ "MOOSE RUN", C(120, 255, 80) },
		{ "STAR BLASTER", C(90, 140, 255) },
		{ "PIZZA DASH", C(255, 80, 60) },
		{ "JESTER JUMP", C(200, 90, 255) },
	}
	for i = 0, 6 do
		local g = games[i + 1]
		arcadeMachine(d, Vector3.new(-95 + i * 5, 0, 27.6), Vector3.new(0, 0, -1), g[1], g[2])
	end
	for i = 0, 3 do
		local g = games[((i + 3) % #games) + 1]
		arcadeMachine(d, Vector3.new(-92 + i * 5, 0, 2.4), Vector3.new(0, 0, 1), g[1], g[2])
	end
	-- Claw machine
	local claw = Vector3.new(-62, 0, 6)
	part(d, Vector3.new(5, 3, 5), CFrame.new(claw + Vector3.new(0, 1.5, 0)), C(220, 40, 60), M.SmoothPlastic)
	local glass = part(d, Vector3.new(5, 5, 5), CFrame.new(claw + Vector3.new(0, 5.5, 0)), C(200, 230, 255), M.Glass)
	glass.Transparency = 0.6
	part(d, Vector3.new(5.2, 0.6, 5.2), CFrame.new(claw + Vector3.new(0, 8.3, 0)), C(255, 210, 60), M.Neon)
	for i = 1, 8 do
		local colors = { C(140, 85, 45), C(35, 40, 60), C(196, 150, 95), C(120, 60, 170) }
		deco(ball(d, 1.2, claw + Vector3.new((i % 3 - 1) * 1.3, 3.6 + (i % 2) * 0.6, (math.floor(i / 3) - 1) * 1.3), colors[(i % 4) + 1], M.Fabric))
	end
	-- Jinx's gift box (center of the arcade)
	local box = Vector3.new(-77, 0, 15)
	part(d, Vector3.new(6, 6, 6), CFrame.new(box + Vector3.new(0, 3, 0)), C(110, 40, 160), M.SmoothPlastic, "GiftBox")
	deco(part(d, Vector3.new(6.1, 6.1, 1), CFrame.new(box + Vector3.new(0, 3, 0)), C(255, 210, 60), M.SmoothPlastic))
	deco(part(d, Vector3.new(1, 6.1, 6.1), CFrame.new(box + Vector3.new(0, 3, 0)), C(255, 210, 60), M.SmoothPlastic))
	part(d, Vector3.new(6.6, 0.8, 6.6), CFrame.new(box + Vector3.new(0, 6.4, 0)), C(130, 50, 180), M.SmoothPlastic, "Lid")
	deco(ball(d, 1.6, box + Vector3.new(-0.8, 7.4, 0), C(255, 210, 60)))
	deco(ball(d, 1.6, box + Vector3.new(0.8, 7.4, 0), C(255, 210, 60)))
	local tag = deco(part(d, Vector3.new(5, 1.4, 0.1), facing(box + Vector3.new(0, 4, -3.06), Vector3.new(0, 0, -1)), C(255, 255, 255)))
	sign(tag, "DO NOT OPEN", C(150, 20, 35), { Bg = C(255, 255, 255) })
	-- Neon confetti on the carpet
	local rng = Random.new(7)
	local neon = { C(0, 255, 230), C(255, 60, 200), C(255, 230, 60), C(120, 255, 80) }
	for _ = 1, 50 do
		local x, z = rng:NextNumber(-99, -55), rng:NextNumber(1, 29)
		deco(part(d, Vector3.new(0.6, 0.05, 0.6), CFrame.new(x, 0.03, z) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), neon[rng:NextInteger(1, 4)], M.Neon))
	end
	for _, z in { 0.6, 29.4 } do
		deco(part(d, Vector3.new(46, 0.3, 0.2), CFrame.new(-77, 12, z), C(255, 60, 200), M.Neon))
	end
	local sgn = deco(part(d, Vector3.new(10, 2.5, 0.2), facing(Vector3.new(-54.6, 13, 15), Vector3.new(-1, 0, 0)), C(20, 10, 30)))
	sign(sgn, "ARCADE", C(0, 255, 230), { Glow = true, Bg = C(20, 10, 30) })
end

local function decorateRestrooms(d)
	for i = 0, 3 do
		local z = -28 + i * 6
		part(d, Vector3.new(6, 8, 0.3), CFrame.new(-77, 4, z), C(150, 180, 200), M.SmoothPlastic, "Stall")
		local door = part(d, Vector3.new(0.3, 7, 4), CFrame.new(-74.2, 4, z + 3.2), C(130, 160, 185), M.SmoothPlastic, "StallDoor")
		door.CFrame = door.CFrame * CFrame.Angles(0, math.rad(25 + i * 15), 0)
		deco(cyl(d, 1.6, 2, Vector3.new(-79, 0.8, z + 3), C(250, 250, 250)))
	end
	part(d, Vector3.new(6, 8, 0.3), CFrame.new(-77, 4, -4), C(150, 180, 200), M.SmoothPlastic, "Stall")
	for i = 0, 2 do
		local x = -66 + i * 4
		part(d, Vector3.new(3, 0.8, 2), CFrame.new(x, 3.2, -1.4), C(240, 240, 240), M.Marble, "Sink")
		local mirror = deco(part(d, Vector3.new(3, 3.5, 0.15), CFrame.new(x, 6.5, -0.45), C(200, 220, 230), M.Glass))
		mirror.Reflectance = 0.6
	end
	poster(d, Vector3.new(-54.6, 9, -24), Vector3.new(-1, 0, 0), "WASH YOUR\nHANDS!", C(100, 170, 255), C(255, 255, 255), Vector2.new(4, 3))
end

local function decorateKitchen(d)
	for i = 0, 2 do
		local x = 62 + i * 9
		part(d, Vector3.new(8, 3.4, 3), CFrame.new(x, 1.7, 28), C(170, 175, 180), M.DiamondPlate, "Counter")
	end
	-- pizza ovens
	for i = 0, 1 do
		local pos = Vector3.new(88 + i * 0, 0, 7 + i * 10)
		part(d, Vector3.new(4, 7, 6), CFrame.new(pos + Vector3.new(3, 3.5, 0)), C(120, 60, 40), M.Brick, "Oven")
		local glow = deco(part(d, Vector3.new(0.2, 1.6, 3), CFrame.new(pos + Vector3.new(0.9, 3, 0)), C(255, 120, 30), M.Neon))
		local l = Instance.new("PointLight")
		l.Color = C(255, 120, 30)
		l.Range = 12
		l.Brightness = 1.5
		l.Parent = glow
	end
	part(d, Vector3.new(14, 3.4, 4), CFrame.new(72, 1.7, 15), C(170, 175, 180), M.DiamondPlate, "Island")
	for i = 0, 4 do
		deco(cyl(d, 0.6, 2.4, Vector3.new(67 + i * 2.5, 3.7 + (i % 2) * 0.6, 15), C(200, 160, 110)))
	end
	-- fridge
	part(d, Vector3.new(5, 9, 3), CFrame.new(58, 4.5, 27.4), C(220, 225, 230), M.Metal, "Fridge")
	-- pizza boxes
	for i = 0, 5 do
		deco(part(d, Vector3.new(2.4, 0.4, 2.4), CFrame.new(62, 3.6 + i * 0.42, 28) * CFrame.Angles(0, math.rad(i * 7), 0), C(235, 220, 190), M.Cardboard))
	end
	-- hanging pans
	for i = 0, 3 do
		deco(cyl(d, 0.2, 1.8, Vector3.new(68 + i * 3, 9, 15), C(50, 50, 55)))
	end
	poster(d, Vector3.new(54.6, 9, 24), Vector3.new(1, 0, 0), "EMPLOYEES ONLY", C(200, 40, 40), C(255, 255, 255), Vector2.new(5, 2))
end

local function decorateParts(d)
	local colors = { C(140, 85, 45), C(35, 40, 60), C(196, 150, 95), C(120, 60, 170) }
	shelf(d, Vector3.new(66, 0, -28.4), Vector3.new(0, 0, 1), 14, function(_, cf)
		for k = 0, 3 do
			spareHead(d, (cf * CFrame.new(-5 + k * 3.3, 0.9, 0)).Position, math.rad((k * 37) % 40 - 20), colors[(k % 4) + 1])
		end
	end)
	shelf(d, Vector3.new(88.4, 0, -14), Vector3.new(-1, 0, 0), 10, function(_, cf)
		for k = 0, 2 do
			deco(part(d, Vector3.new(1.6, 1.2, 1.6), cf * CFrame.new(-3 + k * 3, 0.75, 0), C(90, 90, 95), M.Metal))
		end
	end)
	-- workbench with a slumped endoskeleton
	part(d, Vector3.new(10, 3.2, 4), CFrame.new(70, 1.6, -4), C(100, 75, 55), M.Wood, "Workbench")
	deco(part(d, Vector3.new(2, 3, 1.2), CFrame.new(70, 4.7, -4.5) * CFrame.Angles(math.rad(15), 0, 0), C(80, 80, 85), M.Metal))
	spareHead(d, Vector3.new(70, 7, -4.2), math.rad(20), C(70, 70, 75))
	for i = 0, 4 do
		deco(part(d, Vector3.new(0.4, 0.4, 2.5), CFrame.new(66 + i * 0.5, 3.4, -3) * CFrame.Angles(0, math.rad(i * 30), 0), C(60, 60, 65), M.Metal))
	end
	-- crates
	for i = 0, 2 do
		part(d, Vector3.new(4, 4, 4), CFrame.new(60 + i * 1.5, 2 + i * 4, -25) * CFrame.Angles(0, math.rad(i * 15), 0), C(150, 110, 70), M.WoodPlanks, "Crate")
	end
end

local function decorateBackstage(d)
	-- costume racks with slumped suits
	local colors = { C(140, 85, 45), C(196, 150, 95), C(35, 40, 60) }
	for i = 0, 2 do
		local x = -34 + i * 10
		part(d, Vector3.new(6, 0.3, 0.3), CFrame.new(x, 7, 47), C(80, 80, 85), M.Metal)
		for _, sx in { -3, 3 } do
			deco(part(d, Vector3.new(0.3, 7, 0.3), CFrame.new(x + sx, 3.5, 47), C(80, 80, 85), M.Metal))
		end
		deco(part(d, Vector3.new(3, 5, 1.6), CFrame.new(x, 4.3, 47), colors[i + 1], M.Fabric))
		spareHead(d, Vector3.new(x - 4.5, 1, 43), math.rad(i * 25), colors[((i + 1) % 3) + 1])
	end
	part(d, Vector3.new(8, 3, 4), CFrame.new(-8, 1.5, 47), C(100, 75, 55), M.Wood, "Table")
	for i = 0, 3 do
		part(d, Vector3.new(3.5, 3.5, 3.5), CFrame.new(2, 1.75 + (i % 2) * 3.5, 33 + math.floor(i / 2) * 4), C(150, 110, 70), M.WoodPlanks, "Crate")
	end
	poster(d, Vector3.new(-39.4, 9, 40), Vector3.new(1, 0, 0), "SHOWTIME\nIN 5 MIN!", C(150, 20, 35), C(255, 230, 120), Vector2.new(4, 4))
end

local function decorateSecurity(d)
	part(d, Vector3.new(16, 3.2, 4), CFrame.new(20, 1.6, 47.5), C(90, 70, 55), M.Wood, "Desk")
	for i = 0, 2 do
		local pos = Vector3.new(14 + i * 4, 5, 48)
		part(d, Vector3.new(3.6, 2.8, 2), CFrame.new(pos), C(30, 30, 30), M.SmoothPlastic, "Monitor")
		local scr = deco(part(d, Vector3.new(3.2, 2.4, 0.1), facing(pos + Vector3.new(0, 0, -1.03), Vector3.new(0, 0, -1)), C(10, 30, 20), M.Neon))
		sign(scr, ("CAM 0%d\nNO SIGNAL"):format(i + 1), C(80, 255, 140), { Glow = true, Bg = C(5, 20, 10), Font = Enum.Font.Code })
		local l = Instance.new("SurfaceLight")
		l.Color = C(80, 255, 140)
		l.Range = 8
		l.Brightness = 0.8
		l.Parent = scr
	end
	-- chair
	part(d, Vector3.new(2.4, 0.5, 2.4), CFrame.new(20, 2.2, 43.5), C(30, 30, 35), M.Fabric, "Chair")
	part(d, Vector3.new(2.4, 3, 0.4), CFrame.new(20, 3.9, 42.4), C(30, 30, 35), M.Fabric)
	-- kids drawings
	for i = 0, 4 do
		local cols = { C(255, 230, 230), C(230, 255, 230), C(230, 230, 255), C(255, 255, 220), C(255, 230, 255) }
		local p = deco(part(d, Vector3.new(1.6, 1.2, 0.05), facing(Vector3.new(10 + i * 2.2, 9 + (i % 2) * 1.4, 49.45), Vector3.new(0, 0, -1)), cols[i + 1]))
		sign(p, ({ ":)", "PIP", "<3", "BRUNO", "?!" })[i + 1], C(40, 40, 160), { Font = Enum.Font.Cartoon })
	end
end

local function decorateCloset(d)
	shelf(d, Vector3.new(42, 0, 31.6), Vector3.new(0, 0, -1), 12, function(_, cf)
		for k = 0, 2 do
			deco(cyl(d, 1.2, 1, (cf * CFrame.new(-3 + k * 3, 0.75, 0)).Position, ({ C(60, 120, 220), C(220, 220, 60), C(220, 60, 60) })[k + 1]))
		end
	end)
	for i = 0, 2 do
		deco(cyl(d, 1.6, 1.8, Vector3.new(36 + i * 2.2, 0.8, 47), C(90, 140, 200)))
		deco(part(d, Vector3.new(0.2, 6, 0.2), CFrame.new(36 + i * 2.2, 3, 48.3) * CFrame.Angles(math.rad(10), 0, 0), C(150, 110, 70), M.Wood))
	end
end

local function decorateEntrance(d)
	-- ticket booth + rope barriers
	part(d, Vector3.new(6, 4, 3), CFrame.new(-9, 2, -44), C(200, 40, 50), M.SmoothPlastic, "Booth")
	deco(part(d, Vector3.new(6.2, 0.4, 3.2), CFrame.new(-9, 4.2, -44), PALETTE.Trim, M.Neon))
	for _, x in { 6, 10 } do
		deco(cyl(d, 3, 0.4, Vector3.new(x, 1.5, -40), C(220, 180, 60)))
	end
	deco(part(d, Vector3.new(4, 0.2, 0.2), CFrame.new(8, 2.6, -40), C(180, 20, 30), M.Fabric))
	local mat = deco(part(d, Vector3.new(9, 0.05, 5), CFrame.new(0, 0.03, -46), C(150, 20, 35), M.Fabric))
	sign(mat, "WELCOME!", C(255, 220, 80), { Face = Enum.NormalId.Top })
	for _, x in { -12, 12 } do
		deco(cyl(d, 2, 2.4, Vector3.new(x, 1, -32), C(120, 70, 40)))
		deco(ball(d, 3.2, Vector3.new(x, 3.5, -32), C(40, 120, 50), M.Grass))
	end
end

local function decorateHalls(d)
	poster(d, Vector3.new(-53.4, 9, 0), Vector3.new(1, 0, 0), "MAPLE'S\nSING-ALONG\nSATURDAYS!", C(196, 150, 95), C(90, 40, 20))
	poster(d, Vector3.new(53.4, 9, 8), Vector3.new(-1, 0, 0), "NO RUNNING\nIN THE HALLS", C(240, 230, 210), C(150, 20, 35), Vector2.new(5, 4))
	-- exit signs above doors
	for _, spec in {
		{ Vector3.new(-40, 12.5, 0), Vector3.new(1, 0, 0) },
		{ Vector3.new(40, 12.5, 0), Vector3.new(-1, 0, 0) },
		{ Vector3.new(0, 12.5, -29.4), Vector3.new(0, 0, 1) },
	} do
		local s = deco(part(d, Vector3.new(3, 1, 0.3), facing(spec[1] + spec[2] * 0.6, spec[2]), C(20, 120, 40), M.Neon))
		sign(s, "EXIT", C(255, 255, 255), { Glow = true })
	end
end

------------------------------------------------------------------------------
-- Lobby (parking lot in front of the pizzeria)
------------------------------------------------------------------------------
local function car(parent, pos: Vector3, yaw: number, color: Color3)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	part(parent, Vector3.new(6, 2.4, 11), cf * CFrame.new(0, 2, 0), color, M.SmoothPlastic, "Car")
	part(parent, Vector3.new(5.4, 2, 6), cf * CFrame.new(0, 4.2, 0.5), color, M.SmoothPlastic)
	local glass = deco(part(parent, Vector3.new(5.5, 1.6, 6.1), cf * CFrame.new(0, 4.3, 0.5), C(30, 40, 60), M.Glass))
	glass.Transparency = 0.3
	for _, sx in { -2.9, 2.9 } do
		for _, sz in { -3.5, 3.5 } do
			local w = part(parent, Vector3.new(1, 2.2, 2.2), cf * CFrame.new(sx, 1.1, sz), C(20, 20, 20), M.SmoothPlastic)
			w.Shape = Enum.PartType.Cylinder
		end
	end
	for _, sx in { -1.9, 1.9 } do
		deco(part(parent, Vector3.new(1, 0.6, 0.2), cf * CFrame.new(sx, 2.4, -5.55), C(255, 250, 220), M.Neon))
	end
end

local function streetLamp(parent, pos: Vector3)
	deco(cyl(parent, 14, 0.6, pos + Vector3.new(0, 7, 0), C(40, 40, 45), M.Metal)).CanCollide = true
	local head = deco(part(parent, Vector3.new(2.6, 0.6, 1.4), CFrame.new(pos + Vector3.new(0, 14.2, 0)), C(255, 230, 180), M.Neon))
	local l = Instance.new("SpotLight")
	l.Face = Enum.NormalId.Bottom
	l.Angle = 110
	l.Range = 34
	l.Brightness = 2.2
	l.Color = C(255, 210, 150)
	l.Shadows = true
	l.Parent = head
end

local function tree(parent, pos: Vector3, scale: number)
	cyl(parent, 6 * scale, 1.4 * scale, pos + Vector3.new(0, 3 * scale, 0), C(70, 50, 35), M.Wood)
	for i = 0, 2 do
		deco(ball(parent, (7 - i * 1.6) * scale, pos + Vector3.new(0, (6.5 + i * 2.6) * scale, 0), C(25, 60 + i * 10, 35), M.Grass))
	end
end

local function booth(parent, pos: Vector3, dir: Vector3, title: string, color: Color3, action: string)
	local cf = facing(pos, dir)
	part(parent, Vector3.new(10, 4, 3), cf * CFrame.new(0, 2, 0), C(240, 240, 240), M.SmoothPlastic, "Counter")
	deco(part(parent, Vector3.new(10.2, 0.4, 3.2), cf * CFrame.new(0, 4.2, 0), color, M.Neon))
	for _, sx in { -4.7, 4.7 } do
		part(parent, Vector3.new(0.6, 10, 0.6), cf * CFrame.new(sx, 5, 1.2), C(60, 60, 65), M.Metal)
	end
	-- striped awning
	for i = 0, 5 do
		deco(part(parent, Vector3.new(10 / 6, 0.4, 4), cf * CFrame.new(-5 + 10 / 12 + i * 10 / 6, 10, 0) * CFrame.Angles(math.rad(-12), 0, 0),
			(i % 2 == 0) and color or C(255, 255, 255), M.Fabric))
	end
	local board = deco(part(parent, Vector3.new(9, 2.2, 0.3), cf * CFrame.new(0, 11.6, -0.4), C(25, 25, 35)))
	sign(board, title, color, { Glow = true, Bg = C(25, 25, 35) })
	local anchor = part(parent, Vector3.new(1, 1, 1), cf * CFrame.new(0, 3, -2), color)
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.Name = "PromptAnchor"
	local pp = prompt(anchor, action, title, 0, 12)
	return pp, cf
end

local function buildLobby(root, map)
	local lobby = folder("Lobby", root)
	-- ground
	part(lobby, Vector3.new(220, 1, 150), CFrame.new(0, -0.5, -125), C(38, 38, 42), M.Asphalt, "Asphalt")
	part(lobby, Vector3.new(220, 0.4, 10), CFrame.new(0, 0.2, -55), C(120, 120, 125), M.Concrete, "Sidewalk")
	part(lobby, Vector3.new(86, 1, 19.5), CFrame.new(-57, -0.5, -40.75), C(120, 120, 125), M.Concrete, "FrontWalk")
	part(lobby, Vector3.new(86, 1, 19.5), CFrame.new(57, -0.5, -40.75), C(120, 120, 125), M.Concrete, "FrontWalk")
	-- grass beyond the fence
	part(lobby, Vector3.new(500, 1, 500), CFrame.new(0, -1.2, -100), C(30, 50, 30), M.Grass, "Grass")
	-- parking lines
	for row = 0, 1 do
		for i = -5, 5 do
			deco(part(lobby, Vector3.new(0.4, 0.05, 12), CFrame.new(i * 10 + 5, 0.03, -78 - row * 70), C(230, 230, 200), M.SmoothPlastic))
		end
	end
	-- cars
	car(lobby, Vector3.new(-40, 0, -78), 0, C(150, 30, 30))
	car(lobby, Vector3.new(-20, 0, -78), 0, C(40, 70, 140))
	car(lobby, Vector3.new(40, 0, -148), math.pi, C(60, 60, 60))
	car(lobby, Vector3.new(-50, 0, -148), math.pi, C(210, 200, 170))
	car(lobby, Vector3.new(50, 0, -78), 0, C(30, 110, 60))
	-- lamps & trees
	for _, x in { -60, -20, 20, 60 } do
		streetLamp(lobby, Vector3.new(x, 0, -95))
		streetLamp(lobby, Vector3.new(x, 0, -165))
	end
	local rng = Random.new(3)
	for i = 0, 13 do
		tree(lobby, Vector3.new(-90 + i * 14, 0, -192 + rng:NextNumber(-3, 3)), rng:NextNumber(0.9, 1.3))
	end
	for i = 0, 6 do
		tree(lobby, Vector3.new(-95, 0, -70 - i * 17), rng:NextNumber(0.9, 1.3))
		tree(lobby, Vector3.new(95, 0, -70 - i * 17), rng:NextNumber(0.9, 1.3))
	end
	-- fence + invisible boundary
	for _, spec in {
		{ Vector3.new(0, 4, -185), Vector3.new(178, 8, 0.4) },
		{ Vector3.new(-88, 4, -107.5), Vector3.new(0.4, 8, 155) },
		{ Vector3.new(88, 4, -107.5), Vector3.new(0.4, 8, 155) },
	} do
		local f = part(lobby, spec[2], CFrame.new(spec[1]), C(90, 90, 95), M.DiamondPlate, "Fence")
		f.Transparency = 0.55
		local inv = part(lobby, spec[2] + Vector3.new(1.6, 40, 1.6), CFrame.new(spec[1] + Vector3.new(0, 20, 0)), C(0, 0, 0))
		inv.Transparency = 1
		inv.Name = "Boundary"
	end
	-- plug the gap between the west fence and the facade
	local plug = part(lobby, Vector3.new(8, 40, 1), CFrame.new(-84, 20, -30.9), C(0, 0, 0))
	plug.Transparency = 1
	plug.Name = "Boundary"

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.1, -120)
	spawn.Color = C(255, 60, 160)
	spawn.Material = M.Neon
	spawn.Transparency = 0.4
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	map.Spawns.Lobby = CFrame.new(0, 4, -120)

	-- Facade: neon sign + awning + windows
	local facadeColor = C(150, 55, 45)
	part(lobby, Vector3.new(66, H + 6, 0.6), CFrame.new(-47, (H + 6) / 2, -30.9), facadeColor, M.Brick, "Facade")
	part(lobby, Vector3.new(76, H + 6, 0.6), CFrame.new(52, (H + 6) / 2, -30.9), facadeColor, M.Brick, "Facade")
	part(lobby, Vector3.new(28.8, 8, 0.6), CFrame.new(0, H + 4, -50.9), facadeColor, M.Brick, "Facade")
	for _, x in { -60, -35, 35, 60 } do
		local w = part(lobby, Vector3.new(12, 7, 0.3), CFrame.new(x, 6, -31.3), C(255, 200, 120), M.Glass, "Window")
		w.Transparency = 0.55
		for i = 0, 3 do
			deco(part(lobby, Vector3.new(12 / 4, 1, 3), CFrame.new(x - 4.5 + i * 3, 10.5, -32.6) * CFrame.Angles(math.rad(20), 0, 0), (i % 2 == 0) and C(200, 30, 40) or C(255, 255, 255), M.Fabric))
		end
	end
	local neon = deco(part(lobby, Vector3.new(34, 6, 0.6), facing(Vector3.new(0, H + 7, -51.5), Vector3.new(0, 0, -1)), C(20, 10, 30), M.SmoothPlastic, "NeonSign"))
	sign(neon, Config.PizzeriaName, C(255, 90, 200), { Glow = true, Bg = C(20, 10, 30), Stroke = true, StrokeColor = C(120, 0, 90) })
	local glow = Instance.new("SurfaceLight")
	glow.Face = Enum.NormalId.Front
	glow.Color = C(255, 80, 200)
	glow.Range = 40
	glow.Brightness = 3
	glow.Parent = neon
	for _, x in { -18, 18 } do
		deco(part(lobby, Vector3.new(0.6, 6.6, 0.8), CFrame.new(x, H + 7, -51.5), C(0, 255, 230), M.Neon))
	end
	-- pole sign "NOW HIRING"
	cyl(lobby, 16, 1, Vector3.new(-70, 8, -62), C(60, 60, 65), M.Metal)
	local hiring = deco(part(lobby, Vector3.new(14, 7, 1), facing(Vector3.new(-70, 19, -62), Vector3.new(0.4, 0, -1)), C(255, 230, 120), M.SmoothPlastic))
	sign(hiring, "NOW HIRING:\nNIGHT GUARDS\n12AM - 6AM", C(150, 20, 35), { Bg = C(255, 230, 120), Glow = true })

	-- Shift board (client writes the countdown on it)
	local board = part(lobby, Vector3.new(18, 7, 0.6), facing(Vector3.new(0, 9, -96), Vector3.new(0, 0, -1)), C(15, 15, 22), M.SmoothPlastic, "ShiftBoard")
	for _, x in { -8, 8 } do
		cyl(lobby, 6, 0.6, Vector3.new(x, 3, -95.6), C(60, 60, 65), M.Metal)
	end
	sign(board, "NEXT SHIFT SOON", C(255, 220, 80), { Glow = true, Bg = C(15, 15, 22) })
	map.ShiftBoard = board

	-- Booths
	local prizePrompt = booth(lobby, Vector3.new(-32, 0, -112), Vector3.new(0.5, 0, -1), "PRIZE COUNTER", C(255, 80, 180), "Open")
	prizePrompt:SetAttribute("UI", "Prizes")
	-- plushies on the prize counter
	for i = 0, 3 do
		local cols = { C(140, 85, 45), C(35, 40, 60), C(196, 150, 95), C(120, 60, 170) }
		local cf = facing(Vector3.new(-32, 0, -112), Vector3.new(0.5, 0, -1))
		deco(ball(lobby, 1.6, (cf * CFrame.new(-3 + i * 2, 5.2, 0.4)).Position, cols[i + 1], M.Fabric))
	end
	local wardrobePrompt = booth(lobby, Vector3.new(32, 0, -112), Vector3.new(-0.5, 0, -1), "WARDROBE", C(0, 220, 255), "Open")
	wardrobePrompt:SetAttribute("UI", "Wardrobe")
	local shopPrompt = booth(lobby, Vector3.new(-32, 0, -140), Vector3.new(0.5, 0, 1), "GUARD SHOP", C(80, 255, 120), "Open")
	shopPrompt:SetAttribute("UI", "Shop")
	local guidePrompt = booth(lobby, Vector3.new(32, 0, -140), Vector3.new(-0.5, 0, 1), "MEET THE MASCOTS", C(255, 200, 60), "Read")
	guidePrompt:SetAttribute("UI", "Guide")
	map.LobbyPrompts = { prizePrompt, wardrobePrompt, shopPrompt, guidePrompt }

	-- Leaderboard
	local lb = part(lobby, Vector3.new(16, 20, 0.6), facing(Vector3.new(70, 11, -115), Vector3.new(-1, 0, 0)), C(15, 15, 22), M.SmoothPlastic, "Leaderboard")
	cyl(lobby, 2, 1, Vector3.new(70, 1, -109), C(60, 60, 65))
	cyl(lobby, 2, 1, Vector3.new(70, 1, -121), C(60, 60, 65))
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Parent = lb
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.12)
	title.BackgroundColor3 = C(150, 20, 35)
	title.Text = "🏆 TOP GUARDS — NIGHTS SURVIVED"
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = C(255, 230, 120)
	title.Parent = sg
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.05, 0.14)
	list.Size = UDim2.fromScale(0.9, 0.84)
	list.BackgroundTransparency = 1
	list.Text = "Loading..."
	list.TextScaled = true
	list.Font = Enum.Font.GothamMedium
	list.TextColor3 = C(240, 240, 240)
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Parent = sg
	map.LeaderboardLabel = list
end

------------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------------
function MapBuilder.Build()
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local root = folder("Map", workspace)
	local floors = folder("Floor", root)
	local walls = folder("Walls", root)
	local decor = folder("Decor", root)
	local lights = folder("Lights", root)
	local interactive = folder("Interactive", root)

	local map = {
		Folder = root,
		Rooms = ROOMS,
		Lights = {},
		Spawns = {},
		NavPoints = {},
		FuseBoxes = {},
		Lockers = {},
		Floors = floors,
	}

	-- Floors, ceilings, lights
	for name, room in ROOMS do
		buildFloor(floors, room)
		local x1, x2, z1, z2 = room[1], room[2], room[3], room[4]
		part(walls, Vector3.new(x2 - x1, 1, z2 - z1), CFrame.new((x1 + x2) / 2, H + 0.5, (z1 + z2) / 2), PALETTE.Ceiling, M.SmoothPlastic, "Ceiling")
		map.Lights[name] = {}
		local nx = math.max(1, math.round((x2 - x1) / 20))
		local nz = math.max(1, math.round((z2 - z1) / 20))
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				local pos = Vector3.new(x1 + (x2 - x1) * (i + 0.5) / nx, H - 0.2, z1 + (z2 - z1) * (j + 0.5) / nz)
				local p, l = lamp(lights, pos, PALETTE.LightOn, 30, 1.4)
				p:SetAttribute("Room", name)
				table.insert(map.Lights[name], { p, l })
			end
		end
		-- dim red emergency light, always on
		local em = deco(part(lights, Vector3.new(0.8, 0.4, 0.8), CFrame.new(x1 + 2, H - 0.4, z1 + 2), C(255, 30, 30), M.Neon, "Emergency"))
		local el = Instance.new("PointLight")
		el.Color = C(255, 40, 40)
		el.Range = math.max(18, math.min(40, (x2 - x1 + z2 - z1) / 2))
		el.Brightness = 0.5
		el.Parent = em
		table.insert(map.NavPoints, Vector3.new((x1 + x2) / 2, 3, (z1 + z2) / 2))
	end
	-- whole-building roof
	part(walls, Vector3.new(200, 1, 102), CFrame.new(-2, H + 1.5, 0), C(50, 50, 55), M.Concrete, "Roof")

	-- Walls + door nav points
	for _, def in WALLS do
		buildWall(walls, def)
		for _, d in def[5] do
			for _, side in { -3.5, 3.5 } do
				local p = def[1] == "X" and Vector3.new(d[1], 3, def[2] + side) or Vector3.new(def[2] + side, 3, d[1])
				-- skip the outside of the front door
				if not (def[1] == "X" and def[2] == -50 and side < 0) then
					table.insert(map.NavPoints, p)
				end
			end
		end
	end

	-- Decor
	local stageSpots = decorateDining(decor)
	for _, s in stageSpots do
		table.insert(map.Lights.Dining, s)
	end
	decorateArcade(decor)
	decorateRestrooms(decor)
	decorateKitchen(decor)
	decorateParts(decor)
	decorateBackstage(decor)
	decorateSecurity(decor)
	decorateCloset(decor)
	decorateEntrance(decor)
	decorateHalls(decor)

	-- Lockers
	for _, spec in LOCKER_SPOTS do
		local model, pp = locker(interactive, spec[1], spec[2])
		table.insert(map.Lockers, { Model = model, Prompt = pp })
	end

	-- Fuse boxes
	for _, spec in FUSE_SPOTS do
		table.insert(map.FuseBoxes, fuseBox(interactive, spec[1], spec[2], spec[3]))
	end

	-- Music box (Security office)
	do
		local pos = Vector3.new(12, 0, 34)
		part(interactive, Vector3.new(3, 3, 3), CFrame.new(pos + Vector3.new(0, 1.5, 0)), C(60, 30, 80), M.Wood, "Pedestal")
		local box = part(interactive, Vector3.new(2.4, 1.6, 2.4), CFrame.new(pos + Vector3.new(0, 3.8, 0)), C(255, 200, 220), M.SmoothPlastic, "MusicBox")
		deco(part(interactive, Vector3.new(2.5, 0.3, 2.5), CFrame.new(pos + Vector3.new(0, 4.3, 0)), PALETTE.Trim, M.Neon))
		deco(part(interactive, Vector3.new(0.3, 0.3, 1.2), CFrame.new(pos + Vector3.new(1.4, 3.8, 0)), C(220, 180, 60), M.Metal, "Crank"))
		deco(ball(interactive, 0.8, pos + Vector3.new(0, 5.1, 0), C(120, 60, 170)))
		local pp = prompt(box, "Wind", "Music Box", 1.2, 9)
		pp.Enabled = false
		map.MusicBox = { Part = box, Prompt = pp }
	end
	-- VCR (Security office) — tape delivery target
	do
		local pos = Vector3.new(26, 3.2, 47.5)
		part(interactive, Vector3.new(3, 2.6, 2.4), CFrame.new(pos + Vector3.new(0, 1.3, 0)), C(40, 40, 40), M.SmoothPlastic, "TV")
		local vcr = part(interactive, Vector3.new(3, 0.6, 2.2), CFrame.new(pos + Vector3.new(0, -0.0, -0.2)), C(25, 25, 25), M.SmoothPlastic, "VCR")
		deco(part(interactive, Vector3.new(0.3, 0.15, 0.05), CFrame.new(pos + Vector3.new(1, 0, -1.32)), C(255, 40, 40), M.Neon))
		local scr = deco(part(interactive, Vector3.new(2.4, 1.9, 0.1), facing(pos + Vector3.new(0, 1.3, -1.25), Vector3.new(0, 0, -1)), C(20, 20, 50), M.Neon))
		sign(scr, "INSERT TAPE", C(150, 150, 255), { Glow = true, Bg = C(10, 10, 30), Font = Enum.Font.Code })
		local pp = prompt(vcr, "Insert Tape", "VCR", 1, 9)
		map.VCR = { Part = vcr, Prompt = pp }
	end
	-- Generator (Parts & Service) — gas delivery target
	do
		local pos = Vector3.new(80, 0, -24)
		local gen = part(interactive, Vector3.new(7, 5, 5), CFrame.new(pos + Vector3.new(0, 2.5, 0)), C(220, 180, 30), M.Metal, "Generator")
		for i = 0, 3 do
			deco(part(interactive, Vector3.new(7.1, 0.5, 0.2), CFrame.new(pos + Vector3.new(0, 1 + i * 1.1, -2.55)) * CFrame.Angles(0, 0, math.rad(20)), C(20, 20, 20)))
		end
		deco(cyl(interactive, 4, 0.8, pos + Vector3.new(2.5, 7, 1.5), C(60, 60, 60), M.Metal))
		local gauge = deco(part(interactive, Vector3.new(1.6, 1.6, 0.1), facing(pos + Vector3.new(-2, 3.5, -2.56), Vector3.new(0, 0, -1)), C(240, 240, 240)))
		sign(gauge, "FUEL", C(200, 30, 30), {})
		local pp = prompt(gen, "Refuel", "Generator", 1.5, 10)
		map.Generator = { Part = gen, Prompt = pp }
	end

	-- Front door / exit
	do
		local glass = part(interactive, Vector3.new(10, DOOR_H, 0.4), CFrame.new(0, DOOR_H / 2, -50), C(170, 210, 240), M.Glass, "FrontDoor")
		glass.Transparency = 0.5
		local sgn = deco(part(interactive, Vector3.new(4, 1.2, 0.3), facing(Vector3.new(0, DOOR_H + 1.2, -49.4), Vector3.new(0, 0, 1)), C(120, 20, 20), M.Neon, "ExitSign"))
		local _, exitLabel = sign(sgn, "LOCKED", C(255, 255, 255), { Glow = true })
		-- invisible wall that only blocks animatronics
		local npcBlock = part(interactive, Vector3.new(12, DOOR_H, 1), CFrame.new(0, DOOR_H / 2, -48.6), C(0, 0, 0))
		npcBlock.Transparency = 1
		npcBlock.Name = "NPCBlock"
		npcBlock.CollisionGroup = "NPCBlock"
		local zone = part(interactive, Vector3.new(10, 8, 3), CFrame.new(0, 4, -53), C(0, 255, 0))
		zone.Transparency = 1
		zone.CanCollide = false
		zone.Name = "ExitZone"
		map.FrontDoor = { Glass = glass, Sign = sgn, Label = exitLabel, Zone = zone }
	end

	-- Spawn points
	map.Spawns.Entrance = {}
	for i = 0, 7 do
		table.insert(map.Spawns.Entrance, CFrame.new(-4.5 + (i % 4) * 3, 3, -37 + math.floor(i / 4) * 3.5) * CFrame.Angles(0, math.pi, 0))
	end
	map.Spawns.Ghost = CFrame.new(0, 4, -4)
	map.Spawns.Stage = { Vector3.new(-8, 8.2, 25), Vector3.new(8, 8.2, 25), Vector3.new(0, 8.2, 25) }
	map.Spawns.Backstage = { Vector3.new(-16, 5.2, 40) }
	map.Spawns.GiftBox = { Vector3.new(-77, 5.2, 8) }

	buildLobby(root, map)

	-- Random free spot on the floor of a room (for loot/objectives)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { floors, lights }
	local rng = Random.new()
	local weighted = {}
	for name, room in ROOMS do
		if name ~= "Entrance" then
			local area = (room[2] - room[1]) * (room[4] - room[3])
			for _ = 1, math.max(1, math.floor(area / 300)) do
				table.insert(weighted, name)
			end
		end
	end
	function map.RandomSpot(roomName: string?, exclude: { [string]: boolean }?): Vector3
		for _ = 1, 25 do
			local name = roomName or weighted[rng:NextInteger(1, #weighted)]
			if not (exclude and exclude[name]) then
				local room = ROOMS[name]
				local pos = Vector3.new(rng:NextNumber(room[1] + 4, room[2] - 4), 2.6, rng:NextNumber(room[3] + 4, room[4] - 4))
				local hits = workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(3, 3.5, 3), overlap)
				local blocked = false
				for _, h in hits do
					if h.CanCollide then
						blocked = true
						break
					end
				end
				if not blocked then
					return pos
				end
			end
		end
		return Vector3.new(0, 2.6, -10)
	end

	-- drop navigation points that ended up inside furniture, add a few free ones per room
	local valid = {}
	for _, p in map.NavPoints do
		local blocked = false
		for _, h in workspace:GetPartBoundsInBox(CFrame.new(p), Vector3.new(4, 4, 4), overlap) do
			if h.CanCollide then
				blocked = true
				break
			end
		end
		if not blocked then
			table.insert(valid, p)
		end
	end
	for name in ROOMS do
		if name ~= "Entrance" then
			for _ = 1, 2 do
				table.insert(valid, map.RandomSpot(name) + Vector3.new(0, 0.4, 0))
			end
		end
	end
	map.NavPoints = valid

	function map.SetRoomLights(name: string, on: boolean)
		for _, entry in map.Lights[name] or {} do
			local p, l = entry[1], entry[2]
			l.Enabled = on
			if p.Name == "Fixture" then
				p.Material = on and M.Neon or M.SmoothPlastic
				p.Color = on and PALETTE.LightOn or PALETTE.LightOff
			end
		end
	end

	function map.RoomAt(pos: Vector3): string?
		for name, r in ROOMS do
			if pos.X >= r[1] and pos.X <= r[2] and pos.Z >= r[3] and pos.Z <= r[4] then
				return name
			end
		end
		return nil
	end

	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	MonetizationService — game passes, developer products, group bonus, badges.
	IDs come from Config (0 = disabled).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local MonetizationService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local friendsInServer: { [Player]: { [Player]: boolean } } = {}

-- product handlers: name -> function(player) -> boolean (true = granted)
MonetizationService.Handlers = {}

local productById = {}
for name, id in Config.Products do
	if id ~= 0 then
		productById[id] = name
	end
end
local passById = {}
for name, id in Config.GamePasses do
	if id ~= 0 then
		passById[id] = name
	end
end

function MonetizationService.HasPass(player: Player, name: string): boolean
	local o = owned[player]
	return o ~= nil and o[name] == true
end

function MonetizationService.HasFriendHere(player: Player): boolean
	local f = friendsInServer[player]
	if not f then
		return false
	end
	for other in f do
		if other.Parent then
			return true
		end
	end
	return false
end

function MonetizationService.Multiplier(player: Player): number
	local m = 1
	if MonetizationService.HasPass(player, "VIP") then
		m *= Config.Rewards.VIPMultiplier
	end
	if MonetizationService.HasFriendHere(player) then
		m *= 1 + Config.Rewards.FriendBonus
	end
	return m
end

function MonetizationService.AwardBadge(player: Player, name: string)
	local id = Config.Badges[name]
	if not id or id == 0 then
		return
	end
	task.spawn(function()
		pcall(function()
			if not BadgeService:UserHasBadgeAsync(player.UserId, id) then
				BadgeService:AwardBadge(player.UserId, id)
			end
		end)
	end)
end

local function refreshPasses(player: Player)
	local o = owned[player] or {}
	owned[player] = o
	for name, id in Config.GamePasses do
		if id ~= 0 and not o[name] then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			o[name] = ok and has or false
		end
	end
	player:SetAttribute("VIP", o.VIP == true)
end

local function onPlayerAdded(player: Player)
	owned[player] = {}
	friendsInServer[player] = {}
	task.spawn(refreshPasses, player)
	-- friends bonus (+20% tickets when playing together)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			task.spawn(function()
				local ok, isFriend = pcall(function()
					return player:IsFriendsWith(other.UserId)
				end)
				if ok and isFriend and friendsInServer[player] and friendsInServer[other] then
					friendsInServer[player][other] = true
					friendsInServer[other][player] = true
					Remotes.Notify:FireClient(player, ("👫 Playing with your friend %s: +20%% tickets!"):format(other.DisplayName), "Good")
					Remotes.Notify:FireClient(other, ("👫 Playing with your friend %s: +20%% tickets!"):format(player.DisplayName), "Good")
				end
			end)
		end
	end
end

-- group bonus, called once the profile is loaded
function MonetizationService.CheckGroup(player: Player)
	local data = DataService.Get(player)
	if not data or data.GroupRewardClaimed or Config.GroupId == 0 then
		return
	end
	local ok, inGroup = pcall(function()
		return player:IsInGroup(Config.GroupId)
	end)
	if ok and inGroup then
		data.GroupRewardClaimed = true
		DataService.AddTickets(player, Config.GroupReward, true)
		Remotes.Notify:FireClient(player, ("Thanks for joining the group! +%d 🎟"):format(Config.GroupReward), "Good")
	end
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- idempotency: never grant the same receipt twice
	for _, id in data.Receipts do
		if id == info.PurchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	local name = productById[info.ProductId]
	if not name then
		warn("[Monetization] unknown product " .. tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local granted = false
	if Config.ProductRewards[name] then
		DataService.AddTickets(player, Config.ProductRewards[name], true)
		Remotes.Notify:FireClient(player, ("+%d 🎟 Thanks for your support!"):format(Config.ProductRewards[name]), "Good")
		granted = true
	elseif MonetizationService.Handlers[name] then
		local ok, result = pcall(MonetizationService.Handlers[name], player)
		granted = ok and result ~= false
		if not ok then
			warn("[Monetization] handler error: " .. tostring(result))
		end
	end
	if not granted then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, info.PurchaseId)
	while #data.Receipts > 50 do
		table.remove(data.Receipts, 1)
	end
	task.spawn(DataService.Save, player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		onPlayerAdded(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		friendsInServer[player] = nil
		for _, f in friendsInServer do
			f[player] = nil
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passById[passId] then
			owned[player] = owned[player] or {}
			owned[player][passById[passId]] = true
			player:SetAttribute("VIP", owned[player].VIP == true)
			Remotes.Notify:FireClient(player, "✨ " .. passById[passId] .. " unlocked! Thank you!", "Good")
			DataService.Push(player)
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt

	DataService.MultiplierHook = MonetizationService.Multiplier
	DataService.ExtraProfileInfo = function(player)
		local passes = {}
		for name in Config.GamePasses do
			passes[name] = MonetizationService.HasPass(player, name)
		end
		return { Passes = passes }
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--[[
	PlayerService — everything attached to a guard:
	flashlight (battery, aim, freezing Pip), lockers, consumable items,
	ghost look + ghost ping, cosmetics (beam colour, trail, title).

	State is exposed to clients through Player attributes:
	  InNight, Ghost, Hidden, HideUntil, Battery, FlashlightOn, Carrying,
	  SpeedBoostUntil, Inv_Battery, Inv_Soda, Inv_Decoy
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Items = require(Shared.Items)
local Cosmetics = require(Shared.Cosmetics)
local DataService = require(script.Parent.DataService)
local MonetizationService = require(script.Parent.MonetizationService)
local AnimatronicService = require(script.Parent.AnimatronicService)

local PlayerService = {}

local aims: { [Player]: Vector3 } = {}
local hiding: { [Player]: { Locker: Model } } = {}
local lockerOwner: { [Model]: Player } = {}
local lastPing: { [Player]: number } = {}

local litParams = RaycastParams.new()
litParams.FilterType = Enum.RaycastFilterType.Exclude
litParams.RespectCanCollide = true

-- RoundService hook: called when a guard dies outside of an animatronic catch (reset, fall...)
PlayerService.OnDied = nil :: ((Player) -> ())?

local function root(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlayerService.IsActive(player: Player): boolean
	if not player:GetAttribute("InNight") or player:GetAttribute("Ghost") then
		return false
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0 and root(player) ~= nil
end

-- Living, visible guards the animatronics can go after
function PlayerService.GetTargets()
	local out = {}
	for _, player in Players:GetPlayers() do
		if PlayerService.IsActive(player) and not player:GetAttribute("Hidden") then
			local r = root(player) :: BasePart
			local v = r.AssemblyLinearVelocity
			table.insert(out, {
				Player = player,
				Char = player.Character,
				Root = r,
				Sprinting = Vector3.new(v.X, 0, v.Z).Magnitude > Config.SprintNoiseSpeed,
			})
		end
	end
	return out
end

-- Is any flashlight beam pointed at one of these points (with line of sight)?
function PlayerService.IsLit(...: Vector3): boolean
	local points = { ... }
	local animFolder = workspace:FindFirstChild("Animatronics")
	for _, player in Players:GetPlayers() do
		local dir = aims[player]
		if dir and player:GetAttribute("FlashlightOn") and PlayerService.IsActive(player) then
			local head = player.Character:FindFirstChild("Head") :: BasePart?
			if head then
				local origin = head.Position
				for _, point in points do
					local v = point - origin
					local d = v.Magnitude
					if d < Config.Flashlight.Range and d > 0.1 and dir:Dot(v.Unit) >= Config.Flashlight.FreezeCone then
						litParams.FilterDescendantsInstances = { player.Character, animFolder }
						if not workspace:Raycast(origin, v, litParams) then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

------------------------------------------------------------------------------
-- Flashlight
------------------------------------------------------------------------------
local function getSpot(player: Player): SpotLight?
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local att = head and head:FindFirstChild("FlashlightAttachment")
	return att and att:FindFirstChildOfClass("SpotLight")
end

function PlayerService.SetFlashlight(player: Player, on: boolean)
	if on and ((player:GetAttribute("Battery") or 0) <= 0 or not PlayerService.IsActive(player) or player:GetAttribute("Hidden")) then
		on = false
	end
	player:SetAttribute("FlashlightOn", on)
	local spot = getSpot(player)
	if spot then
		spot.Enabled = on
	end
end

local function buildFlashlight(player: Player, char: Model)
	local head = char:WaitForChild("Head", 5) :: BasePart?
	if not head then
		return
	end
	local att = Instance.new("Attachment")
	att.Name = "FlashlightAttachment"
	att.Position = Vector3.new(0, 0.1, -0.7)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Range = Config.Flashlight.Range
	spot.Angle = Config.Flashlight.Angle
	spot.Brightness = Config.Flashlight.Brightness
	spot.Shadows = true
	spot.Enabled = false
	spot.Parent = att
	att.Parent = head
	PlayerService.ApplyCosmetics(player)
end

------------------------------------------------------------------------------
-- Cosmetics
------------------------------------------------------------------------------
function PlayerService.ApplyCosmetics(player: Player)
	local char = player.Character
	local data = DataService.Get(player)
	if not char or not data then
		return
	end
	local eq = data.Equipped
	-- beam colour (+ pro flashlight brightness)
	local spot = getSpot(player)
	if spot then
		local light = Cosmetics.ById[eq.Light or "Light_Default"] or Cosmetics.ById.Light_Default
		spot.Color = light.Color
		spot.Brightness = Config.Flashlight.Brightness * (MonetizationService.HasPass(player, "ProFlashlight") and 1.4 or 1)
	end
	-- trail
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		for _, name in { "CosmeticTrail", "TrailA0", "TrailA1" } do
			local old = hrp:FindFirstChild(name)
			if old then
				old:Destroy()
			end
		end
		local trailItem = eq.Trail and Cosmetics.ById[eq.Trail]
		if trailItem and not player:GetAttribute("Ghost") then
			local a0 = Instance.new("Attachment")
			a0.Name = "TrailA0"
			a0.Position = Vector3.new(0, 0.9, 0)
			a0.Parent = hrp
			local a1 = Instance.new("Attachment")
			a1.Name = "TrailA1"
			a1.Position = Vector3.new(0, -0.9, 0)
			a1.Parent = hrp
			local trail = Instance.new("Trail")
			trail.Name = "CosmeticTrail"
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Color = trailItem.Colors
			trail.Lifetime = 0.6
			trail.LightEmission = 0.6
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.Parent = hrp
		end
	end
	-- overhead tag: title + VIP star
	local head = char:FindFirstChild("Head")
	if head then
		local old = head:FindFirstChild("NameTag")
		if old then
			old:Destroy()
		end
		local title = eq.Title and Cosmetics.ById[eq.Title]
		local vip = MonetizationService.HasPass(player, "VIP")
		if title or vip then
			local bb = Instance.new("BillboardGui")
			bb.Name = "NameTag"
			bb.Size = UDim2.fromOffset(200, 26)
			bb.StudsOffset = Vector3.new(0, 2.6, 0)
			bb.MaxDistance = 60
			bb.AlwaysOnTop = false
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextScaled = true
			label.Font = Enum.Font.FredokaOne
			label.TextStrokeTransparency = 0.3
			label.Text = (vip and "⭐ VIP " or "") .. (title and title.Name or "")
			label.TextColor3 = title and title.Color or Color3.fromRGB(255, 205, 60)
			label.Parent = bb
			bb.Parent = head
		end
	end
end

------------------------------------------------------------------------------
-- Ghosts
------------------------------------------------------------------------------
function PlayerService.ApplyGhostLook(char: Model)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Ghosts"
			if d.Name ~= "HumanoidRootPart" then
				d.Transparency = math.max(d.Transparency, 0.55)
				d.Material = Enum.Material.ForceField
				d.Color = Color3.fromRGB(150, 220, 255)
			end
		elseif d:IsA("Decal") then
			d.Transparency = 0.6
		end
	end
	local head = char:FindFirstChild("Head")
	if head then
		local bb = Instance.new("BillboardGui")
		bb.Name = "GhostTag"
		bb.Size = UDim2.fromOffset(60, 40)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.MaxDistance = 80
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextScaled = true
		label.Text = "👻"
		label.Parent = bb
		bb.Parent = head
	end
end

------------------------------------------------------------------------------
-- Lockers
------------------------------------------------------------------------------
function PlayerService.Unhide(player: Player, silent: boolean?)
	local info = hiding[player]
	if not info then
		return
	end
	hiding[player] = nil
	lockerOwner[info.Locker] = nil
	player:SetAttribute("Hidden", false)
	local r = root(player)
	if r then
		r.Anchored = false
		local outside = info.Locker:GetAttribute("Outside")
		if not silent and typeof(outside) == "CFrame" then
			player.Character:PivotTo(outside)
		end
	end
end

local function hide(player: Player, model: Model)
	local r = root(player)
	local inside = model:GetAttribute("Inside")
	if not r or typeof(inside) ~= "CFrame" then
		return
	end
	hiding[player] = { Locker = model }
	lockerOwner[model] = player
	PlayerService.SetFlashlight(player, false)
	player.Character:PivotTo(inside)
	r.Anchored = true
	player:SetAttribute("Hidden", true)
	player:SetAttribute("HideUntil", workspace:GetServerTimeNow() + Config.HideMaxTime)
end

local function onLocker(player: Player, model: Model)
	local info = hiding[player]
	if info then
		if info.Locker == model then
			PlayerService.Unhide(player)
		end
		return
	end
	if lockerOwner[model] then
		Remotes.Notify:FireClient(player, "Someone is already hiding in there!", "Bad")
		return
	end
	if PlayerService.IsActive(player) then
		hide(player, model)
	end
end

------------------------------------------------------------------------------
-- Items
------------------------------------------------------------------------------
function PlayerService.GiveItem(player: Player, item: string, n: number?): boolean
	local def = Items.Defs[item]
	if not def then
		return false
	end
	local attr = "Inv_" .. item
	local current = player:GetAttribute(attr) or 0
	if current >= def.Max then
		return false
	end
	player:SetAttribute(attr, math.min(def.Max, current + (n or 1)))
	return true
end

local function useItem(player: Player, item: string)
	if typeof(item) ~= "string" or not Items.Defs[item] or not PlayerService.IsActive(player) then
		return
	end
	local attr = "Inv_" .. item
	local count = player:GetAttribute(attr) or 0
	if count <= 0 then
		return
	end
	local r = root(player) :: BasePart
	if item == "Battery" then
		if (player:GetAttribute("Battery") or 0) >= 99 then
			Remotes.Notify:FireClient(player, "Your flashlight is already full!", "Info")
			return
		end
		player:SetAttribute("Battery", 100)
		Remotes.Notify:FireClient(player, "🔋 Flashlight recharged!", "Good")
	elseif item == "Soda" then
		player:SetAttribute("SpeedBoostUntil", workspace:GetServerTimeNow() + Config.SodaDuration)
		Remotes.Notify:FireClient(player, "🥤 Sugar rush! Run!", "Good")
	elseif item == "Decoy" then
		if player:GetAttribute("Hidden") then
			return
		end
		AnimatronicService.AddDecoy(r.Position + r.CFrame.LookVector * 3, Config.DecoyDuration)
		Remotes.Notify:FireClient(player, "🧸 Squeak! The mascots are distracted...", "Good")
	end
	player:SetAttribute(attr, count - 1)
end

------------------------------------------------------------------------------
-- Night lifecycle helpers (used by RoundService)
------------------------------------------------------------------------------
function PlayerService.ResetForNight(player: Player)
	player:SetAttribute("Battery", 100)
	player:SetAttribute("FlashlightOn", false)
	player:SetAttribute("Carrying", "")
	player:SetAttribute("SpeedBoostUntil", 0)
	player:SetAttribute("Hidden", false)
	for _, item in Items.Order do
		player:SetAttribute("Inv_" .. item, item == "Battery" and 1 or 0)
	end
end

function PlayerService.ClearNight(player: Player)
	PlayerService.Unhide(player, true)
	PlayerService.SetFlashlight(player, false)
	player:SetAttribute("InNight", false)
	player:SetAttribute("Ghost", false)
	player:SetAttribute("Carrying", "")
	for _, item in Items.Order do
		player:SetAttribute("Inv_" .. item, 0)
	end
end

------------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------------
local function setCollisionGroup(player: Player, char: Model)
	local function apply(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = player:GetAttribute("Ghost") and "Ghosts" or "Players"
		end
	end
	for _, d in char:GetDescendants() do
		apply(d)
	end
	char.DescendantAdded:Connect(apply)
end

local function onCharacter(player: Player, char: Model)
	setCollisionGroup(player, char)
	task.spawn(buildFlashlight, player, char)
	local hum = char:WaitForChild("Humanoid", 5) :: Humanoid?
	if hum then
		hum.Died:Connect(function()
			PlayerService.Unhide(player, true)
			PlayerService.SetFlashlight(player, false)
			if PlayerService.OnDied then
				PlayerService.OnDied(player)
			end
		end)
	end
end

function PlayerService.Init(map)
	local function onPlayer(player: Player)
		player:SetAttribute("InNight", false)
		player:SetAttribute("Ghost", false)
		PlayerService.ResetForNight(player)
		player.CharacterAdded:Connect(function(char)
			onCharacter(player, char)
		end)
		if player.Character then
			onCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayer, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerService.Unhide(player, true)
		aims[player] = nil
		lastPing[player] = nil
	end)

	for _, entry in map.Lockers do
		entry.Prompt.Triggered:Connect(function(player)
			onLocker(player, entry.Model)
		end)
	end

	Remotes.ToggleFlashlight.OnServerEvent:Connect(function(player)
		PlayerService.SetFlashlight(player, not player:GetAttribute("FlashlightOn"))
	end)

	Remotes.Aim.OnServerEvent:Connect(function(player, dir)
		if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.5 or dir.Magnitude > 1.5 then
			return
		end
		dir = dir.Unit
		aims[player] = dir
		local char = player.Character
		local head = char and char:FindFirstChild("Head") :: BasePart?
		local att = head and head:FindFirstChild("FlashlightAttachment") :: Attachment?
		if head and att then
			local rot = (head.CFrame - head.Position):Inverse() * CFrame.lookAt(Vector3.zero, dir)
			att.CFrame = CFrame.new(0, 0.1, -0.7) * rot
		end
	end)

	Remotes.UseItem.OnServerEvent:Connect(useItem)

	Remotes.GhostPing.OnServerEvent:Connect(function(player)
		if not player:GetAttribute("Ghost") or not player:GetAttribute("InNight") then
			return
		end
		local now = os.clock()
		if lastPing[player] and now - lastPing[player] < Config.GhostPingCooldown then
			return
		end
		lastPing[player] = now
		AnimatronicService.Reveal(Config.GhostPingDuration)
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("InNight") then
				Remotes.Notify:FireClient(p, ("👻 %s revealed the animatronics!"):format(player.DisplayName), "Info")
			end
		end
	end)

	-- battery drain + locker breath timer
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("FlashlightOn") then
					local drain = MonetizationService.HasPass(player, "ProFlashlight") and Config.Flashlight.ProDrain or Config.Flashlight.Drain
					local b = math.max(0, (player:GetAttribute("Battery") or 0) - drain * 0.25)
					player:SetAttribute("Battery", b)
					if b <= 0 then
						PlayerService.SetFlashlight(player, false)
						Remotes.Notify:FireClient(player, "🔦 Battery dead! Find a battery.", "Bad")
					end
				end
				if hiding[player] and workspace:GetServerTimeNow() > (player:GetAttribute("HideUntil") or 0) then
					PlayerService.Unhide(player)
					Remotes.Notify:FireClient(player, "😮‍💨 You ran out of breath!", "Bad")
				end
			end
		end
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--[[
	QuestService — the night's task list (clear objectives):
	  Fuses   : hold E on broken fuse boxes (each one turns the lights back on in its zone)
	  Tokens  : grab golden party tokens scattered around
	  Tape    : carry the mysterious tape to the VCR in the Security Office
	  Gas     : carry gas cans to the generator in Parts & Service
	  Escape  : once everything is done, the front doors open -> run!
	Plus the Music Box (night 4+): keep it wound or Jinx wakes up.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local PlayerService = require(script.Parent.PlayerService)
local AnimatronicService = require(script.Parent.AnimatronicService)

local QuestService = {}

local map
local rng = Random.new()
local nightFolder: Folder?
local objectives = {}
local fusesActive = {}
local items = {} -- delivery items
local carriers: { [Player]: any } = {}
local connections = {}
local musicBox = nil -- { Value, Drain, Warned }
local speedMult = 1
local exitOpen = false

-- callbacks (wired by RoundService)
QuestService.Changed = function() end
QuestService.OnAction = function(_player: Player, _kind: string) end
QuestService.OnObjectiveComplete = function(_obj) end
QuestService.OnAllComplete = function() end
QuestService.OnEscape = function(_player: Player) end

local TEXT = {
	Fuses = "Repair the fuse boxes",
	Tokens = "Collect party tokens",
	Tape = "Bring the tape to the Security Office VCR",
	Gas = "Refuel the generator (Parts & Service)",
	Escape = "ESCAPE through the front doors!",
}

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

local function markTarget(inst: Instance, label: string, active: boolean, forCarry: string?)
	inst:SetAttribute("Label", label)
	inst:SetAttribute("Active", active)
	inst:SetAttribute("ForCarry", forCarry or "")
	if not CollectionService:HasTag(inst, "ObjectiveTarget") then
		CollectionService:AddTag(inst, "ObjectiveTarget")
	end
end

local function getObjective(id: string)
	for _, o in objectives do
		if o.Id == id then
			return o
		end
	end
	return nil
end

local function allMandatoryDone(): boolean
	for _, o in objectives do
		if o.Id ~= "Escape" and not o.Done then
			return false
		end
	end
	return true
end

function QuestService.OpenExit()
	if exitOpen then
		return
	end
	exitOpen = true
	local door = map.FrontDoor
	door.Glass.CanCollide = false
	door.Glass.Transparency = 0.9
	door.Sign.Color = C(20, 160, 50)
	door.Label.Text = "EXIT ➜"
	markTarget(door.Zone, "EXIT", true)
	table.insert(objectives, { Id = "Escape", Text = TEXT.Escape, Progress = 0, Goal = 1, Done = false })
end

local function closeExit()
	exitOpen = false
	local door = map.FrontDoor
	door.Glass.CanCollide = true
	door.Glass.Transparency = 0.5
	door.Sign.Color = C(120, 20, 20)
	door.Label.Text = "LOCKED"
	door.Zone:SetAttribute("Active", false)
end

local function progress(id: string, player: Player?)
	local o = getObjective(id)
	if not o or o.Done then
		return
	end
	o.Progress += 1
	if player then
		QuestService.OnAction(player, id)
	end
	if o.Progress >= o.Goal then
		o.Done = true
		QuestService.OnObjectiveComplete(o)
		if allMandatoryDone() and not exitOpen then
			QuestService.OpenExit()
			QuestService.OnAllComplete()
		end
	end
	QuestService.Changed()
end

------------------------------------------------------------------------------
-- Fuses
------------------------------------------------------------------------------
local function setFuseVisual(fuse, broken: boolean)
	fuse.Lamp.Color = broken and C(255, 40, 40) or C(40, 255, 90)
	fuse.Sparks.Rate = broken and 6 or 0
	local cf = fuse.Box.CFrame
	fuse.Lever.CFrame = cf * CFrame.new(-0.6, -0.4, -0.55) * CFrame.Angles(math.rad(broken and -30 or 30), 0, 0)
end

local function setupFuses(count: number)
	for name in map.Rooms do
		map.SetRoomLights(name, true)
	end
	local pool = table.clone(map.FuseBoxes)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	table.clear(fusesActive)
	for _, fuse in map.FuseBoxes do
		setFuseVisual(fuse, false)
		fuse.Prompt.Enabled = false
		markTarget(fuse.Box, "Fuse Box", false)
	end
	for i = 1, math.min(count, #pool) do
		local fuse = pool[i]
		fuse.Broken = true
		fusesActive[fuse] = true
		setFuseVisual(fuse, true)
		fuse.Prompt.Enabled = true
		markTarget(fuse.Box, "Fuse Box", true)
		for _, room in fuse.Zone do
			map.SetRoomLights(room, false)
		end
	end
	table.insert(objectives, { Id = "Fuses", Text = TEXT.Fuses, Progress = 0, Goal = math.min(count, #pool), Done = false })
end

------------------------------------------------------------------------------
-- Tokens
------------------------------------------------------------------------------
local function spawnToken(pos: Vector3)
	local token = Instance.new("Part")
	token.Name = "PartyToken"
	token.Shape = Enum.PartType.Cylinder
	token.Size = Vector3.new(0.4, 2.2, 2.2)
	token.CFrame = CFrame.new(pos)
	token.Color = C(255, 200, 40)
	token.Material = Enum.Material.Neon
	token.Anchored = true
	token.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = C(255, 200, 60)
	light.Range = 8
	light.Brightness = 1.2
	light.Parent = token
	markTarget(token, "Token", true)
	CollectionService:AddTag(token, "Spin")
	token.Parent = nightFolder
	local taken = false
	token.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and PlayerService.IsActive(player) then
			taken = true
			token:Destroy()
			progress("Tokens", player)
		end
	end)
end

------------------------------------------------------------------------------
-- Deliveries (tape / gas)
------------------------------------------------------------------------------
local function itemVisual(kind: string): Part
	local p = Instance.new("Part")
	p.CanCollide = false
	p.Massless = true
	if kind == "Tape" then
		p.Size = Vector3.new(1.6, 0.4, 1)
		p.Color = C(25, 25, 25)
	else
		p.Size = Vector3.new(1.4, 1.8, 0.8)
		p.Color = C(210, 30, 30)
		p.Material = Enum.Material.Metal
	end
	return p
end

local function attachToHand(player: Player, kind: string)
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) :: BasePart?
	if not hand then
		return nil
	end
	local v = itemVisual(kind)
	v.Name = "Carried"
	v.Anchored = false
	v.CFrame = hand.CFrame * CFrame.new(0, -0.6, -0.4)
	local w = Instance.new("WeldConstraint")
	w.Part0 = hand
	w.Part1 = v
	w.Parent = v
	v.Parent = char
	return v
end

local function placeItem(item, pos: Vector3)
	item.Part.CFrame = CFrame.new(pos)
	item.Part.Transparency = 0
	item.Prompt.Enabled = true
	item.Part:SetAttribute("Active", true)
	item.Holder = nil
end

local function spawnDelivery(kind: string, count: number)
	local exclude = kind == "Tape" and { Security = true } or { Parts = true }
	for _ = 1, count do
		local part = itemVisual(kind)
		part.Name = kind
		part.Anchored = true
		local glow = Instance.new("PointLight")
		glow.Color = kind == "Tape" and C(150, 150, 255) or C(255, 120, 60)
		glow.Range = 8
		glow.Parent = part
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = "Pick up"
		pp.ObjectText = kind == "Tape" and "Strange Tape" or "Gas Can"
		pp.HoldDuration = 0.3
		pp.RequiresLineOfSight = false
		pp.MaxActivationDistance = 8
		pp.Parent = part
		markTarget(part, kind == "Tape" and "Tape" or "Gas Can", true)
		part.Parent = nightFolder
		local item = { Kind = kind, Part = part, Prompt = pp, Holder = nil }
		placeItem(item, map.RandomSpot(nil, exclude))
		table.insert(items, item)
		connect(pp.Triggered, function(player)
			if item.Holder or not PlayerService.IsActive(player) then
				return
			end
			if (player:GetAttribute("Carrying") or "") ~= "" then
				Remotes.Notify:FireClient(player, "Your hands are full! Deliver what you carry first.", "Bad")
				return
			end
			item.Holder = player
			carriers[player] = item
			player:SetAttribute("Carrying", kind)
			item.Part.Transparency = 1
			item.Prompt.Enabled = false
			item.Part:SetAttribute("Active", false)
			item.Visual = attachToHand(player, kind)
			Remotes.Notify:FireClient(player, kind == "Tape" and "📼 Bring it to the VCR in the Security Office!" or "⛽ Bring it to the generator in Parts & Service!", "Info")
			QuestService.Changed()
		end)
	end
	table.insert(objectives, { Id = kind, Text = TEXT[kind], Progress = 0, Goal = count, Done = false })
end

local function deliver(player: Player, kind: string)
	local item = carriers[player]
	if not item or item.Kind ~= kind then
		local want = kind == "Tape" and "the strange tape" or "a gas can"
		Remotes.Notify:FireClient(player, "You need " .. want .. " first!", "Info")
		return
	end
	carriers[player] = nil
	player:SetAttribute("Carrying", "")
	if item.Visual then
		item.Visual:Destroy()
	end
	item.Part:Destroy()
	progress(kind, player)
	if kind == "Gas" then
		AnimatronicService.AddNoise(map.Generator.Part.Position, 50)
	end
end

function QuestService.DropCarry(player: Player)
	local item = carriers[player]
	if not item then
		return
	end
	carriers[player] = nil
	player:SetAttribute("Carrying", "")
	if item.Visual then
		item.Visual:Destroy()
		item.Visual = nil
	end
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pos = r and Vector3.new(r.Position.X, 2.6, r.Position.Z) or map.RandomSpot()
	if not map.RoomAt(pos) then
		pos = map.RandomSpot()
	end
	placeItem(item, pos)
end

------------------------------------------------------------------------------
-- Music box
------------------------------------------------------------------------------
local function setupMusicBox(enabled: boolean, night: number)
	map.MusicBox.Prompt.Enabled = enabled
	markTarget(map.MusicBox.Part, "Music Box", false)
	if enabled then
		musicBox = { Value = 100, Drain = night >= 5 and 2.1 or 1.6, Warned = false }
	else
		musicBox = nil
	end
end

function QuestService.Tick(dt: number)
	if not musicBox then
		return
	end
	local before = musicBox.Value
	musicBox.Value = math.max(0, musicBox.Value - musicBox.Drain * dt)
	map.MusicBox.Part:SetAttribute("Active", musicBox.Value < 50)
	if musicBox.Value < 30 and not musicBox.Warned then
		musicBox.Warned = true
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("InNight") then
				Remotes.Notify:FireClient(p, "🎵 The music box is running out! Wind it in the Security Office!", "Bad")
			end
		end
	end
	if before > 0 and musicBox.Value <= 0 and not AnimatronicService.IsActive("Jinx") then
		AnimatronicService.Spawn("Jinx", speedMult, 2)
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("InNight") then
				Remotes.Notify:FireClient(p, "🃏 The music stopped... JINX IS OUT!", "Big")
			end
		end
	end
end

function QuestService.MusicBoxValue(): number?
	return musicBox and math.floor(musicBox.Value) or nil
end

------------------------------------------------------------------------------
-- Lifecycle
------------------------------------------------------------------------------
function QuestService.Setup(cfg, night: number, playerCount: number)
	QuestService.Cleanup()
	nightFolder = Instance.new("Folder")
	nightFolder.Name = "NightObjects"
	nightFolder.Parent = workspace
	speedMult = cfg.SpeedMult

	setupFuses(cfg.Fuses)

	local tokenCount = cfg.Tokens + math.min(6, math.max(0, playerCount - 1))
	for _ = 1, tokenCount do
		spawnToken(map.RandomSpot())
	end
	table.insert(objectives, { Id = "Tokens", Text = TEXT.Tokens, Progress = 0, Goal = tokenCount, Done = false })

	for _, d in cfg.Deliveries do
		spawnDelivery(d.Kind, d.Count)
	end
	markTarget(map.VCR.Part, "VCR", getObjective("Tape") ~= nil, "Tape")
	markTarget(map.Generator.Part, "Generator", getObjective("Gas") ~= nil, "Gas")

	setupMusicBox(cfg.MusicBox, night)
	QuestService.Changed()
end

function QuestService.Cleanup()
	for _, c in connections do
		c:Disconnect()
	end
	table.clear(connections)
	for player in carriers do
		player:SetAttribute("Carrying", "")
		local item = carriers[player]
		if item.Visual then
			item.Visual:Destroy()
		end
	end
	table.clear(carriers)
	table.clear(items)
	table.clear(objectives)
	if nightFolder then
		nightFolder:Destroy()
		nightFolder = nil
	end
	for _, fuse in map.FuseBoxes do
		fuse.Broken = false
		fuse.Prompt.Enabled = false
		setFuseVisual(fuse, false)
		fuse.Box:SetAttribute("Active", false)
	end
	for name in map.Rooms do
		map.SetRoomLights(name, true)
	end
	map.VCR.Part:SetAttribute("Active", false)
	map.Generator.Part:SetAttribute("Active", false)
	map.MusicBox.Prompt.Enabled = false
	map.MusicBox.Part:SetAttribute("Active", false)
	musicBox = nil
	closeExit()
end

function QuestService.GetObjectives()
	local out = {}
	for _, o in objectives do
		table.insert(out, { Id = o.Id, Text = o.Text, Progress = o.Progress, Goal = o.Goal, Done = o.Done })
	end
	return out
end

function QuestService.ExitOpen(): boolean
	return exitOpen
end

function QuestService.Init(mapData)
	map = mapData

	for _, fuse in map.FuseBoxes do
		fuse.Prompt.PromptButtonHoldBegan:Connect(function()
			-- repairs are noisy: Maple will come and check
			AnimatronicService.AddNoise(fuse.Box.Position, 55)
		end)
		fuse.Prompt.Triggered:Connect(function(player)
			if not fuse.Broken or not PlayerService.IsActive(player) then
				return
			end
			fuse.Broken = false
			fusesActive[fuse] = nil
			fuse.Prompt.Enabled = false
			setFuseVisual(fuse, false)
			fuse.Box:SetAttribute("Active", false)
			for _, room in fuse.Zone do
				map.SetRoomLights(room, true)
			end
			fuse.Sparks:Emit(30)
			progress("Fuses", player)
		end)
	end

	map.VCR.Prompt.Triggered:Connect(function(player)
		if PlayerService.IsActive(player) and getObjective("Tape") then
			deliver(player, "Tape")
		end
	end)
	map.Generator.Prompt.Triggered:Connect(function(player)
		if PlayerService.IsActive(player) and getObjective("Gas") then
			deliver(player, "Gas")
		end
	end)

	map.MusicBox.Prompt.Triggered:Connect(function(player)
		if not musicBox or not PlayerService.IsActive(player) then
			return
		end
		musicBox.Value = math.min(100, musicBox.Value + 40)
		if musicBox.Value >= 30 then
			musicBox.Warned = false
		end
		QuestService.OnAction(player, "MusicBox")
		if AnimatronicService.IsActive("Jinx") and musicBox.Value >= 60 then
			AnimatronicService.Despawn("Jinx")
			for _, p in Players:GetPlayers() do
				if p:GetAttribute("InNight") then
					Remotes.Notify:FireClient(p, ("🎵 %s wound the music box. Jinx went back to sleep..."):format(player.DisplayName), "Good")
				end
			end
		end
	end)

	map.FrontDoor.Zone.Touched:Connect(function(hit)
		if not exitOpen then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and PlayerService.IsActive(player) then
			QuestService.OnEscape(player)
		end
	end)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[--[[
	RoundService — the game loop:
	  Intermission (parking lot) -> Night (12 AM -> 6 AM, ~5 min) -> Results -> ...
	Survive = next night is harder. Everyone caught = retry the same night.
	Caught guards become ghosts: they can reveal the mascots (Q) and are revived
	every time the team completes an objective (or with the Revive product).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Nights = require(Shared.Nights)
local DataService = require(script.Parent.DataService)
local PlayerService = require(script.Parent.PlayerService)
local QuestService = require(script.Parent.QuestService)
local LootService = require(script.Parent.LootService)
local AnimatronicService = require(script.Parent.AnimatronicService)
local MonetizationService = require(script.Parent.MonetizationService)

local RoundService = {}

local map
local state = {
	Phase = "Intermission",
	Night = 1,
	TimeLeft = Config.IntermissionTime,
	Hour = 0,
	Elapsed = 0,
	Message = "",
}
-- participants[player] = { Status = "Alive" | "Ghost" | "Escaped", Tickets = n, Tokens = n }
local participants: { [Player]: any } = {}

local function inRound(): boolean
	return state.Phase == "Night"
end

local function aliveCount(): (number, number)
	local alive, total = 0, 0
	for player, p in participants do
		if player.Parent then
			total += 1
			if p.Status == "Alive" then
				alive += 1
			end
		end
	end
	return alive, total
end

local function canJoin(): boolean
	return inRound() and state.Elapsed < Config.NightLength * Config.LateJoinWindow
end

function RoundService.Snapshot()
	local alive, total = aliveCount()
	return {
		Phase = state.Phase,
		Night = state.Night,
		NightName = Nights.Name(state.Night),
		TimeLeft = math.max(0, math.ceil(state.TimeLeft)),
		Hour = state.Hour,
		Objectives = QuestService.GetObjectives(),
		MusicBox = inRound() and QuestService.MusicBoxValue() or nil,
		ExitOpen = QuestService.ExitOpen(),
		Alive = alive,
		Total = total,
		CanJoin = canJoin(),
		Message = state.Message,
	}
end

local function broadcast()
	Remotes.GameState:FireAllClients(RoundService.Snapshot())
end

local function notifyNight(text: string, kind: string?)
	for player in participants do
		if player.Parent then
			Remotes.Notify:FireClient(player, text, kind or "Info")
		end
	end
end

local function award(player: Player, amount: number, raw: boolean?)
	local got = DataService.AddTickets(player, amount, raw)
	local p = participants[player]
	if p then
		p.Tickets += got
	end
	return got
end

------------------------------------------------------------------------------
-- Character placement
------------------------------------------------------------------------------
local function placeCharacter(player: Player, char: Model)
	local p = participants[player]
	if not inRound() or not p or p.Status == "Escaped" then
		return
	end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp then
		return
	end
	task.wait() -- let the default spawn finish
	if p.Status == "Ghost" then
		PlayerService.ApplyGhostLook(char)
		char:PivotTo(map.Spawns.Ghost)
	else
		local spots = map.Spawns.Entrance
		char:PivotTo(spots[math.random(1, #spots)])
	end
end

local function bringIn(player: Player)
	participants[player] = participants[player] or { Status = "Alive", Tickets = 0, Tokens = 0 }
	participants[player].Status = "Alive"
	PlayerService.ResetForNight(player)
	player:SetAttribute("InNight", true)
	player:SetAttribute("Ghost", false)
	task.spawn(function()
		player:LoadCharacter()
	end)
end

function RoundService.Revive(player: Player): boolean
	local p = participants[player]
	if not inRound() or not p or p.Status ~= "Ghost" then
		return false
	end
	p.Status = "Alive"
	player:SetAttribute("Ghost", false)
	player:SetAttribute("Battery", math.max(50, player:GetAttribute("Battery") or 0))
	task.spawn(function()
		player:LoadCharacter()
	end)
	return true
end

local function reviveAll(reason: string)
	local n = 0
	for player, p in participants do
		if p.Status == "Ghost" and player.Parent then
			RoundService.Revive(player)
			n += 1
		end
	end
	if n > 0 then
		notifyNight("💖 " .. reason .. " Fallen guards are back!", "Good")
	end
end

local function makeGhost(player: Player)
	local p = participants[player]
	if not p or p.Status ~= "Alive" then
		return false
	end
	p.Status = "Ghost"
	QuestService.DropCarry(player)
	PlayerService.Unhide(player, true)
	PlayerService.SetFlashlight(player, false)
	player:SetAttribute("Ghost", true)
	broadcast()
	return true
end

-- Animatronic caught someone
local function onCatch(player: Player, mascot: string): boolean
	if not inRound() or not makeGhost(player) then
		return false
	end
	Remotes.Jumpscare:FireClient(player, mascot)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp.Anchored = true
	end
	for other in participants do
		if other ~= player and other.Parent then
			Remotes.Notify:FireClient(other, ("💀 %s was caught by %s!"):format(player.DisplayName, mascot), "Bad")
		end
	end
	task.delay(2.2, function()
		if player.Parent and participants[player] and participants[player].Status == "Ghost" and inRound() then
			player:LoadCharacter()
			Remotes.Notify:FireClient(player, "👻 You're a ghost! Press Q to reveal the mascots. Teammates revive you by completing tasks.", "Big")
		end
	end)
	return true
end

local function onEscape(player: Player)
	local p = participants[player]
	if not p or p.Status ~= "Alive" then
		return
	end
	p.Status = "Escaped"
	QuestService.DropCarry(player)
	PlayerService.SetFlashlight(player, false)
	player:SetAttribute("InNight", false)
	local got = award(player, Config.Rewards.Escape)
	local data = DataService.Get(player)
	if data then
		data.Escapes += 1
	end
	MonetizationService.AwardBadge(player, "Escape")
	Remotes.Notify:FireClient(player, ("🏃 YOU ESCAPED! +%d 🎟"):format(got), "Big")
	notifyNight(("🚪 %s escaped the pizzeria!"):format(player.DisplayName), "Good")
	broadcast()
end

------------------------------------------------------------------------------
-- Night flow
------------------------------------------------------------------------------
local function startNight()
	local cfg = Nights.Get(state.Night)
	table.clear(participants)
	local players = {}
	for _, player in Players:GetPlayers() do
		if DataService.IsLoaded(player) then
			table.insert(players, player)
		end
	end
	state.Phase = "Night"
	state.Elapsed = 0
	state.Hour = 0
	state.TimeLeft = Config.NightLength
	state.Message = cfg.Intro

	QuestService.Setup(cfg, state.Night, #players)
	LootService.Spawn(#players)
	for _, player in players do
		bringIn(player)
	end

	for _, name in cfg.Animatronics do
		AnimatronicService.Spawn(name, cfg.SpeedMult, nil)
	end

	for _, player in players do
		Remotes.Notify:FireClient(player, Nights.Name(state.Night) .. "|12 AM — " .. cfg.Intro, "Title")
		task.delay(6, function()
			if player.Parent and inRound() then
				Remotes.Notify:FireClient(player, "💡 " .. cfg.Tip, "Info")
			end
		end)
	end
	broadcast()
	return cfg
end

local function endNight(success: boolean)
	state.Phase = "Results"
	state.TimeLeft = Config.ResultsTime
	AnimatronicService.DespawnAll()

	local night = state.Night
	for player, p in participants do
		if player.Parent then
			local survived = p.Status ~= "Ghost"
			local lines = {}
			if survived and success then
				local base = award(player, Config.Rewards.SurviveBase + Config.Rewards.SurvivePerNight * math.min(night, 10))
				table.insert(lines, ("Survived %s: +%d 🎟"):format(Nights.Name(night), base))
				local data = DataService.Get(player)
				if data then
					data.NightsSurvived += 1
					data.BestNight = math.max(data.BestNight, night)
				end
				if night >= 1 then
					MonetizationService.AwardBadge(player, "Night1")
				end
				if night >= 3 then
					MonetizationService.AwardBadge(player, "Night3")
				end
				if night >= 5 then
					MonetizationService.AwardBadge(player, "Night5")
				end
			end
			if MonetizationService.HasPass(player, "VIP") then
				table.insert(lines, "⭐ VIP bonus: x2 tickets")
			end
			if MonetizationService.HasFriendHere(player) then
				table.insert(lines, "👫 Friend bonus: +20% tickets")
			end
			Remotes.Results:FireClient(player, {
				Success = success,
				Survived = survived,
				NightName = Nights.Name(night),
				Escaped = p.Status == "Escaped",
				Tickets = p.Tickets,
				Lines = lines,
			})
			DataService.Push(player)
			task.spawn(DataService.Save, player)
		end
	end

	if success then
		state.Message = Nights.Name(night) .. " complete! Next: " .. Nights.Name(night + 1)
		state.Night += 1
	else
		state.Message = "Everyone got caught... retrying " .. Nights.Name(night)
	end
	broadcast()

	task.wait(Config.ResultsTime)

	QuestService.Cleanup()
	LootService.Cleanup()
	local back = {}
	for player in participants do
		table.insert(back, player)
	end
	table.clear(participants)
	state.Phase = "Intermission"
	for _, player in back do
		if player.Parent then
			PlayerService.ClearNight(player)
			task.spawn(function()
				player:LoadCharacter()
			end)
		end
	end
end

local function runNight()
	startNight()
	local last = os.clock()
	local lastBroadcast = 0
	while true do
		task.wait(0.25)
		local now = os.clock()
		local dt = now - last
		last = now
		state.Elapsed += dt
		state.TimeLeft = Config.NightLength - state.Elapsed
		local hour = math.clamp(math.floor(state.Elapsed / (Config.NightLength / 6)), 0, 6)
		if hour ~= state.Hour then
			state.Hour = hour
			if hour < 6 then
				notifyNight(("🕐 %d AM"):format(hour), "Info")
			end
		end
		QuestService.Tick(dt)

		local alive = aliveCount()
		local anyEscaped = false
		for _, p in participants do
			if p.Status == "Escaped" then
				anyEscaped = true
			end
		end
		if alive == 0 then
			endNight(anyEscaped)
			return
		end
		if state.TimeLeft <= 0 then
			notifyNight("🔔 6 AM! Your shift is over!", "Title")
			endNight(true)
			return
		end
		if now - lastBroadcast >= 1 then
			lastBroadcast = now
			broadcast()
		end
	end
end

local function updateShiftBoard()
	-- the client renders the live countdown; the server keeps a fallback text
	local label = map.ShiftBoard:FindFirstChildOfClass("SurfaceGui")
	label = label and label:FindFirstChild("Label")
	if label then
		if state.Phase == "Intermission" then
			label.Text = ("%s STARTS IN %d"):format(Nights.Name(state.Night), math.max(0, math.ceil(state.TimeLeft)))
		elseif state.Phase == "Night" then
			label.Text = ("%s IN PROGRESS — %d AM"):format(Nights.Name(state.Night), state.Hour == 0 and 12 or state.Hour)
		else
			label.Text = state.Message
		end
	end
end

local function loop()
	while true do
		state.Phase = "Intermission"
		state.TimeLeft = Config.IntermissionTime
		state.Message = ""
		while state.TimeLeft > 0 do
			local ready = 0
			for _, player in Players:GetPlayers() do
				if DataService.IsLoaded(player) then
					ready += 1
				end
			end
			if ready < Config.MinPlayers then
				state.TimeLeft = Config.IntermissionTime
				state.Message = "Waiting for guards..."
			else
				state.Message = ""
			end
			updateShiftBoard()
			broadcast()
			task.wait(1)
			state.TimeLeft -= 1
		end
		local ok, err = pcall(runNight)
		if not ok then
			warn("[RoundService] night crashed: " .. tostring(err))
			AnimatronicService.DespawnAll()
			QuestService.Cleanup()
			LootService.Cleanup()
			for player in participants do
				if player.Parent then
					PlayerService.ClearNight(player)
					player:LoadCharacter()
				end
			end
			table.clear(participants)
		end
	end
end

------------------------------------------------------------------------------
-- Init
------------------------------------------------------------------------------
function RoundService.Init(mapData)
	map = mapData

	AnimatronicService.Init({
		GetTargets = PlayerService.GetTargets,
		IsLit = PlayerService.IsLit,
		OnCatch = onCatch,
	}, map)

	QuestService.Changed = broadcast
	QuestService.OnEscape = onEscape
	QuestService.OnAction = function(player, kind)
		local p = participants[player]
		if kind == "Tokens" then
			if p then
				p.Tokens += 1
			end
			local data = DataService.Get(player)
			if data then
				data.TokensCollected += 1
			end
			local got = award(player, Config.Rewards.Token)
			Remotes.Notify:FireClient(player, ("🪙 Party token! +%d 🎟"):format(got), "Ticket")
		elseif kind == "Fuses" then
			award(player, 5)
			notifyNight(("⚡ %s repaired a fuse box!"):format(player.DisplayName), "Good")
		elseif kind == "Tape" or kind == "Gas" then
			award(player, 10)
			notifyNight(("📦 %s delivered the %s!"):format(player.DisplayName, kind == "Tape" and "tape" or "gas can"), "Good")
		elseif kind == "MusicBox" then
			award(player, 2)
		end
	end
	QuestService.OnObjectiveComplete = function(obj)
		for player, p in participants do
			if player.Parent and p.Status ~= "Escaped" then
				award(player, Config.Rewards.Objective)
			end
		end
		notifyNight(("✅ Task complete: %s (+%d 🎟)"):format(obj.Text, Config.Rewards.Objective), "Good")
		reviveAll("Task complete!")
	end
	QuestService.OnAllComplete = function()
		notifyNight("🚪 ALL TASKS DONE! The front doors are OPEN — escape now or survive until 6 AM!", "Big")
	end
	LootService.OnTickets = function(player, amount)
		local p = participants[player]
		if p then
			p.Tickets += amount
		end
	end

	PlayerService.OnDied = function(player)
		if inRound() and participants[player] and participants[player].Status == "Alive" then
			makeGhost(player)
			notifyNight(("💀 %s is down!"):format(player.DisplayName), "Bad")
		end
	end

	-- character placement during a night
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(char)
			placeCharacter(player, char)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		QuestService.DropCarry(player)
		participants[player] = nil
	end)

	Remotes.JoinShift.OnServerEvent:Connect(function(player)
		if canJoin() and not participants[player] and DataService.IsLoaded(player) then
			bringIn(player)
			Remotes.Notify:FireClient(player, Nights.Name(state.Night) .. "|You clocked in late. Get to work!", "Title")
			broadcast()
		end
	end)

	MonetizationService.Handlers.Revive = function(player)
		if RoundService.Revive(player) then
			notifyNight(("💖 %s used an instant revive!"):format(player.DisplayName), "Good")
			return true
		end
		-- not a ghost anymore: give tickets instead so the purchase is never lost
		DataService.AddTickets(player, 100, true)
		Remotes.Notify:FireClient(player, "You weren't a ghost — here are 100 🎟 instead!", "Good")
		return true
	end
	MonetizationService.Handlers.PowerSurge = function(player)
		for other, p in participants do
			if other.Parent and p.Status == "Alive" then
				other:SetAttribute("Battery", 100)
				PlayerService.GiveItem(other, "Soda")
			end
		end
		for _, other in Players:GetPlayers() do
			Remotes.Notify:FireClient(other, ("⚡ %s bought a POWER SURGE for everyone! Full batteries + soda!"):format(player.DisplayName), "Big")
		end
		if not inRound() then
			DataService.AddTickets(player, 100, true)
		end
		return true
	end

	-- lobby leaderboard
	task.spawn(function()
		while true do
			local top = DataService.GetTop(10)
			local lines = {}
			for i, entry in top do
				table.insert(lines, ("%d. %s — %d"):format(i, entry.Name, entry.Value))
			end
			map.LeaderboardLabel.Text = #lines > 0 and table.concat(lines, "\n") or "Be the first legend!\n(Publish the game to enable leaderboards)"
			task.wait(90)
		end
	end)

	task.spawn(loop)
end

function RoundService.GetState()
	return state
end

return RoundService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--[[
	Controls — keyboard / touch / gamepad input, sprint & stamina, walk speed,
	local flashlight aiming (smooth) + aim replication to the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Items = require(Shared.Items)

local player = Players.LocalPlayer

local Controls = {}

local stamina = Config.StaminaMax
local sprintHeld = false
local sprintToggled = false
local exhausted = false
local lastAim = 0

local function humanoid(): Humanoid?
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Controls.ToggleFlashlight()
	if player:GetAttribute("InNight") and not player:GetAttribute("Ghost") then
		Remotes.ToggleFlashlight:FireServer()
	end
end

function Controls.UseItem(item: string)
	Remotes.UseItem:FireServer(item)
end

function Controls.Ping()
	Remotes.GhostPing:FireServer()
end

function Controls.SprintToggle()
	sprintToggled = not sprintToggled
end

local KEY_ITEMS = {}
for _, item in Items.Order do
	KEY_ITEMS[Enum.KeyCode[Items.Defs[item].Key]] = item
end

function Controls.Init(UI)
	UI.Callbacks.Flashlight = Controls.ToggleFlashlight
	UI.Callbacks.UseItem = Controls.UseItem
	UI.Callbacks.Ping = Controls.Ping
	UI.Callbacks.SprintToggle = Controls.SprintToggle

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.F or key == Enum.KeyCode.ButtonR1 then
			Controls.ToggleFlashlight()
		elseif key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.ButtonL3 then
			sprintHeld = true
		elseif key == Enum.KeyCode.Q or key == Enum.KeyCode.ButtonY then
			Controls.Ping()
		elseif KEY_ITEMS[key] then
			Controls.UseItem(KEY_ITEMS[key])
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.ButtonL3 then
			sprintHeld = false
		end
	end)

	local lastMode = nil
	RunService.RenderStepped:Connect(function(dt)
		local hum = humanoid()
		local ghost = player:GetAttribute("Ghost") == true
		local hidden = player:GetAttribute("Hidden") == true
		local inNight = player:GetAttribute("InNight") == true

		-- ghosts can't interact
		if ProximityPromptService.Enabled == ghost then
			ProximityPromptService.Enabled = not ghost
		end

		-- camera: first person while hiding in a locker
		local mode = hidden and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
		if mode ~= lastMode then
			player.CameraMode = mode
			if not hidden then
				player.CameraMinZoomDistance = 0.5
			end
			lastMode = mode
		end

		-- sprint / stamina
		local moving = hum and hum.MoveDirection.Magnitude > 0.1
		local wantsSprint = (sprintHeld or sprintToggled) and moving and not ghost
		if stamina <= 0 then
			exhausted = true
		elseif stamina > Config.StaminaMax * 0.3 then
			exhausted = false
		end
		local sprinting = wantsSprint and not exhausted
		if sprinting then
			stamina = math.max(0, stamina - Config.StaminaDrain * dt)
		else
			stamina = math.min(Config.StaminaMax, stamina + Config.StaminaRegen * dt)
		end

		if hum then
			local speed = Config.WalkSpeed
			if ghost then
				speed = Config.GhostSpeed
			elseif sprinting then
				speed = Config.SprintSpeed
			end
			if not ghost and workspace:GetServerTimeNow() < (player:GetAttribute("SpeedBoostUntil") or 0) then
				speed += Config.SodaBonus
			end
			if not inNight and not ghost then
				speed = Config.WalkSpeed + 4 -- lobby: comfy speed
			end
			hum.WalkSpeed = speed
		end

		-- flashlight: smooth local aim + 10 Hz replication
		if player:GetAttribute("FlashlightOn") then
			local cam = workspace.CurrentCamera
			local dir = cam.CFrame.LookVector
			local char = player.Character
			local head = char and char:FindFirstChild("Head") :: BasePart?
			local att = head and head:FindFirstChild("FlashlightAttachment") :: Attachment?
			if head and att then
				local rot = (head.CFrame - head.Position):Inverse() * CFrame.lookAt(Vector3.zero, dir)
				att.CFrame = CFrame.new(0, 0.1, -0.7) * rot
			end
			local now = os.clock()
			if now - lastAim > 0.1 then
				lastAim = now
				Remotes.Aim:FireServer(dir)
			end
		end

		UI.UpdatePlayer(stamina)
	end)
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects — atmosphere and danger feedback, all client-side:
	  * lights flicker when a mascot is near (the #1 "danger" cue)
	  * red vignette + tint + camera shake as a mascot gets closer
	  * "X IS CHASING YOU" banner, ghost colour grading
	  * spinning loot, ambience/chase sounds, lobby shift board
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local Effects = {}

local sounds: { [string]: Sound } = {}

function Effects.Sound(name: string, looped: boolean?): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	if sounds[name] then
		return sounds[name]
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id:match("^rbxassetid://") and id or ("rbxassetid://" .. id)
	s.Looped = looped == true
	s.Parent = SoundService
	sounds[name] = s
	return s
end

function Effects.Play(name: string, volume: number?)
	local s = Effects.Sound(name)
	if s then
		s.Volume = volume or 0.8
		s:Play()
	end
end

local function makeVignette(gui: ScreenGui)
	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.Size = UDim2.fromScale(1, 1)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	local edges = {}
	for _, spec in {
		{ UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0.65), -90 },
		{ UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.3, 1), UDim2.fromScale(0.7, 0), 180 },
	} do
		local f = Instance.new("Frame")
		f.Size = spec[1]
		f.Position = spec[2]
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
		f.BackgroundTransparency = 1
		local g = Instance.new("UIGradient")
		g.Rotation = spec[3]
		g.Transparency = NumberSequence.new(0, 1)
		g.Parent = f
		f.Parent = holder
		table.insert(edges, f)
	end
	return edges
end

function Effects.Init(UI)
	local gui = Instance.new("ScreenGui")
	gui.Name = "Effects"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -1
	gui.Parent = player:WaitForChild("PlayerGui")
	local edges = makeVignette(gui)

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "LocalGrade"
	grade.Parent = Lighting

	local ambience = Effects.Sound("Ambience", true)
	if ambience then
		ambience.Volume = 0.4
		ambience:Play()
	end
	local heartbeat = Effects.Sound("Heartbeat", true)
	local chaseMusic = Effects.Sound("Chase", true)

	-- base brightness of every ceiling light (for flickering)
	local lights = {}
	local mapFolder = workspace:WaitForChild("Map", 30)
	local lightFolder = mapFolder and mapFolder:WaitForChild("Lights", 10)
	if lightFolder then
		for _, d in lightFolder:GetDescendants() do
			if d:IsA("PointLight") or d:IsA("SpotLight") then
				local parentPart = d.Parent :: BasePart
				table.insert(lights, { Light = d, Base = d.Brightness, Pos = parentPart.Position })
			end
		end
	end

	local accum = 0
	local danger = 0
	local animFolder = workspace:WaitForChild("Animatronics", 30)
	RunService.RenderStepped:Connect(function(dt)
		-- spinning loot (local only)
		for _, p in CollectionService:GetTagged("Spin") do
			if p:IsA("BasePart") and p.Parent then
				p.CFrame = CFrame.new(p.Position) * CFrame.Angles(0, dt * 2.2, 0) * (p.CFrame - p.Position)
			end
		end

		accum += dt
		if accum < 0.08 then
			return
		end
		local stepDt = accum
		accum = 0

		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local inNight = player:GetAttribute("InNight") == true
		local ghost = player:GetAttribute("Ghost") == true

		-- nearest awake mascot + chase detection
		local nearest = math.huge
		local chasedBy = nil
		local awakePositions = {}
		if animFolder then
			for _, model in animFolder:GetChildren() do
				local r = model:FindFirstChild("HumanoidRootPart") :: BasePart?
				if r and model:GetAttribute("Awake") then
					table.insert(awakePositions, r.Position)
					if hrp then
						nearest = math.min(nearest, (r.Position - hrp.Position).Magnitude)
					end
					if model:GetAttribute("Target") == player.UserId then
						chasedBy = model:GetAttribute("DisplayName") or model.Name
					end
				end
			end
		end
		UI.Chased = (inNight and not ghost) and chasedBy or nil

		-- flicker lights near awake mascots
		for _, entry in lights do
			local near = false
			for _, pos in awakePositions do
				if (pos - entry.Pos).Magnitude < 32 then
					near = true
					break
				end
			end
			if near then
				entry.Light.Brightness = math.random() < 0.35 and entry.Base * 0.08 or entry.Base * (0.6 + math.random() * 0.5)
				entry.Flickering = true
			elseif entry.Flickering then
				entry.Light.Brightness = entry.Base
				entry.Flickering = false
			end
		end

		-- danger level
		local target = 0
		if inNight and not ghost then
			target = math.clamp(1 - (nearest - 8) / 45, 0, 1)
			if chasedBy then
				target = math.max(target, 0.55)
			end
		end
		danger += (target - danger) * math.clamp(stepDt * 4, 0, 1)
		for _, e in edges do
			e.BackgroundTransparency = 1 - danger * 0.85
		end
		if ghost and inNight then
			grade.Saturation = -0.75
			grade.TintColor = Color3.fromRGB(190, 220, 255)
			grade.Brightness = 0.05
		else
			grade.Saturation = -danger * 0.3
			grade.TintColor = Color3.new(1, 1 - danger * 0.35, 1 - danger * 0.35)
			grade.Brightness = 0
		end
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			if danger > 0.7 then
				local s = (danger - 0.7) * 0.8
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
			else
				hum.CameraOffset = Vector3.zero
			end
		end
		if heartbeat then
			heartbeat.Volume = danger
			if danger > 0.05 and not heartbeat.IsPlaying then
				heartbeat:Play()
			elseif danger <= 0.05 and heartbeat.IsPlaying then
				heartbeat:Stop()
			end
		end
		if chaseMusic then
			if UI.Chased and not chaseMusic.IsPlaying then
				chaseMusic.Volume = 0.6
				chaseMusic:Play()
			elseif not UI.Chased and chaseMusic.IsPlaying then
				chaseMusic:Stop()
			end
		end
	end)

	-- lobby shift board (live countdown)
	local board = mapFolder and mapFolder:FindFirstChild("ShiftBoard", true)
	local boardLabel = board and board:FindFirstChildOfClass("SurfaceGui") and board:FindFirstChildOfClass("SurfaceGui"):FindFirstChild("Label")
	local lastPhase = nil
	Remotes.GameState.OnClientEvent:Connect(function(s)
		if boardLabel then
			if s.Phase == "Intermission" then
				boardLabel.Text = ("%s STARTS IN %d"):format(s.NightName, s.TimeLeft)
			elseif s.Phase == "Night" then
				boardLabel.Text = ("%s — %d/%d GUARDS ALIVE"):format(s.NightName, s.Alive, s.Total)
			else
				boardLabel.Text = s.Message
			end
		end
		if s.Phase ~= lastPhase then
			if s.Phase == "Results" and lastPhase == "Night" then
				Effects.Play("SixAM", 0.8)
			end
			lastPhase = s.Phase
		end
	end)

	-- pickup / repair sounds
	Remotes.Notify.OnClientEvent:Connect(function(_text, kind)
		if kind == "Ticket" then
			Effects.Play("Pickup", 0.5)
		end
	end)
	Remotes.Reward.OnClientEvent:Connect(function()
		Effects.Play("Capsule", 0.7)
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Jumpscare</string>
            <string name="Source"><![CDATA[--[[
	Jumpscare — full-screen close-up of the mascot that caught you, rendered with a
	ViewportFrame using the server's template model (no image assets needed).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

local Jumpscare = {}

function Jumpscare.Play(name: string, effects)
	local templates = ReplicatedStorage:FindFirstChild("AnimatronicTemplates")
	local template = templates and templates:FindFirstChild(name)
	if not template then
		return
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "Jumpscare"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false

	local vp = Instance.new("ViewportFrame")
	vp.Size = UDim2.fromScale(1, 1)
	vp.BackgroundColor3 = Color3.new(0, 0, 0)
	vp.Ambient = Color3.fromRGB(150, 140, 140)
	vp.LightColor = Color3.fromRGB(255, 210, 200)
	vp.LightDirection = Vector3.new(0.3, -0.6, 1)
	vp.Parent = gui

	local model = template:Clone()
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 60
	cam.Parent = vp
	vp.CurrentCamera = cam

	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	flash.BackgroundTransparency = 0.4
	flash.ZIndex = 5
	flash.Parent = gui

	gui.Parent = player:WaitForChild("PlayerGui")
	if effects then
		effects.Play("Jumpscare", 1)
	end

	local head = model:FindFirstChild("Head") :: BasePart
	local jaw = model:FindFirstChild("Jaw") :: BasePart?
	local jawBase = jaw and jaw.CFrame
	local center = head.Position + Vector3.new(0, -0.6, 0)
	local forward = head.CFrame.LookVector
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local approach = math.clamp(t / 0.35, 0, 1)
		local dist = 16 - 12.2 * (approach ^ 0.5)
		local shake = (1 - math.clamp((t - 1) / 0.6, 0, 1)) * 0.35
		local offset = Vector3.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, 0)
		cam.CFrame = CFrame.lookAt(center + forward * dist + offset, center) * CFrame.Angles(0, 0, (math.random() - 0.5) * shake * 0.3)
		if jaw and jawBase then
			jaw.CFrame = jawBase * CFrame.new(0, -0.9 * math.clamp(t * 4, 0, 1), 0.2)
		end
		flash.BackgroundTransparency = 0.4 + 0.6 * math.clamp(t * 3, 0, 1) + (math.random() < 0.2 and -0.3 or 0)
		if t > 1.7 then
			conn:Disconnect()
			gui:Destroy()
		end
	end)
end

function Jumpscare.Init(effects)
	Remotes.Jumpscare.OnClientEvent:Connect(function(name)
		Jumpscare.Play(name, effects)
	end)
end

return Jumpscare
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Night Shift at Pip's — client entry point.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local Controls = require(script.Parent.Controls)
local Effects = require(script.Parent.Effects)
local Jumpscare = require(script.Parent.Jumpscare)
local Markers = require(script.Parent.Markers)

UI.Init()
Controls.Init(UI)
Jumpscare.Init(Effects)
Markers.Init()
task.spawn(Effects.Init, UI)

-- initial sync
task.spawn(function()
	local ok, state = pcall(function()
		return Remotes.GetProfile:InvokeServer()
	end)
	if ok and state then
		UI.SetState(state)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Markers</string>
            <string name="Source"><![CDATA[--[[
	Markers — floating objective markers (icon + distance) so players always
	know where to go next. Tokens only show the 3 closest to avoid clutter.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Markers = {}

local ICONS = {
	["Fuse Box"] = "⚡",
	Token = "🪙",
	Tape = "📼",
	["Gas Can"] = "⛽",
	VCR = "📺",
	Generator = "🔧",
	["Music Box"] = "🎵",
	EXIT = "🚪",
}
local COLORS = {
	["Fuse Box"] = Color3.fromRGB(255, 220, 60),
	Token = Color3.fromRGB(255, 200, 40),
	EXIT = Color3.fromRGB(80, 255, 120),
	["Music Box"] = Color3.fromRGB(255, 120, 200),
}

local boards: { [Instance]: BillboardGui } = {}

local function getBoard(inst: BasePart)
	local bb = boards[inst]
	if bb and bb.Parent then
		return bb
	end
	bb = Instance.new("BillboardGui")
	bb.Name = "ObjectiveMarker"
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(150, 46)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.LightInfluence = 0
	bb.Adornee = inst
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Parent = bb
	bb.Parent = player:WaitForChild("PlayerGui")
	boards[inst] = bb
	return bb
end

function Markers.Init()
	local accum = 0
	RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.2 then
			return
		end
		accum = 0
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local show = player:GetAttribute("InNight") == true and hrp ~= nil
		local carrying = player:GetAttribute("Carrying") or ""

		local visible = {}
		local tokens = {}
		if show then
			for _, inst in CollectionService:GetTagged("ObjectiveTarget") do
				if inst:IsA("BasePart") and inst.Parent and inst:GetAttribute("Active") then
					local forCarry = inst:GetAttribute("ForCarry") or ""
					local labelText = inst:GetAttribute("Label")
					local ok = forCarry == "" or forCarry == carrying
					-- hide pickups of the kind you're already carrying
					if carrying ~= "" and (labelText == "Tape" or labelText == "Gas Can") then
						ok = false
					end
					if ok then
						local d = (inst.Position - hrp.Position).Magnitude
						if labelText == "Token" then
							table.insert(tokens, { inst, d })
						else
							table.insert(visible, { inst, d })
						end
					end
				end
			end
			table.sort(tokens, function(a, b)
				return a[2] < b[2]
			end)
			for i = 1, math.min(3, #tokens) do
				table.insert(visible, tokens[i])
			end
		end

		local seen = {}
		for _, entry in visible do
			local inst, d = entry[1], entry[2]
			seen[inst] = true
			local bb = getBoard(inst)
			local name = inst:GetAttribute("Label")
			bb.Enabled = true
			bb.Label.Text = ("%s %s\n%dm"):format(ICONS[name] or "❗", name, math.floor(d / 3.5))
			bb.Label.TextColor3 = COLORS[name] or Color3.fromRGB(120, 220, 255)
		end
		for inst, bb in boards do
			if not seen[inst] then
				if not inst.Parent then
					bb:Destroy()
					boards[inst] = nil
				else
					bb.Enabled = false
				end
			end
		end
	end)
end

return Markers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	UI — every screen element, built from code.
	HUD: night/clock, task list, battery/stamina, inventory, action buttons, toasts.
	Panels: Guard Shop (Robux), Prize Counter (tickets gacha), Wardrobe, Mascot guide,
	tutorial, daily reward, results.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Items = require(Shared.Items)
local Cosmetics = require(Shared.Cosmetics)
local Mascots = require(Shared.Mascots)

local player = Players.LocalPlayer

local UI = {}
UI.Callbacks = {
	Flashlight = function() end,
	SprintToggle = function() end,
	UseItem = function(_item: string) end,
	Ping = function() end,
}
UI.Profile = nil
UI.State = nil
UI.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local C = Color3.fromRGB
local THEME = {
	Panel = C(22, 18, 32),
	Panel2 = C(36, 30, 52),
	Accent = C(255, 80, 170),
	Accent2 = C(0, 220, 255),
	Gold = C(255, 205, 60),
	Good = C(90, 230, 120),
	Bad = C(255, 70, 70),
	Text = C(245, 240, 255),
	Muted = C(170, 160, 190),
}
local TITLE_FONT = Enum.Font.FredokaOne
local BODY_FONT = Enum.Font.GothamMedium

------------------------------------------------------------------------------
-- tiny UI toolkit
------------------------------------------------------------------------------
local function new(class: string, props: { [string]: any }, children: { Instance }?)
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(color: Color3?, thickness: number?)
	return new("UIStroke", { Color = color or C(255, 255, 255), Thickness = thickness or 2, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function label(props)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = THEME.Text,
		Font = BODY_FONT,
		TextScaled = true,
		Text = "",
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

local function button(props, onClick: () -> ())
	local defaults = {
		BackgroundColor3 = THEME.Accent,
		TextColor3 = THEME.Text,
		Font = TITLE_FONT,
		TextScaled = true,
		AutoButtonColor = true,
		Text = "",
	}
	for k, v in props do
		defaults[k] = v
	end
	local b = new("TextButton", defaults, { corner(10), new("UIPadding", {
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
	}) })
	b.MouseButton1Click:Connect(onClick)
	return b
end

local function bar(parent, pos: UDim2, size: UDim2, color: Color3, name: string)
	local frame = new("Frame", {
		Name = name,
		Parent = parent,
		Position = pos,
		Size = size,
		BackgroundColor3 = C(15, 12, 22),
		BackgroundTransparency = 0.2,
	}, { corner(8), stroke(C(255, 255, 255), 1.5) })
	local fill = new("Frame", { Name = "Fill", Parent = frame, Size = UDim2.fromScale(1, 1), BackgroundColor3 = color }, { corner(8) })
	return frame, fill
end

local function tween(obj, time, props)
	local t = TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

------------------------------------------------------------------------------
-- Build
------------------------------------------------------------------------------
local gui: ScreenGui
local root: Frame
local scaleObj: UIScale
local hud = {}
local panels = {}
local toastHolder: Frame

local function updateScale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	local s = math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.55, 1.25)
	scaleObj.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
end

local function makePanel(name: string, title: string, size: Vector2)
	local panel = new("Frame", {
		Name = name,
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = THEME.Panel,
		Visible = false,
		ZIndex = 20,
	}, { corner(18), stroke(THEME.Accent, 3) })
	label({
		Parent = panel,
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -90, 0, 44),
		Text = title,
		Font = TITLE_FONT,
		TextColor3 = THEME.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 21,
	})
	button({
		Parent = panel,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(44, 44),
		Text = "X",
		BackgroundColor3 = THEME.Bad,
		ZIndex = 22,
	}, function()
		panel.Visible = false
	end)
	local body = new("Frame", {
		Name = "Body",
		Parent = panel,
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.new(1, -32, 1, -80),
		BackgroundTransparency = 1,
		ZIndex = 21,
	})
	panels[name] = panel
	return panel, body
end

function UI.Open(name: string)
	for n, p in panels do
		p.Visible = (n == name)
	end
	if UI.OnOpen then
		UI.OnOpen(name)
	end
end

function UI.CloseAll()
	for _, p in panels do
		p.Visible = false
	end
end

------------------------------------------------------------------------------
-- HUD
------------------------------------------------------------------------------
local function buildHud()
	-- Top bar
	local top = new("Frame", {
		Name = "TopBar",
		Parent = root,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(380, 92),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.15,
	}, { corner(16), stroke(THEME.Accent, 2) })
